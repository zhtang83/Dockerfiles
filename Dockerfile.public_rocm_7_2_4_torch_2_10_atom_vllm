#
# Install basic packages from OS distro
#
FROM ubuntu:22.04 AS base

ARG PYTHON_VERSION=3.12

ENV DEBIAN_FRONTEND=noninteractive

RUN rm -f /etc/apt/apt.conf.d/docker-clean

RUN --mount=target=/var/lib/apt/lists,type=cache,sharing=locked \
    --mount=target=/var/cache/apt,type=cache,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl libnuma-dev gnupg wget git nano \
        sudo libelf1 kmod file build-essential python3-dev \
        software-properties-common sqlite3 libsqlite3-dev libfmt-dev \
        libmsgpack-dev libsuitesparse-dev libdw-dev libpci-dev libibverbs-dev ibverbs-utils \
        zip unzip wget gcc make libtool autoconf pkg-config libssl-dev \
        librdmacm-dev rdmacm-utils infiniband-diags perftest ethtool \
        rdma-core \
        openssh-server openmpi-common

# Python
RUN --mount=target=/var/lib/apt/lists,type=cache,sharing=locked \
    --mount=target=/var/cache/apt,type=cache,sharing=locked \
    if ! python3 --version | grep -q ${PYTHON_VERSION} ; then \
        add-apt-repository -y ppa:deadsnakes/ppa && apt-get update && \
        apt-get install -y python${PYTHON_VERSION} python${PYTHON_VERSION}-dev \
            python${PYTHON_VERSION}-venv python${PYTHON_VERSION}-lib2to3 python-is-python3 ; \
    fi

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 && \
    update-alternatives --set python3 /usr/bin/python${PYTHON_VERSION} && \
    ln -sf /usr/bin/python${PYTHON_VERSION}-config /usr/bin/python3-config && \
    rm -f /usr/lib/python${PYTHON_VERSION}/EXTERNALLY-MANAGED && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python${PYTHON_VERSION}

RUN wget -nv -O /tmp/cmake-3.26.4-linux-x86_64.tar.gz https://cmake.org/files/v3.26/cmake-3.26.4-linux-x86_64.tar.gz && \
    tar zfx /tmp/cmake-3.26.4-linux-x86_64.tar.gz -C /opt/ && \
    mv /opt/cmake-3.26.4-linux-x86_64 /opt/cmake-3.26.4 && \
    rm -f /tmp/cmake-3.26.4-linux-x86_64.tar.gz

ENV PATH=/opt/cmake-3.26.4/bin:$PATH

#
# Install ROCm deb packages
#
FROM base AS rocm_deb

ARG ROCM_VERSION=7.2.4
ARG AMDGPU_VERSION=30.30.4
ARG GFX_ARCH=gfx950

RUN --mount=target=/var/lib/apt/lists,type=cache,sharing=locked \
    --mount=target=/var/cache/apt,type=cache,sharing=locked \
    curl -sL https://repo.radeon.com/rocm/rocm.gpg.key | apt-key add - && \
    printf "deb [arch=amd64] https://repo.radeon.com/rocm/apt/$ROCM_VERSION/ jammy main" | tee /etc/apt/sources.list.d/rocm.list && \
    printf "deb [arch=amd64] https://repo.radeon.com/amdgpu/$AMDGPU_VERSION/ubuntu jammy main" | tee /etc/apt/sources.list.d/amdgpu.list && \
    printf "Package: *\nPin: release o=repo.radeon.com\nPin-Priority: 600\n" > /etc/apt/preferences.d/artifactory-pin-600 && \
    apt-get update && \
    apt-get install -y rocm && \
    find /opt/rocm/lib -type f -name '*gfx*' | grep -Ev "${GFX_ARCH}" | xargs rm -f && \
    find /opt/rocm/lib/hipblaslt/library -type f -name '*gfx*' | grep -Ev "${GFX_ARCH}" | xargs rm -f && \
    find /opt/rocm/lib/rocblas/library -type f -name '*gfx*' | grep -Ev "${GFX_ARCH}" | xargs rm -f && \
    find /opt/rocm/share/miopen/db -type f -name '*gfx*' | grep -Ev "${GFX_ARCH}" | xargs rm -f && \
    sqlite3 /opt/rocm/lib/rocfft/rocfft_kernel_cache.db "delete from cache_v1 where arch != '${GFX_ARCH}' ; vacuum"

ENV ROCM_HOME=/opt/rocm
ENV CPLUS_INCLUDE_PATH=/opt/rocm/include:
ENV LD_LIBRARY_PATH=/opt/rocm/lib
ENV PATH=/opt/rocm/bin:/opt/rocm/llvm/bin:$PATH

#
# Install pytorch packages
#
FROM rocm_deb AS rocm_torch

ARG GFX_ARCH=gfx950

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip "setuptools<80" wheel numpy einops ninja setuptools_scm cmake pybind11 && \
    pip install /opt/rocm/share/amd_smi

RUN --mount=type=cache,target=/root/.cache/pip \
    cd /tmp && \
    wget https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.4/torch-2.10.0+rocm7.2.4.lw.git3d3aa833-cp312-cp312-linux_x86_64.whl -O torch-2.10.0+rocm7.2.4.lw.git3d3aa833-cp312-cp312-linux_x86_64.whl && \
    wget https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.4/apex-1.10.0+rocm7.2.4.git751f5dd5-cp312-cp312-linux_x86_64.whl -O apex-1.10.0+rocm7.2.4.git751f5dd5-cp312-cp312-linux_x86_64.whl && \
    wget https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.4/torchaudio-2.10.0+rocm7.2.4.git5047768f-cp312-cp312-linux_x86_64.whl -O torchaudio-2.10.0+rocm7.2.4.git5047768f-cp312-cp312-linux_x86_64.whl && \
    wget https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.4/torchvision-0.25.0+rocm7.2.4.git82df5f59-cp312-cp312-linux_x86_64.whl -O torchvision-0.25.0+rocm7.2.4.git82df5f59-cp312-cp312-linux_x86_64.whl && \
    wget https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.4/triton-3.6.0+rocm7.2.4.git4ed88892-cp312-cp312-linux_x86_64.whl -O triton-3.6.0+rocm7.2.4.git4ed88892-cp312-cp312-linux_x86_64.whl && \
    pip3 install \
        torch-2.10.0+rocm7.2.4.lw.git3d3aa833-cp312-cp312-linux_x86_64.whl \
        apex-1.10.0+rocm7.2.4.git751f5dd5-cp312-cp312-linux_x86_64.whl \
        torchaudio-2.10.0+rocm7.2.4.git5047768f-cp312-cp312-linux_x86_64.whl \
        torchvision-0.25.0+rocm7.2.4.git82df5f59-cp312-cp312-linux_x86_64.whl \
        triton-3.6.0+rocm7.2.4.git4ed88892-cp312-cp312-linux_x86_64.whl && \
    rm -f /tmp/*.whl

ENV PYTORCH_ROCM_ARCH=${GFX_ARCH}


FROM rocm_torch AS build_rccl

ARG GFX_ARCH=gfx950

# --------------------------------------------------------------------
# Stage 1: RCCL — parallel
# --------------------------------------------------------------------
ARG RCCL_REPO="https://github.com/ROCm/rccl.git"
ARG RCCL_BRANCH="29e1567b95e28823b0beb1a988adc587bfab5b4f"

RUN echo "========== [Parallel] Building RCCL ==========" && \
    pip install cmake && \
    git clone "$RCCL_REPO" /app/rccl && \
    cd /app/rccl && \
    git checkout "$RCCL_BRANCH" && \
    ./install.sh -p --amdgpu_targets=$GFX_ARCH

FROM build_rccl AS build_aiter

ARG PREBUILD_KERNELS=1
ARG MAX_JOBS=64
ARG GFX_ARCH=gfx950

RUN --mount=type=bind,source=.,target=/tmp \
    mkdir -p /app/aiter-test && \
    tar -xzf /tmp/aiter.tar.gz -C /app/aiter-test --strip-components=1 && \
    git config --global --add safe.directory /app/aiter-test

RUN echo "========== [Parallel] Building Aiter ==========" && \
    cd /app/aiter-test && \
    pip install -r requirements.txt && \
    MAX_JOBS=$MAX_JOBS PREBUILD_KERNELS=$PREBUILD_KERNELS \
    GPU_ARCHS=$GFX_ARCH python3 setup.py develop

FROM build_aiter AS atom_image

ARG ATOM_REPO="https://github.com/ROCm/ATOM.git"
ARG ATOM_COMMIT="aacebf22f8c84791b72b7ec582af2d9c5db2edc4"

# pip packages (lm-eval is lightweight, install directly)
RUN pip install lm-eval[api]

# MORI: build from source.
ARG MORI_REPO="https://github.com/ROCm/mori.git"
ARG MORI_COMMIT="v1.2.1"
RUN echo "========== [ATOM] Building MORI from source ==========" && \
    git clone "${MORI_REPO}" /app/mori && \
    cd /app/mori && \
    if [ -n "${MORI_COMMIT}" ]; then git checkout "${MORI_COMMIT}" && git submodule sync; fi && \
    git submodule update --init --recursive && \
    BUILD_UMBP=OFF BUILD_UMBP_SPDK=OFF pip install . --no-build-isolation && \
    python3 -c "import mori; print(f'mori: {mori.__file__}')" && \
    pip show amd-mori

# ========== Mooncake TransferEngine ==========
# Mooncake and Rust apt operations MUST run before the RCCL dpkg -i --force-all
# step below, because that step overwrites the Ubuntu-repo rccl with a custom
# ROCm build whose version string doesn't match rocm-hip's declared dependency,
# leaving dpkg in a broken state that blocks all subsequent apt-get install calls.
ARG INSTALL_MOONCAKE=1
ARG MOONCAKE_REPO="https://github.com/Jasen2201/Mooncake.git"
ARG MOONCAKE_COMMIT="fix/ionic-mr-and-qp-resource-fixes"

# [MC 1/4] Clone
RUN if [ "${INSTALL_MOONCAKE}" = "1" ]; then \
        echo "========== [MC 1/4] Clone Mooncake =========="; \
        git clone ${MOONCAKE_REPO} /app/mooncake && \
        cd /app/mooncake && \
        git checkout "${MOONCAKE_COMMIT}" && \
        git submodule update --init --recursive && \
        echo "Mooncake commit: $(git rev-parse HEAD)"; \
    else \
        echo "========== Skipped Mooncake (INSTALL_MOONCAKE=0) =========="; \
    fi

# [MC 2/4] Install dependencies (system packages + RDMA + Go + submodules)
ENV PATH="/usr/local/go/bin:${PATH}"
RUN if [ "${INSTALL_MOONCAKE}" = "1" ]; then \
        echo "========== [MC 2/4] Install Mooncake dependencies =========="; \
        cd /app/mooncake && bash dependencies.sh -y && \
        rm -rf /usr/local/go && \
        wget -q https://go.dev/dl/go1.22.2.linux-amd64.tar.gz && \
        tar -C /usr/local -xzf go1.22.2.linux-amd64.tar.gz && \
        rm go1.22.2.linux-amd64.tar.gz; \
    fi

# [MC 2.5/4] Install AMD Pensando ionic RDMA provider for Mooncake RDMA transport.
# The container's apt rdma-core (v39) predates the ionic provider. The upstream
# rdma-core v61 ionic source only supports kernel ABI 1, but Pensando's ionic NIC
# driver uses kernel ABI 4. Pensando's custom libionic1 deb (based on rdma-core v54
# fork) supports ABI 1-4 and is required for correct RDMA operation.
ARG IONIC_DEB_URL="https://repo.radeon.com/amdainic/pensando/ubuntu/1.117.1-a-63/pool/main/r/rdma-core/libionic1_54.0-149.g3304be71_amd64.deb"
RUN if [ "${INSTALL_MOONCAKE}" = "1" ]; then \
        echo "========== [MC 2.5/4] Install ionic RDMA provider =========="; \
        curl -fSL "${IONIC_DEB_URL}" -o /tmp/libionic1.deb && \
        dpkg -i /tmp/libionic1.deb && \
        echo "driver ionic" > /etc/libibverbs.d/ionic.driver && \
        ldconfig && \
        echo "Installed ionic provider:" && \
        ls -la /usr/lib/x86_64-linux-gnu/libibverbs/libionic* && \
        rm -f /tmp/libionic1.deb; \
    fi

# [MC 3/4] CMake build with HIP support + system install
RUN if [ "${INSTALL_MOONCAKE}" = "1" ]; then \
        echo "========== [MC 3/4] Build and install Mooncake (USE_HIP=ON) =========="; \
        mkdir -p /app/mooncake/build && cd /app/mooncake/build \
        && cmake .. -DUSE_HIP=ON -DUSE_ETCD=ON \
        && make -j$(nproc) && make install \
        && ldconfig \
        && echo "--- Clean up build artifacts ---" \
        && rm -rf /app/mooncake/build /app/mooncake/.git; \
    fi

# ========== Install Rust toolchain ==========
ARG RUST_VERSION="1.94.0"

RUN echo "========== Install Rust toolchain ==========" \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain "${RUST_VERSION}" --profile minimal \
    && . "$HOME/.cargo/env" \
    && rustc --version && cargo --version

ENV PATH="/root/.cargo/bin:${PATH}"

# RCCL: install .deb from build stage
# WARNING: dpkg -i --force-all overwrites Ubuntu-repo rccl with the ROCm custom
# build, breaking rocm-hip's version dep in dpkg metadata. All apt-get install
# operations (Mooncake, Rust, etc.) MUST be completed before this step.
COPY --from=build_rccl /app/rccl/build/release/*.deb /tmp/rccl/
RUN DEBIAN_FRONTEND=noninteractive dpkg -i --force-all /tmp/rccl/*.deb && \
    rm -rf /tmp/rccl

# Triton ships with the ROCm PyTorch base image (installed as a torch dependency);
# no separate build/copy step is needed here.

# Aiter: copy compiled source tree + re-register editable install
# (pip install -e creates egg-link automatically, no need to COPY them)
COPY --from=build_aiter /app/aiter-test /app/aiter-test
# Re-register the editable install only. Kernels are already precompiled and
# copied from the build_aiter stage, so:
#   - PREBUILD_KERNELS=0   : skip the prebuild code path. Under pip's PEP 660
#                            editable metadata phase, aiter/setup.py does not
#                            import the `jit` package (it's only imported in the
#                            non-metadata branch), so leaving PREBUILD_KERNELS!=0
#                            crashes with `ModuleNotFoundError: No module named 'jit'`.
#   - AITER_USE_SYSTEM_TRITON=1 : keep the base image's triton (3.6.0, matched to
#                            torch) instead of letting aiter swap in triton 3.7.0
#                            from pypi.amd.com and break the torch<->triton pin.
RUN cd /app/aiter-test && \
    PREBUILD_KERNELS=0 \
    pip install -e . --no-build-isolation && \
    pip show amd-aiter

# RTL (rocm-trace-lite): lightweight GPU kernel profiler (~250KB, no build deps)
RUN pip install rocm-trace-lite && \
    rtl --version || true

# ATOM: Python package install (editable) with the atomesh build hook enabled.
# CACHEBUST invalidates only this layer so parallel stages stay cached
ARG CACHEBUST=1

RUN --mount=type=bind,source=.,target=/tmp \
    mkdir -p /app/ATOM && \
    tar -xzf /tmp/ATOM.tar.gz -C /app/ATOM --strip-components=1 && \
    git config --global --add safe.directory /app/ATOM
    
RUN cd /app/ATOM && ATOM_MESH_BUILD=0 python3 -m pip install -e .
RUN pip show atom || true

FROM atom_image AS build_vllm

ARG GFX_ARCH=gfx950

RUN --mount=type=bind,source=.,target=/tmp \
    mkdir -p /app/vllm && \
    tar -xzf /tmp/vllm.tar.gz -C /app/vllm --strip-components=1 && \
    git config --global --add safe.directory /app/vllm

RUN cd /app/vllm && \
    # keeps the base image's ATOM-installed transformers
    sed -i -e '/^transformers[[:space:]]/d' requirements/common.txt && \
    echo "Removed transformers constraint from cloned vLLM requirements/common.txt to preserve base image transformers" && \
    ! grep '^transformers' requirements/common.txt && \
    sed -i -e '/xgrammar/d' -e '/compressed-tensors/d' requirements/common.txt && \
    python3 -m pip install --no-deps xgrammar==0.1.29 compressed-tensors==0.13.0 loguru && \
    sed -i -e '/peft/d' -e '/tensorizer/d' -e '/runai/d' -e '/timm/d' -e '/torch/d' -e '/triton/d' -e '/amdsmi/d' -e '/tilelang/d' requirements/rocm.txt && \
    python3 -m pip install --no-deps peft tensorizer==2.10.1 runai-model-streamer[s3,gcs]==0.15.3 timm>=1.0.17 tilelang==0.1.10 && \
    python3 -m pip install -r requirements/rocm.txt && \
    ROCM_PATH=/opt/rocm pip install --no-binary :all: fastsafetensors && \
    CMAKE_ARGS="-DCMAKE_HIP_ARCHITECTURES=${GFX_ARCH}" python3 -m pip install -v --no-build-isolation -e .[fastsafetensors]

FROM build_vllm AS final

RUN --mount=type=bind,from=ubuntu:22.04,source=/,target=/tmp \
    cp /tmp/etc/apt/apt.conf.d/docker-clean /etc/apt/apt.conf.d/docker-clean

ENV DEBIAN_FRONTEND=

WORKDIR /root
