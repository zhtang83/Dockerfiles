+                                             k_split_first_kv)
+        tile_first_kv_swa = arith_d.addi(
+            _raw(fx.Int32(tile_idx * N_TILE)),
+            _raw(swa_kv_runtime_extra),
+        )
+        _emit_tile_compute_iter(tile_idx, tile_first_kv_swa)
+
+    # ---- COMP loop: k=1 = full range; k>1 = per-WG slice with runtime offset ----
+    if const_expr(_skip_legacy_loops):
+        pass
+    elif const_expr(K_SPLITS == 1):
