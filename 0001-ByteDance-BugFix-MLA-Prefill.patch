+        # flydsl_reduce_inplace: T = t * n_head_chunks, H = M_DIM.
+        po_view = partial_o.reshape(t * n_head_chunks, k_splits, M_DIM, V_HEAD_DIM)
+        pm_view = partial_m.reshape(t * n_head_chunks, k_splits, M_DIM)
+        pl_view = partial_l.reshape(t * n_head_chunks, k_splits, M_DIM)
+        out_view = out.reshape(t * n_head_chunks, M_DIM, V_HEAD_DIM)
+        flydsl_reduce_inplace(po_view, pm_view, pl_view, attn_sink, out_view,
