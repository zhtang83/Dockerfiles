diff --git a/vllm/v1/attention/ops/deepseek_v4_ops/flydsl_native_csr.py b/vllm/v1/attention/ops/deepseek_v4_ops/flydsl_native_csr.py
new file mode 100644
index 000000000..28444f05c
--- /dev/null
+++ b/vllm/v1/attention/ops/deepseek_v4_ops/flydsl_native_csr.py
@@ -0,0 +1,207 @@
+"""Build the two-source PHYSICAL-slot CSRs the native FlyDSL fp8-direct
+sparse-MLA prefill kernel consumes, WITHOUT a host dense KV gather.
+
+The native FlyDSL kernel reads the paged fp8 caches directly and gathers
+in-kernel, so the host only needs to hand it, per query token, the flat list
+of *physical* slot ids (`physical_block * block_size + pos_in_block`) it should
+attend — one CSR for the SWA window, one for the compressed (prefix) topk.
+
+Fast path (no host dense buffer, no boolean-mask compaction, no per-call sync):
+  1. Per-token lengths are ANALYTIC (`swa_len = min(pos+1, W)`,
+     `comp_len = min((pos+1)//ratio, top_k)`) — pure vectorized torch.
+  2. `indptr = cumsum(len)` gives each token's flat write base.
+  3. ONE Triton kernel writes the physical slots DIRECTLY into the flat
+     compacted buffers at `indptr[t] + j` (block-table translated), so there is
+     no `[N, max]` dense scratch and no `dense[mask]` gather (the old version's
+     cost — measured 20-62% of the FlyDSL prefill on the e2e path).
+  4. Flat buffers are reused across calls (module cache, grown as needed).
+
+The per-token index math mirrors `_combine_topk_swa_indices_kernel` in
+`cache_utils.py`; the block-table → physical-slot translation mirrors
+`_compute_global_topk_indices_and_lens_kernel`.
+"""
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _native_flat_csr_kernel(
+    comp_flat_ptr, swa_flat_ptr,
+    comp_indptr_ptr, swa_indptr_ptr,
+    comp_len_ptr, swa_len_ptr,
+    abs_pos_ptr, token_to_req_ptr,
+    topk_indices_ptr, topk_indices_stride,
+    comp_block_table_ptr, comp_block_table_stride,
+    swa_block_table_ptr, swa_block_table_stride,
+    COMP_BLOCK_SIZE: tl.constexpr,
+    SWA_BLOCK_SIZE: tl.constexpr,
+    PADDED_TOP_K: tl.constexpr,
+    PADDED_WINDOW: tl.constexpr,
+    HAS_COMP: tl.constexpr,
+    SINGLE_REQ: tl.constexpr,
+):
+    t = tl.program_id(0)
+    if SINGLE_REQ:
+        req = 0
+    else:
+        req = tl.load(token_to_req_ptr + t)
+
+    # ---- COMP: write physical slots directly into the flat buffer ----
+    if HAS_COMP:
+        clen = tl.load(comp_len_ptr + t)
+        cbase = tl.load(comp_indptr_ptr + t)
+        coff = tl.arange(0, PADDED_TOP_K)
+        cmask = coff < clen
+        local = tl.load(topk_indices_ptr + t * topk_indices_stride + coff,
+                        mask=cmask, other=0)
+        cblk = tl.load(
+            comp_block_table_ptr + req * comp_block_table_stride
+            + (local // COMP_BLOCK_SIZE),
+            mask=cmask, other=0,
+        )
+        cphys = cblk * COMP_BLOCK_SIZE + (local % COMP_BLOCK_SIZE)
+        tl.store(comp_flat_ptr + cbase + coff, cphys.to(tl.int32), mask=cmask)
+
+    # ---- SWA: physical slots for the causal window ----
+    pos = tl.load(abs_pos_ptr + t)
+    slen = tl.load(swa_len_ptr + t)
+    sbase = tl.load(swa_indptr_ptr + t)
+    woff = tl.arange(0, PADDED_WINDOW)
+    wmask = woff < slen
+    wpos = pos - slen + 1 + woff
+    sblk = tl.load(
+        swa_block_table_ptr + req * swa_block_table_stride
+        + (wpos // SWA_BLOCK_SIZE),
+        mask=wmask, other=0,
+    )
+    sphys = sblk * SWA_BLOCK_SIZE + (wpos % SWA_BLOCK_SIZE)
+    tl.store(swa_flat_ptr + sbase + woff, sphys.to(tl.int32), mask=wmask)
+
+
+# Reused flat index buffers (grown as needed) keyed by (device, source).
+_FLAT_CACHE: dict = {}
+
+
+def _get_flat(total: int, device: torch.device, tag: str) -> torch.Tensor:
+    key = (device.type, device.index, tag)
+    buf = _FLAT_CACHE.get(key)
+    need = max(1, total)
+    if buf is None or buf.numel() < need:
+        buf = torch.empty(max(need, 1024), dtype=torch.int32, device=device)
+        _FLAT_CACHE[key] = buf
+    return buf
+
+
+def build_native_two_source_csrs(
+    *,
+    topk_indices: torch.Tensor | None,   # [n_tok, top_k] int32 local comp idx
+    query_start_loc: torch.Tensor,       # [num_reqs+1] int32 (global; rebased)
+    seq_lens: torch.Tensor,              # [num_reqs] int32
+    window_size: int,
+    compress_ratio: int,
+    top_k: int,
+    comp_block_table: torch.Tensor | None,  # [num_reqs, max_blk] int32
+    comp_block_size: int,
+    swa_block_table: torch.Tensor,           # [num_reqs, max_blk] int32
+    swa_block_size: int,
+    n_tok: int,
+    device: torch.device,
+):
+    """Return (swa_indices, swa_indptr, comp_indices, comp_indptr) — flat
+    physical-slot CSRs. ``comp_*`` is None for SWA-only layers. The returned
+    flat index buffers may be longer than the CSR (cached/reused); consumers
+    address them via the indptr ranges (the FlyDSL kernel only reads
+    ``indices.stride(-1)`` + per-token indptr, never the buffer length)."""
+    has_comp = topk_indices is not None and comp_block_table is not None
+    num_reqs = seq_lens.shape[0]
+    single_req = num_reqs == 1
+    # Cap (#elements) below which we size flat buffers from the analytic upper
+    # bound (n*window / n*top_k) and SKIP the .item() total sync entirely — the
+    # FlyDSL kernel addresses by indptr ranges, never by buffer length, and the
+    # buffer descriptor bounds make the unwritten tail safe. Above the cap we
+    # take one .item() (negligible vs the kernel at large N).
+    _NOSYNC_ELEMS = 1 << 24  # 16M int32 = 64MB
+
+    # ---- per-token absolute position + request id ----
+    if single_req:
+        # token t -> position (seq_len - n_tok) + t. No repeat_interleave / no
+        # gathers / no token_to_req tensor (kernel uses req=0 via SINGLE_REQ).
+        start0 = seq_lens[:1].to(torch.int64) - n_tok          # [1] (device)
+        pos64 = (torch.arange(n_tok, device=device, dtype=torch.int64)
+                 + start0)                                      # [n] broadcast
+        token_to_req = None
+    else:
+        qsl = (query_start_loc - query_start_loc[0]).to(torch.int64)
+        qlens = (qsl[1:] - qsl[:num_reqs]).clamp(min=0)
+        token_to_req = torch.repeat_interleave(
+            torch.arange(num_reqs, device=device, dtype=torch.int32), qlens
+        )[:n_tok]
+        t2r64 = token_to_req.to(torch.int64)
+        start_pos = seq_lens.to(torch.int64) - qlens
+        local_off = (torch.arange(n_tok, device=device, dtype=torch.int64)
+                     - qsl[t2r64])
+        pos64 = start_pos[t2r64] + local_off
+    abs_pos = pos64.to(torch.int32)
+
+    # ---- analytic per-token lengths + indptr ----
+    swa_len = torch.clamp(pos64 + 1, max=window_size).to(torch.int32)
+    swa_indptr = torch.zeros(n_tok + 1, dtype=torch.int32, device=device)
+    torch.cumsum(swa_len, dim=0, dtype=torch.int32, out=swa_indptr[1:])
+    swa_cap_ub = n_tok * window_size
+    if swa_cap_ub <= _NOSYNC_ELEMS:
+        swa_total = -1                       # sentinel: return full buffer
+        swa_flat = _get_flat(swa_cap_ub, device, "swa")
+    else:
+        swa_total = int(swa_indptr[-1].item())
+        swa_flat = _get_flat(swa_total, device, "swa")
+
+    if has_comp:
+        comp_len = torch.clamp((pos64 + 1) // max(1, compress_ratio),
+                               max=top_k).to(torch.int32)
+        comp_indptr = torch.zeros(n_tok + 1, dtype=torch.int32, device=device)
+        torch.cumsum(comp_len, dim=0, dtype=torch.int32, out=comp_indptr[1:])
+        comp_cap_ub = n_tok * max(1, top_k)
+        if comp_cap_ub <= _NOSYNC_ELEMS:
+            comp_total = -1
+            comp_flat = _get_flat(comp_cap_ub, device, "comp")
+        else:
+            comp_total = int(comp_indptr[-1].item())
+            comp_flat = _get_flat(comp_total, device, "comp")
+    else:
+        comp_len = swa_len            # unused (HAS_COMP=False)
+        comp_indptr = swa_indptr
+        comp_flat = swa_flat
+        comp_total = 0
+
+    padded_window = max(1, triton.next_power_of_2(window_size))
+    padded_top_k = max(1, triton.next_power_of_2(top_k)) if has_comp else 1
+
+    _native_flat_csr_kernel[(n_tok,)](
+        comp_flat, swa_flat,
+        comp_indptr, swa_indptr,
+        comp_len, swa_len,
+        abs_pos, token_to_req if token_to_req is not None else swa_flat,
+        topk_indices if has_comp else swa_flat,
+        topk_indices.stride(0) if has_comp else 0,
+        comp_block_table if has_comp else swa_block_table,
+        (comp_block_table.stride(0) if has_comp
+         else swa_block_table.stride(0)),
+        swa_block_table, swa_block_table.stride(0),
+        COMP_BLOCK_SIZE=max(1, comp_block_size),
+        SWA_BLOCK_SIZE=swa_block_size,
+        PADDED_TOP_K=padded_top_k,
+        PADDED_WINDOW=padded_window,
+        HAS_COMP=has_comp,
+        SINGLE_REQ=single_req,
+    )
+
+    swa_indices = swa_flat if swa_total < 0 else (
+        swa_flat[:swa_total] if swa_total > 0 else swa_flat[:1])
+    if has_comp:
+        comp_indices = comp_flat if comp_total < 0 else (
+            comp_flat[:comp_total] if comp_total > 0 else comp_flat[:1])
+        return swa_indices, swa_indptr, comp_indices, comp_indptr
+    return swa_indices, swa_indptr, None, None
