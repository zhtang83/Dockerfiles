+        is_valid_dma_sp = []
+        nope_rope_base_dma_sp = []
+        for sp in range_constexpr(NUM_SUBPASS):
+            if const_expr(sp == 0):
+                bperm_byte_sp = bperm_byte_base
+            else:
+                bperm_byte_sp = arith_d.addi(
+                    bperm_byte_base, _raw(fx.Int32(sp * 16 * SLOT_BPERM_MULT)))
+            slot_id_dma_sp = rocdl.ds_bpermute(T.i32, bperm_byte_sp, _raw(slot_id_full))
+            is_valid_sp = arith_d.cmpi(arith_d.CmpIPredicate.sge, slot_id_dma_sp, _raw(fx.Int32(0)))
+            safe_slot_sp = arith_d.select(is_valid_sp, slot_id_dma_sp, _raw(fx.Int32(0)))
+            block_id_sp = arith_d.shrui(safe_slot_sp, _raw(fx.Int32(cur_block_log2)))
+            pos_in_block_sp = arith_d.andi(safe_slot_sp, _raw(fx.Int32(cur_block_mask)))
+            # i64 byte base: block_id*block_stride overflows i32 once the paged
+            # pool exceeds ~4GB (long context). Compute the block term in i64 and
+            # feed a per-lane global_load_lds below (32-bit buffer voffset cannot
+            # address a scattered >4GB pool). within-block term stays small (i32).
+            nope_rope_base_sp = arith_d.addi(
+                arith_d.muli(arith_d.extsi(i64_ty, block_id_sp),
+                             arith_d.extsi(i64_ty, _raw(cur_block_stride_b))),
+                arith_d.extsi(i64_ty, arith_d.muli(
+                    pos_in_block_sp, _raw(fx.Int32(NOPE_ROPE_SLOT_BYTES)))),
+            )
+            is_valid_dma_sp.append(is_valid_sp)
+            nope_rope_base_dma_sp.append(nope_rope_base_sp)
+
+        # ---- K_nope DMA (4 lanes / kv per call; raw_ptr_buffer_load_lds size=4) ----
+        # Per chunk = N_TILE KVs × 16 channels. `raw_ptr_buffer_load_lds` only
+        # supports size=4 per lane, and 64 lanes cover 16 KV/call (4 lanes/kv),
+        # so each chunk needs NUM_SUBPASS calls (one per 16-KV sub-pass).
+        lane_in_kv_part = arith_d.andi(_raw(tid_i32), _raw(fx.Int32(3)))
+        lane_byte_in_chunk = arith_d.muli(lane_in_kv_part, _raw(fx.Int32(4)))
+        oob_voffset = _raw(fx.Int32(-1))
+        CHUNK_BYTES_KNOPE = N_TILE * 16
+        SUBPASS_BYTES = 16 * 16   # one 16-KV sub-pass section = 256 byte
+        _KNOPE_C = NUM_V_NOPE_CHUNKS // NUM_WARPS  # 7
+        for c in range_constexpr(_KNOPE_C):
+            chunk_cm_i32 = arith_d.addi(_raw(fx.Int32(c * NUM_WARPS)), _raw(warp_id_i32))
+            m0_byte_i32 = arith_d.addi(
+                arith_d.muli(chunk_cm_i32, _raw(fx.Int32(CHUNK_BYTES_KNOPE))),
+                _raw(fx.Int32(off_knope_cm_b)),
+            )
+            chunk_voff_term = arith_d.addi(
+                arith_d.muli(chunk_cm_i32, _raw(fx.Int32(16))), lane_byte_in_chunk)
+            for sp in range_constexpr(NUM_SUBPASS):
+                # sub-pass sp: KV sp*16..sp*16+15 → LDS chunk bytes sp*256..+255
+                if const_expr(sp == 0):
+                    m0_byte_sp = m0_byte_i32
+                else:
+                    m0_byte_sp = arith_d.addi(
+                        m0_byte_i32, _raw(fx.Int32(sp * SUBPASS_BYTES)))
+                m0_idx_sp = arith_d.index_cast(MT.index(), m0_byte_sp)
+                m0_i64_sp = arith_d.index_cast(i64_ty, m0_idx_sp)
+                m0_lane0_sp = rocdl.readfirstlane(T.i64, m0_i64_sp)
+                lds_ptr_sp = llvm_d.IntToPtrOp(_lds_ptr_ty, m0_lane0_sp).result
+                # i64 per-lane byte offset (block term already i64); invalid
+                # lanes -> offset 0 (in-bounds, no fault; masked to NEG_INF in qk).
+                off_i64_sp = arith_d.addi(
+                    nope_rope_base_dma_sp[sp],
+                    arith_d.extsi(i64_ty, chunk_voff_term))
+                off_safe_i64_sp = arith_d.select(
+                    is_valid_dma_sp[sp], off_i64_sp,
+                    arith_d.constant(i64_ty, ir_d.IntegerAttr.get(i64_ty, 0)))
+                ptr_sp = _cache_gep(off_safe_i64_sp)
+                rocdl.global_load_lds(ptr_sp, lds_ptr_sp, 4, 0, 0)
+
+        # ---- K_rope HBM→LDS via raw_ptr_buffer_load_lds DMA ----
+        # Bypasses VGPR (frees registers, hides HBM latency). Mirrors
+        # K_nope DMA structure: 4 warps in parallel, each warp owns
+        # NUM_KR_CHUNKS_PER_WARP=4 chunks (each chunk = 256 byte
+        # = 2 KVs × 128 byte). 4 calls × 4 warps = 16 chunks = 4096 byte
+        # = full K_rope at N_TILE=32. LDS layout preserved (KV n at
+        # byte n*128) so PV RoPE bf16 view (cur_lds_krope_bf16) reads
+        # unchanged.
+        #
+        # Lane mapping per chunk:
+        #   kv_in_chunk = lane_in_warp >> 5    (0 or 1)
+        #   byte_in_kv  = (lane_in_warp & 31) * 4   (0..124)
+        # 32 lanes/kv (vs the 8-lanes/kv used by K_scale below at N=32).
+        kv_in_chunk_kr = arith_d.shrui(_raw(tid_i32), _raw(fx.Int32(5)))
+        byte_in_kv_kr = arith_d.muli(
+            arith_d.andi(_raw(tid_i32), _raw(fx.Int32(31))),
+            _raw(fx.Int32(4)),
+        )
+        for c in range_constexpr(NUM_KR_CHUNKS_PER_WARP):  # 2
+            # chunk_id = warp_id * NUM_KR_CHUNKS_PER_WARP + c (0..7)
+            chunk_id_kr_i32 = arith_d.addi(
+                arith_d.muli(_raw(warp_id_i32),
+                              _raw(fx.Int32(NUM_KR_CHUNKS_PER_WARP))),
+                _raw(fx.Int32(c)),
+            )
+            # kv_global = chunk_id * KVS_PER_CHUNK_KR + kv_in_chunk
+            kv_global_kr_i32 = arith_d.addi(
+                arith_d.muli(chunk_id_kr_i32,
+                              _raw(fx.Int32(KVS_PER_CHUNK_KR))),
+                kv_in_chunk_kr,
+            )
+            # B1: slot_id dedup — single bperm from the consolidated
+            # slot_id_full (2 lanes per kv layout). Target kv = kv_global_kr;
+            # source lane = 2*kv → byte index = 8*kv.
+            bperm_idx_kr = arith_d.muli(kv_global_kr_i32,
+                                          _raw(fx.Int32(SLOT_BPERM_MULT)))
+            slot_id_kr = rocdl.ds_bpermute(T.i32, bperm_idx_kr,
+                                             _raw(slot_id_full))
+            is_valid_kr = arith_d.cmpi(arith_d.CmpIPredicate.sge,
+                                        slot_id_kr, _raw(fx.Int32(0)))
+            safe_slot_kr = arith_d.select(is_valid_kr, slot_id_kr,
+                                           _raw(fx.Int32(0)))
+            block_id_kr = arith_d.shrui(safe_slot_kr,
+                                         _raw(fx.Int32(cur_block_log2)))
+            pos_in_block_kr = arith_d.andi(safe_slot_kr,
+                                            _raw(fx.Int32(cur_block_mask)))
+            # i64 block term (large-pool fix); within-block stays i32.
+            nope_rope_base_kr = arith_d.muli(
+                arith_d.extsi(i64_ty, block_id_kr),
+                arith_d.extsi(i64_ty, _raw(cur_block_stride_b)))
+            within_kr_i32 = arith_d.addi(
+                arith_d.addi(arith_d.muli(pos_in_block_kr,
+                                          _raw(fx.Int32(NOPE_ROPE_SLOT_BYTES))),
+                             _raw(fx.Int32(ROPE_OFFSET))),
+                byte_in_kv_kr,
+            )
+            off_i64_kr = arith_d.addi(
+                nope_rope_base_kr, arith_d.extsi(i64_ty, within_kr_i32))
+            off_safe_i64_kr = arith_d.select(
+                is_valid_kr, off_i64_kr,
+                arith_d.constant(i64_ty, ir_d.IntegerAttr.get(i64_ty, 0)))
+            # Wave-uniform LDS pointer per warp: m0 = LDS_OFF_KROPE + chunk_id*256
+            m0_byte_kr_i32 = arith_d.addi(
+                arith_d.muli(chunk_id_kr_i32, _raw(fx.Int32(256))),
+                _raw(fx.Int32(off_krope_b)),
+            )
+            m0_idx_kr = arith_d.index_cast(MT.index(), m0_byte_kr_i32)
+            m0_i64_kr = arith_d.index_cast(i64_ty, m0_idx_kr)
+            m0_lane0_kr = rocdl.readfirstlane(T.i64, m0_i64_kr)
+            lds_ptr_kr = llvm_d.IntToPtrOp(_lds_ptr_ty, m0_lane0_kr).result
+            ptr_kr = _cache_gep(off_safe_i64_kr)
+            rocdl.global_load_lds(ptr_kr, lds_ptr_kr, 4, 0, 0)
+
+        # ---- K_scale via raw_ptr_buffer_load_lds (gated to warp 0 ONLY) ----
+        # BUG FIX (historical): raw_ptr_buffer_load_lds is a per-WAVE
+        # instruction. With 4 warps × 64 lanes, all 4 waves execute it. For
+        # OOB lanes the HW writes 0 to LDS[m0 + lane*size] (per AMDGPU spec).
+        # Old voffset=-1 trick races OOB-zero writes from warps 1/2/3 over
+        # warp 0's real data. Fix: gate via warp_id == 0.
+        #
+        # At N_TILE=32: 32 KVs × 8 byte scale = 256 byte total. 64 lanes
+        # of warp 0 × 4 byte/lane = 256 byte ✓. Lane mapping:
+        #   kv = gtid // 2,  dword_in_kv = gtid % 2  (each KV's 8 B = 2 dwords)
+        #   Auto LDS packing: lane n writes to LDS[m0 + n*4]
+        warp0_ks = arith_d.cmpi(arith_d.CmpIPredicate.eq,
+                                  _raw(warp_id_i32), _raw(fx.Int32(0)))
+        # Warp 0 streams the scale region: 32 KV × 8 byte = 256 byte = one
+        # 64-lane pass. For N_TILE>32 it takes N_TILE//32 passes (kv group ksc
+        # covers KV ksc*32 .. ksc*32+31, LDS bytes ksc*256 .. +255).
+        dword_in_kv_ks = arith_d.andi(_raw(gtid_i32), _raw(fx.Int32(1)))
+        _N_KS_PASS = N_TILE // 32 if N_TILE >= 32 else 1
+        _KS_PASS_BYTES = 32 * SCALE_BYTES_PER_SLOT   # 256 byte / 32-KV pass
+        for ksc in range_constexpr(_N_KS_PASS):
+            # Target kv = (gtid>>1) + ksc*32; source lane = kv*LANES_PER_SLOT
+            # → bperm byte = kv * SLOT_BPERM_MULT.
+            kv_for_ks_dma = arith_d.addi(
+                arith_d.shrui(_raw(gtid_i32), _raw(fx.Int32(1))),
+                _raw(fx.Int32(ksc * 32)))
+            bperm_idx_ks = arith_d.muli(_raw(kv_for_ks_dma),
+                                          _raw(fx.Int32(SLOT_BPERM_MULT)))
+            slot_id_ks_dma = rocdl.ds_bpermute(T.i32, bperm_idx_ks,
+                                                 _raw(slot_id_full))
+            is_valid_ks_dma = arith_d.cmpi(arith_d.CmpIPredicate.sge,
+                                            slot_id_ks_dma, _raw(fx.Int32(0)))
+            safe_slot_ks_dma = arith_d.select(is_valid_ks_dma, slot_id_ks_dma,
+                                                _raw(fx.Int32(0)))
+            block_id_ks_dma = arith_d.shrui(safe_slot_ks_dma,
+                                              _raw(fx.Int32(cur_block_log2)))
+            pos_in_block_ks_dma = arith_d.andi(safe_slot_ks_dma,
+                                                 _raw(fx.Int32(cur_block_mask)))
+            # i64 block term (large-pool fix); within-block stays i32.
+            within_ks_i32 = arith_d.addi(
+                arith_d.addi(
+                    _raw(fx.Int32(cur_scale_region_off)),
+                    arith_d.muli(pos_in_block_ks_dma,
+                                 _raw(fx.Int32(SCALE_BYTES_PER_SLOT))),
+                ),
+                arith_d.muli(dword_in_kv_ks, _raw(fx.Int32(4))),
+            )
+            off_i64_ks = arith_d.addi(
+                arith_d.muli(arith_d.extsi(i64_ty, block_id_ks_dma),
+                             arith_d.extsi(i64_ty, _raw(cur_block_stride_b))),
+                arith_d.extsi(i64_ty, within_ks_i32),
+            )
+            m0_ks_byte = arith_d.constant(MT.index(), int(off_ks_b) + ksc * _KS_PASS_BYTES)
+            m0_ks_i64 = arith_d.index_cast(i64_ty, m0_ks_byte)
+            m0_ks_lane0 = rocdl.readfirstlane(T.i64, m0_ks_i64)
+            lds_ptr_ks = llvm_d.IntToPtrOp(_lds_ptr_ty, m0_ks_lane0).result
+            if_op_ks_dma = scf_d.IfOp(warp0_ks)
+            with ir_d.InsertionPoint(if_op_ks_dma.then_block):
+                ptr_ks = _cache_gep(off_i64_ks)
+                rocdl.global_load_lds(ptr_ks, lds_ptr_ks, 4, 0, 0)
+                scf_d.YieldOp([])
+
+        # ---- Valid mask (gtid<N_TILE only) ----
+        # NOTE: VALID kept as VGPR-transit ds_write — it's a 1-bit signal
+        # we *materialize* from the i1 cmp (no HBM source), so DMA path
+        # doesn't apply. Cheap (1 ds_write per warp). N_TILE valid bits
+        # total (32 at N_TILE=32).
+        is_lane_lt_n_tile_v = arith_d.cmpi(arith_d.CmpIPredicate.slt,
+                                           _raw(gtid_i32), _raw(fx.Int32(N_TILE)))
+        kv_for_v = arith_d.andi(_raw(gtid_i32), _raw(fx.Int32(N_TILE - 1)))
+        # B1: slot_id dedup — single bperm from consolidated slot_id_full.
+        # Target kv = kv_for_v ∈ [0,31]; source lane = 2*kv → byte = 8*kv.
+        bperm_idx_v = arith_d.muli(_raw(kv_for_v),
+                                     _raw(fx.Int32(SLOT_BPERM_MULT)))
+        slot_id_v = rocdl.ds_bpermute(T.i32, bperm_idx_v,
+                                        _raw(slot_id_full))
+        is_valid_v = arith_d.cmpi(arith_d.CmpIPredicate.sge, slot_id_v,
+                                    _raw(fx.Int32(0)))
+        if_op_valid = scf_d.IfOp(is_lane_lt_n_tile_v)
+        with ir_d.InsertionPoint(if_op_valid.then_block):
+            valid_int = arith_d.select(is_valid_v, _raw(fx.Int32(1)),
+                                         _raw(fx.Int32(0)))
+            lds_off_valid_local = kv_for_v + fx.Int32(off_valid_b // 4)
+            _vec_store(_vec_from_elts([valid_int], i32_ty), lds_buf_i32,
+                        [_to_index(_raw(lds_off_valid_local))])
+            # big-M: also stage this tile's per-column 16-bit colmask word into
+            # the double-buffered LDS region (read per (row,col) in compute).
+            # Each lane gtid<N_TILE owns union column kv_for_v of this tile.
+            if bigm:
+                cm_col_off = (block_x_idx * bigm_colmask_grp_i32
+                              + fx.Int32(tile_pyint * N_TILE) + kv_for_v)
+                cm_word = buffer_ops.buffer_load(
+                    bigm_colmask_rsrc, _raw(cm_col_off),
+                    vec_width=1, dtype=T.i32)
+                lds_off_cm_local = kv_for_v + fx.Int32(
+                    _LDS_OFF_BIGM_CM(buf_pyint) // 4)
+                _vec_store(_vec_from_elts([_raw(cm_word)], i32_ty), lds_buf_i32,
+                            [_to_index(_raw(lds_off_cm_local))])
+            scf_d.YieldOp([])
+
+    # ============== Tile compute helper (parameterized by tile + buf) ==============
+    # Emits all per-tile QK + softmax + PV + state-update ops for `tile_pyint`
+    # reading K LDS from buffer `buf_cur_py`. Returns NEW state lists
+    # (m_new, l_new, acc_nope_new, acc_rope_new) without mutating caller's
+    # lists, so caller can wrap helper call in scf.IfOp + yield + re-bind for
+    # early-exit gating (skip tile when its KV range is past cur_max).
+    def _emit_qk(tile_pyint, buf_cur_py, hs_py=0):
+        # ===== PHASE A (QK) =====
+        # NoPE+RoPE MFMA + combine + per-lane valid + big-M colmask. Produces
+        # the per-tile qk scores + masks and touches NO online-softmax state,
+        # so it can be software-pipelined one tile ahead of _emit_softmax_pv
+        # (QK(j+1) MFMA fills the MFMA-idle softmax(j) window). Returns
+        # (qk, my_valid_bool, bigm_valid).
+        # big-M head-group: this invocation processes head-slot `hs_py`, whose
+        # Q resides in its own LDS region (base offsets below). HG==1 ->
+        # hs_py==0 -> base offsets == the original single-head offsets.
+        Q_NOPE_I32_BASE = _q_nope_i32_base(hs_py)
+        Q_SCALE_BYTE_BASE = _q_scale_byte_base(hs_py)
+
+        # ---- Per-tile current-buf LDS offsets used by QK below ----
+        CUR_OFF_KROPE = _LDS_OFF_KROPE(buf_cur_py)
+        CUR_OFF_KS = _LDS_OFF_KS(buf_cur_py)
+        CUR_OFF_VALID = _LDS_OFF_VALID(buf_cur_py)
+        CUR_OFF_KNOPE_CM = _LDS_OFF_KNOPE_CM(buf_cur_py)
+
+        # ---- QK NoPE: 4× mfma_scale × 2 sub-passes (KV 0..15 + 16..31) ----
+        # At N_TILE=32, each tile spans 32 KV columns; one mfma_scale_K128
+        # produces N=16 KV outputs per lane. Use 2 sub-passes per mfma_idx:
+        #   sub_lo: K LDS read at chunk_byte_off  → qk_nope_lo (KV 0..15)
+        #   sub_hi: K LDS read at chunk_byte_off + 256 → qk_nope_hi (KV 16..31)
+        # K LDS chunk stride at N=32 = 512 byte = 128 i32 (was 64 at N=16);
+        # the +64 i32 offset inside chunk jumps to kv=16.
+        # Q LDS is unchanged (Q chunks are M_DIM*16 = 256 byte independent
+        # of N_TILE), so both sub-passes share Q reads.
+        # NUM_SUBPASS accumulator sets (16 KV columns each). qk_nope[sp][i].
+        qk_nope = [[fx.Float32(0.0) for _ in range(4)] for _ in range(NUM_SUBPASS)]
+        k_stripe_v4_off = arith_d.shrui(_raw(g_idx), _raw(fx.Int32(1)))
+        K_CHUNK_I32 = (N_TILE * 16) // 4   # K chunk stride in i32 units (= 128 at N=32)
+        K_SUBPASS_OFF = 16 * 16 // 4       # i32 offset per 16-KV sub-pass (= 64)
+        KS_SUBPASS_OFF = 16 * 8            # K-scale byte offset per 16-KV sub-pass (= 128)
+        for mfma_idx in range_constexpr(NUM_MFMA_K128):
+            v4_g_for_lane = arith_d.addi(
+                _raw(fx.Int32(mfma_idx * NUM_V4_GROUPS_PER_MFMA)),
+                k_stripe_v4_off,
+            )
+            # 1. Load Q v8 from LDS_QNOPE (shared across all sub-passes).
+            q_lo_chunk = arith_d.addi(_raw(fx.Int32(mfma_idx * 8)), _raw(g_idx))
+            q_hi_chunk = arith_d.addi(_raw(fx.Int32(mfma_idx * 8 + 4)), _raw(g_idx))
+            m_idx_x4 = arith_d.muli(_raw(m_idx), _raw(fx.Int32(4)))
+            q_lo_off = arith_d.addi(
+                _raw(fx.Int32(Q_NOPE_I32_BASE)),
+                arith_d.addi(arith_d.muli(q_lo_chunk, _raw(fx.Int32(64))),
+                              m_idx_x4))
+            q_hi_off = arith_d.addi(
+                _raw(fx.Int32(Q_NOPE_I32_BASE)),
+                arith_d.addi(arith_d.muli(q_hi_chunk, _raw(fx.Int32(64))),
+                              m_idx_x4))
+            q_lo = _vec_load(v4i32_ty, lds_buf_i32, [_to_index(q_lo_off)])
+            if const_expr(mfma_idx == NUM_MFMA_K128 - 1):
+                # mfma #3 hi half = Q chunks 28..31 = K=448..511 > HEAD_DIM_NOPE
+                # (448) -> always zero-pad. Feed zeros instead of reading LDS so
+                # those chunks need not be allocated (frees LDS -> +occupancy).
+                q_v8 = mvec_d.shuffle(q_lo, _vec_const(4, 0, i32_ty),
+                                       [0, 1, 2, 3, 4, 5, 6, 7])
+            else:
+                q_hi = _vec_load(v4i32_ty, lds_buf_i32, [_to_index(q_hi_off)])
+                q_v8 = mvec_d.shuffle(q_lo, q_hi, [0, 1, 2, 3, 4, 5, 6, 7])
+            # 2. Load per-lane scaleA byte from LDS_QSCALE_BYTE (shared).
+            m_idx_x8 = arith_d.muli(_raw(m_idx), _raw(fx.Int32(8)))
+            qs_byte_off_b = arith_d.addi(
+                _raw(fx.Int32(Q_SCALE_BYTE_BASE)),
+                arith_d.addi(m_idx_x8, v4_g_for_lane),
+            )
+            qs_byte_v = _vec_load(v1i8_ty, lds_buf, [_to_index(qs_byte_off_b)])
+            qs_byte_i32 = arith_d.extui(i32_ty, mvec_d.extract(qs_byte_v, [], [0]))
+
+            # 3. K NoPE chunk base offsets in i32 (sub-pass 0 base).
+            k_lo_off0 = arith_d.addi(
+                _raw(fx.Int32(CUR_OFF_KNOPE_CM // 4)),
+                arith_d.addi(arith_d.muli(q_lo_chunk, _raw(fx.Int32(K_CHUNK_I32))),
+                              m_idx_x4))
+            k_hi_off0 = arith_d.addi(
+                _raw(fx.Int32(CUR_OFF_KNOPE_CM // 4)),
+                arith_d.addi(arith_d.muli(q_hi_chunk, _raw(fx.Int32(K_CHUNK_I32))),
+                              m_idx_x4))
+            # Per sub-pass sp: KV sp*16..sp*16+15. K LDS += sp*K_SUBPASS_OFF;
+            # K-scale byte += sp*KS_SUBPASS_OFF.
+            for sp in range_constexpr(NUM_SUBPASS):
+                if const_expr(sp == 0):
+                    k_lo_off = k_lo_off0
+                    k_hi_off = k_hi_off0
+                else:
+                    k_lo_off = arith_d.addi(k_lo_off0, _raw(fx.Int32(sp * K_SUBPASS_OFF)))
+                    k_hi_off = arith_d.addi(k_hi_off0, _raw(fx.Int32(sp * K_SUBPASS_OFF)))
+                k_lo_v = _vec_load(v4i32_ty, lds_buf_i32, [_to_index(k_lo_off)])
+                if const_expr(mfma_idx == NUM_MFMA_K128 - 1):
