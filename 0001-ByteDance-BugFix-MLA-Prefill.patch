+++ b/vllm/v1/attention/ops/deepseek_v4_ops/flydsl_sparse_mla_prefill.py
@@ -0,0 +1,892 @@
+"""DeepSeek-V4 sparse-MLA prefill kernel (FlyDSL).
+
+Two-source sparse multi-latent attention prefill for DeepSeek-V4 on AMD
+CDNA4 (MI300/MI355 family). This is the prefill counterpart of
+`flydsl_sparse_mla_decode.py`; the per-head MFMA/LDS/softmax machinery is
+shared verbatim — the ONLY differences are (a) the grid's x dimension
+iterates query tokens (N = Σ per-request q_len) instead of the decode
+batch, and (b) the per-token KV selection is delivered as a per-token CSR
+(`kv_indptr_* [N+1]` + `kv_indices_* [nnz]`) instead of decode's
+fixed-width per-batch index buffer + `topk_lens`.
+
+In-kernel two-source gather (零 host bf16 gather)
+-------------------------------------------------
+The kernel reads DIRECTLY from the two independent fp8 paged caches and
+gathers KV inside the kernel — host does NO bf16 KV gather and the kernel
+never sees a block_table:
+* `swa_kv_cache`         :近窗 (SWA) paged fp8 pool, own `block_size`.
+* `compressed_kv_cache`  : topk 压缩历史 (prefix) paged fp8 pool, own
+  `block_size = base // compress_ratio` (ratio ∈ {128, 4}). For a
+  SWA-only layer (`compress_ratio == 0`) there is no prefix source and the
+  prefix CSR is empty for every token.
+Both sources feed ONE fused online-softmax accumulator (region-invariant),
+plus the per-head `attn_sink` virtual-KV logit.
+
+Per-token CSR indices (global-slot, host already applied block_table)
+---------------------------------------------------------------------
+For query token t the kernel reads:
+* prefix slots `kv_indices_prefix[kv_indptr_prefix[t] : kv_indptr_prefix[t+1]]`
+* SWA    slots `kv_indices_swa   [kv_indptr_swa   [t] : kv_indptr_swa   [t+1]]`
+Each entry is a GLOBAL slot id into the matching paged cache (`slot == -1`
+→ padding, masked). causal is NOT handled in-kernel — host encodes it into
+the SWA CSR (only slots at position ≤ t are listed); the kernel does zero
+causal / position logic and takes no `position` / `block_table` argument.
+
+Per V4 KV-cache slot (SLOT_BYTES = 584 bytes/token, packed per-block;
+data region and scale region are SEPARATE within a block — same layout
+the decode kernel reads):
+  per-block bytes [0 : block_size*576]      `block_size` × (448 NoPE FP8
+                                            e4m3 + 64 RoPE BF16) slots
+  per-block bytes [block_size*576 : *584]   `block_size` × 8 e8m0 scale
+                                            bytes (7 valid groups + 1 pad)
+`block_size` (per pool) is read from each cache's `shape[1]` and must be a
+power of 2 so slot→(block, pos) is a shift/mask. The per-block byte stride
+comes from `*_block_stride_b` (= `cache.stride(0)`), so alignment padding
+larger than `block_size*584` is handled correctly.
+
+Pipeline (two sources, merged via online softmax, FlashAttention-style)
+----------------------------------------------------------------------
+  NUM_SWA_TILES SWA tiles, then NUM_COMP_TILES prefix tiles (32 KV/tile).
+  Per outer tile, in order:
+    load K (NoPE FP8 + RoPE BF16 + e8m0 scale) into LDS from the tile's
+      source cache (SWA or compressed) via its own global-slot CSR
+    QK = MFMA(Qn, Kn, fp8) * group_scales + MFMA(Qr, Kr, bf16)
+    online softmax merge (compute m_new, alpha, exp_qk, l)
+    P  = truncf(exp_qk → bf16) → LDS
+    PV = MFMA(P, V_dequant, bf16)  for 28 NoPE chunks + 4 RoPE chunks
+    acc[c][i] = alpha * acc[c][i] + O_partial[c][i]
+  Sink fold (per-head learned scalar, virtual KV with score=sink, no V):
+    m_final = max(m, sink)   alpha = exp((m - m_final) * log2e)
+    l_final = l * alpha + exp((sink - m_final) * log2e)
+    O[c][i] = (acc[c][i] * alpha) / l_final[i]
+
+Invalid slots (slot_id == -1, or kv >= per-token CSR length) → K data
+masked to 0, qk masked to NEG_INF (via per-tile valid-mask LDS region) so
+they contribute neither to softmax denominators nor to the output.
+
+JIT specialization
+------------------
+A separate kernel binary is JIT-built per observed
+`(swa_block_size, comp_block_size, k_splits)` tuple via
+`_make_prefill_kernel` and cached in `_LAUNCH_CACHE`. Both block sizes
+must be powers of 2; `k_splits` must divide `NUM_COMP_TILES`.
+
+Public API
+----------
+`flydsl_sparse_mla_prefill_fp8(...)` is the wrapper. Q is BF16 in (the
+kernel quantizes the NoPE half to FP8 + e8m0 per group=64 internally;
+no scratch). The wrapper passes the two paged caches + two CSR index sets
+straight through (no host gather) and picks (or builds) the matching
+kernel binary.
+
+Toggled at the dispatch site via `VLLM_DSV4_USE_FLYDSL_PREFILL_FP8=1`.
+"""
+
+from __future__ import annotations
+
+import torch
+# The per-head MFMA / online-softmax / PV kernel body lives in
+# `flydsl_sparse_mla_common.emit_kn_qk_pv` (shared with the decode kernel);
+# this module only keeps the imports its own signature + index plumbing +
+# launch wrappers still reference. The full DSL/dialect surface used by the
+# shared body is imported by the common module.
+import os
+import flydsl.compiler as flyc
+import flydsl.expr as fx
+from flydsl._mlir.dialects import arith as arith_d
+from flydsl._mlir.dialects import math as math_d
+from flydsl.expr import buffer_ops, gpu, rocdl
+from flydsl.expr.arith import _to_raw as _raw
+from flydsl.expr.typing import T
+from flydsl._mlir.extras import types as MT
+from flydsl._mlir import ir as ir_d
+from flydsl._mlir.dialects import llvm as llvm_d
+from flydsl._mlir.dialects import fly as fly_d
+
+
+from .flydsl_sparse_mla_common import *  # noqa: F401,F403
+# Module handle (not just the star-imported names) so the launcher can narrow
+# the comp-tile unroll (NUM_COMP_TILES / NUM_TILES / COMP_MAX) per call for
+# small / take-all comp pools. emit_kn_qk_pv resolves these against THIS
+# module's globals at JIT-trace time (which is lazy — first launch invocation).
+import math as _math  # noqa: E402
+from . import flydsl_sparse_mla_common as _common  # noqa: E402
+
+# The full (index_topk=1024) comp-tile unroll, captured once as the default
+# upper bound. The star-imported NUM_COMP_TILES mirrors this at import time.
+_DEFAULT_NUM_COMP_TILES = NUM_COMP_TILES  # noqa: F405
+
+
+def _make_prefill_kernel(swa_block_size: int, comp_block_size: int,  # noqa: D401
+                         k_splits: int = 1,
+                         comp_tiles: int = _DEFAULT_NUM_COMP_TILES,
+                         t_q: int = 1):
+    return _make_prefill_kernel_impl(swa_block_size, comp_block_size,
+                                     k_splits, comp_tiles, t_q)
+
+
+def _make_prefill_kernel_impl(swa_block_size: int, comp_block_size: int,
+                         k_splits: int = 1,
+                         comp_tiles: int = _DEFAULT_NUM_COMP_TILES,
+                         t_q: int = 1):
+    """Build a JIT-decorated ``kn_qk_pv`` specialized for the given
+    (SWA_BLOCK_SIZE, COMP_BLOCK_SIZE, K_SPLITS) tuple. Returns the
+    decorated function.
+
+    Two-source prefill: each pool's block size is independent and is read
+    from ``swa_kv_cache.shape[1]`` / ``compressed_kv_cache.shape[1]`` at
+    wrapper time (``= vllm cache_config.block_size // compress_ratio`` for
+    the compressed pool). Both must be powers of 2 so slot→(block, pos) is
+    a shift/mask.
+
+    ``k_splits`` partitions the COMP (prefix) tile range across that many
+    WGs per (token, head_chunk). Each WG processes
+    ``NUM_COMP_TILES // k_splits`` consecutive prefix tiles plus the full
+    SWA region (SWA is duplicated across splits — small, L2-friendly).
+    Reduce kernel merges the K_SPLITS partials. ``k_splits == 1`` keeps the
+    single-WG path (no partial scratch, sink fold + final divide done in
+    this kernel). Must divide ``NUM_COMP_TILES``.
+    """
+    if _common.NUM_COMP_TILES % k_splits != 0:
+        raise AssertionError(
+            f"k_splits={k_splits} must divide "
+            f"NUM_COMP_TILES={_common.NUM_COMP_TILES}"
+        )
+    # The effective comp-tile unroll for THIS binary (set by the wrapper via the
+    # module tile globals around the build). Bound here as a closure scalar and
+    # referenced inside kn_qk_pv so flydsl's JIT cache key (which hashes closure
+    # scalars but NOT module globals) differentiates the narrowed binary from
+    # the full 32-tile one — otherwise a stale disk-cached binary is served.
+    _CACHE_TAG_COMP_TILES = int(comp_tiles)
+    # Closure-bound Python ints; baked into the kernel body at JIT time.
+    SWA_BLOCK_SIZE = swa_block_size
+    SWA_BLOCK_LOG2 = _log2_exact(swa_block_size)
+    SWA_BLOCK_MASK = SWA_BLOCK_SIZE - 1
+    SWA_NOPE_ROPE_REGION = SWA_BLOCK_SIZE * NOPE_ROPE_SLOT_BYTES
+    COMP_BLOCK_SIZE = comp_block_size
+    COMP_BLOCK_LOG2 = _log2_exact(comp_block_size)
+    COMP_BLOCK_MASK = COMP_BLOCK_SIZE - 1
+    COMP_NOPE_ROPE_REGION = COMP_BLOCK_SIZE * NOPE_ROPE_SLOT_BYTES
+    # Split-K: each WG processes COMP_TILES_PER_SPLIT consecutive prefix
+    # tiles starting at NUM_SWA_TILES + k_split_idx * COMP_TILES_PER_SPLIT.
+    # SWA is NOT split — all WGs run all SWA tiles (small, L2-friendly).
+    K_SPLITS = k_splits
+    COMP_TILES_PER_SPLIT = _common.NUM_COMP_TILES // K_SPLITS
+    # route C: T_Q query tokens share each loaded K tile (one block does
+    # T_Q tokens; base-token CSR is shared across the tile -- valid when the
+    # per-token slot lists are (near-)identical). T_Q==1 = production per-token.
+    T_Q = int(t_q)
+
+    @flyc.kernel(known_block_size=[NUM_THREADS, 1, 1])
+    def kn_qk_pv(
+        q_ptr: fx.Tensor,            # BF16 [N, h, V_HEAD_DIM] = NoPE 0..447 + RoPE 448..511
+        swa_cache_ptr: fx.Tensor,    # SWA paged fp8 pool [num_blocks, swa_bs, 584] uint8
+        comp_cache_ptr: fx.Tensor,   # compressed (prefix) paged fp8 pool [num_blocks, comp_bs, 584]
+        swa_indices_ptr: fx.Tensor,  # int32 [nnz_swa] flat global slot ids (-1 = invalid)
+        comp_indices_ptr: fx.Tensor, # int32 [nnz_comp] flat global slot ids (-1 = invalid)
+        swa_indptr_ptr: fx.Tensor,   # int32 [N+1] per-token CSR row pointers (SWA)
+        comp_indptr_ptr: fx.Tensor,  # int32 [N+1] per-token CSR row pointers (prefix)
+        sink_ptr: fx.Tensor,
+        o_ptr: fx.Tensor,
+        sm_scale: fx.Float32,
+        # ---- Stride runtime args (one per kernel-direct tensor) -----------
+        # All raw byte-ptr addressing in the kernel uses these — never
+        # hardcode `shape × element_size`, because vllm may allocate with
+        # per-block / per-row cache-line padding. Strides are in the unit
+        # each ptr is read in (bytes for the byte-addressed paged cache,
+        # f32 for f32-typed reads, i32 for word-typed reads).
+        swa_block_stride_b: fx.Int32,    # SWA cache outer stride, bytes/block
+        comp_block_stride_b: fx.Int32,   # COMP cache outer stride, bytes/block
+        sink_stride_f32: fx.Int32,       # attn_sink stride, f32/element
+        q_m_stride_i32: fx.Int32,        # q BF16 row stride, i32/m-row (= V_HEAD_DIM*2/4)
+        o_m_stride_bf16: fx.Int32,       # output o row stride, bf16/m-row
+        swa_idx_stride_i32: fx.Int32,    # swa_indices inner stride, i32/element
+        comp_idx_stride_i32: fx.Int32,   # comp_indices inner stride, i32/element
+        # ---- Per-token outer strides (token grid hoist) -------------------
+        # Each block handles one (token_idx, head_chunk_idx). Offsets are
+        # in the same units as the per-row strides above (i32 / f32).
+        q_token_stride_i32: fx.Int32,
+        o_token_stride_bf16: fx.Int32,
+        swa_indptr_stride_i32: fx.Int32,   # swa_indptr stride, i32/element (per token)
+        comp_indptr_stride_i32: fx.Int32,  # comp_indptr stride, i32/element (per token)
+        # ---- Split-K partial outputs (only used when K_SPLITS > 1) --------
+        # Layout: [N, K_SPLITS, M_DIM, V_HEAD_DIM] for partial_o,
+        #         [N, K_SPLITS, M_DIM] for partial_m / partial_l (all f32).
+        # When K_SPLITS == 1, the kernel writes the final BF16 output into
+        # `o_ptr` directly (sink fold + divide done in this kernel) and these
+        # pointers are unused (wrapper passes a dummy 1-element f32 tensor).
+        # When K_SPLITS > 1, the kernel skips sink fold + divide, instead
+        # writing per-WG partials here for a follow-up Triton reduce.
+        partial_o_ptr: fx.Tensor,
+        partial_m_ptr: fx.Tensor,
+        partial_l_ptr: fx.Tensor,
+        partial_o_b_stride_f32: fx.Int32,    # stride per token in po, f32 elem
+        partial_m_b_stride_f32: fx.Int32,    # stride per token in pm/pl, f32 elem
+    ):
+        # Capture the comp-tile cache tag as a freevar (no IR emitted) so the
+        # JIT cache key distinguishes the narrowed-unroll binary (see comment
+        # at `_CACHE_TAG_COMP_TILES` above).
+        _cache_tag = _CACHE_TAG_COMP_TILES  # noqa: F841
+        q_rsrc = buffer_ops.create_buffer_resource(q_ptr)
+        cache_swa_rsrc = buffer_ops.create_buffer_resource(swa_cache_ptr)
+        cache_comp_rsrc = buffer_ops.create_buffer_resource(comp_cache_ptr)
+        swa_idx_rsrc = buffer_ops.create_buffer_resource(swa_indices_ptr)
+        comp_idx_rsrc = buffer_ops.create_buffer_resource(comp_indices_ptr)
+        swa_indptr_rsrc = buffer_ops.create_buffer_resource(swa_indptr_ptr)
+        comp_indptr_rsrc = buffer_ops.create_buffer_resource(comp_indptr_ptr)
+        sink_rsrc = buffer_ops.create_buffer_resource(sink_ptr)
+        o_rsrc = buffer_ops.create_buffer_resource(o_ptr)
+        # Partial output buffer resources (always created; only used when K_SPLITS > 1).
+        po_rsrc = buffer_ops.create_buffer_resource(partial_o_ptr)
+        pm_rsrc = buffer_ops.create_buffer_resource(partial_m_ptr)
+        pl_rsrc = buffer_ops.create_buffer_resource(partial_l_ptr)
+
+        # Grid parallelism: blockIdx.x = token_idx, blockIdx.y =
+        # head_chunk_idx, blockIdx.z = k_split_idx (Split-K). Each block
+        # handles one (query token, M_DIM=16 head chunk, K-slice). The shared
+        # body (emit_kn_qk_pv) consumes the resolved ids + offsets below.
+        block_x_idx = fx.Int32(_raw(gpu.block_id("x")))
+        head_chunk_idx = fx.Int32(_raw(gpu.block_id("y")))
+        k_split_idx = fx.Int32(_raw(gpu.block_id("z")))
+        # route C (T_Q>1): blockIdx.x indexes a TILE of T_Q tokens; the tile's
+        # base token drives the shared q/o base + the shared (base-token) CSR.
+        # Per-token advance inside the body uses q_token_stride / o_token_stride
+        # passed as the route-C head(=token) strides. T_Q==1 -> token = block.
+        token_base_idx = block_x_idx * fx.Int32(T_Q) if T_Q > 1 else block_x_idx
+        # Per-tensor token base offset (in each tensor's read unit).
+        q_batch_off = token_base_idx * q_token_stride_i32
+        o_batch_off = token_base_idx * o_token_stride_bf16
+        # ---- Per-token CSR row pointers (read once each) ----
+        # For source S: this token's valid slots are
+        #   S_indices[S_indptr[t] : S_indptr[t+1]]  (flat global slot ids).
+        # `*_batch_off` = i32-element offset of the first slot; `*_max` = the
+        # per-token count = indptr[t+1] - indptr[t] (used as cur_idx_max).
+        swa_indptr_off = token_base_idx * swa_indptr_stride_i32
+        swa_csr_lo = fx.Int32(_raw(buffer_ops.buffer_load(
+            swa_indptr_rsrc, _raw(swa_indptr_off), vec_width=1, dtype=T.i32)))
+        swa_csr_hi = fx.Int32(_raw(buffer_ops.buffer_load(
+            swa_indptr_rsrc, _raw(swa_indptr_off + swa_indptr_stride_i32),
+            vec_width=1, dtype=T.i32)))
+        swa_max = arith_d.subi(_raw(swa_csr_hi), _raw(swa_csr_lo))
+        comp_indptr_off = token_base_idx * comp_indptr_stride_i32
+        comp_csr_lo = fx.Int32(_raw(buffer_ops.buffer_load(
+            comp_indptr_rsrc, _raw(comp_indptr_off), vec_width=1, dtype=T.i32)))
+        comp_csr_hi = fx.Int32(_raw(buffer_ops.buffer_load(
+            comp_indptr_rsrc, _raw(comp_indptr_off + comp_indptr_stride_i32),
+            vec_width=1, dtype=T.i32)))
+        comp_max = arith_d.subi(_raw(comp_csr_hi), _raw(comp_csr_lo))
+        # i64-safe idx resource: advance base ptr by csr_lo*stride bytes
+        _i64_ty = ir_d.IntegerType.get_signless(64)
+        _i64_4 = arith_d.constant(_i64_ty, ir_d.IntegerAttr.get(_i64_ty, 4))
+        def _make_idx_rsrc_at(idx_ptr, csr_lo_i32, stride_i32):
+            _ptr_ty = ir_d.Type.parse("!llvm.ptr")
+            _rsrc_ty = ir_d.Type.parse("!llvm.ptr<8>")
+            _base_idx = buffer_ops.extract_base_index(idx_ptr, address_space=1)
+            _base_i64 = arith_d.index_cast(_i64_ty, _base_idx)
+            _csr_i64 = arith_d.extsi(_i64_ty, _raw(csr_lo_i32))
+            _stride_i64 = arith_d.extsi(_i64_ty, _raw(stride_i32))
+            _byte_off = arith_d.muli(arith_d.muli(_csr_i64, _stride_i64), _i64_4)
+            _adv_i64 = arith_d.addi(_base_i64, _byte_off)
+            _adv_ptr = llvm_d.IntToPtrOp(_ptr_ty, _adv_i64).result
+            _i16_ty = ir_d.IntegerType.get_signless(16)
+            _stride0 = arith_d.constant(_i16_ty, ir_d.IntegerAttr.get(_i16_ty, 0))
+            _max_rec = arith_d.constant(_i64_ty, ir_d.IntegerAttr.get(_i64_ty, 0xFFFFFFFF))
+            from flydsl.expr.buffer_ops import _get_buffer_flags, _create_i32_constant
+            _flags = _create_i32_constant(_get_buffer_flags())
+            return rocdl.MakeBufferRsrcOp(_rsrc_ty, _adv_ptr, _stride0, _max_rec, _flags).result
+        swa_idx_rsrc = _make_idx_rsrc_at(swa_indices_ptr, swa_csr_lo, swa_idx_stride_i32)
+        comp_idx_rsrc = _make_idx_rsrc_at(comp_indices_ptr, comp_csr_lo, comp_idx_stride_i32)
+        swa_batch_off = fx.Int32(0)
+        comp_batch_off = fx.Int32(0)
+        emit_kn_qk_pv(
+            q_rsrc=q_rsrc,
+            cache_swa_rsrc=cache_swa_rsrc,
+            cache_comp_rsrc=cache_comp_rsrc,
+            cache_swa_ptr=swa_cache_ptr,
+            cache_comp_ptr=comp_cache_ptr,
+            swa_idx_rsrc=swa_idx_rsrc,
+            comp_idx_rsrc=comp_idx_rsrc,
+            sink_rsrc=sink_rsrc,
+            o_rsrc=o_rsrc,
+            po_rsrc=po_rsrc,
+            pm_rsrc=pm_rsrc,
+            pl_rsrc=pl_rsrc,
+            block_x_idx=block_x_idx,
+            head_chunk_idx=head_chunk_idx,
+            k_split_idx=k_split_idx,
+            q_batch_off=q_batch_off,
+            o_batch_off=o_batch_off,
+            swa_batch_off=swa_batch_off,
+            swa_max=swa_max,
+            comp_batch_off=comp_batch_off,
+            comp_max=comp_max,
+            swa_block_stride_b=swa_block_stride_b,
+            comp_block_stride_b=comp_block_stride_b,
+            sink_stride_f32=sink_stride_f32,
+            q_m_stride_i32=q_m_stride_i32,
+            o_m_stride_bf16=o_m_stride_bf16,
+            swa_idx_stride_i32=swa_idx_stride_i32,
+            comp_idx_stride_i32=comp_idx_stride_i32,
+            partial_o_b_stride_f32=partial_o_b_stride_f32,
+            partial_m_b_stride_f32=partial_m_b_stride_f32,
+            sm_scale=sm_scale,
+            SWA_BLOCK_LOG2=SWA_BLOCK_LOG2,
+            SWA_BLOCK_MASK=SWA_BLOCK_MASK,
+            SWA_NOPE_ROPE_REGION=SWA_NOPE_ROPE_REGION,
+            COMP_BLOCK_LOG2=COMP_BLOCK_LOG2,
+            COMP_BLOCK_MASK=COMP_BLOCK_MASK,
+            COMP_NOPE_ROPE_REGION=COMP_NOPE_ROPE_REGION,
+            K_SPLITS=K_SPLITS,
+            COMP_TILES_PER_SPLIT=COMP_TILES_PER_SPLIT,
+            clamp_denom=True,
+            # route C: T_Q query tokens share each loaded K tile. The body
+            # reuses the bigm head-stride params as the per-TOKEN q/o advance.
+            batch_tokens=T_Q,
+            bigm_q_head_stride_i32=(q_token_stride_i32 if T_Q > 1 else None),
+            bigm_o_head_stride_bf16=(o_token_stride_bf16 if T_Q > 1 else None),
+        )
+
+
+    return kn_qk_pv
+
+
+SOFTMAX_SCALE = 1.0 / 8.0   # launch default; the wrapper passes the actual sm_scale
+
+
+def _make_launch(swa_block_size: int, comp_block_size: int,
+                 k_splits: int = 1,
+                 comp_tiles: int = _DEFAULT_NUM_COMP_TILES,
+                 t_q: int = 1):
+    """Build a `@flyc.jit`-wrapped launch helper for the
+    (swa_block_size, comp_block_size, k_splits, comp_tiles, t_q) tuple. Each
+    helper closes over a freshly-built kernel binary specialized for those
+    values; the defaults for the `*_block_stride_b` args are the packed
+    `block_size * SLOT_BYTES` (vllm passes the actual `cache.stride(0)` at
+    call time). ``t_q``>1 enables route-C token-tiling (grid.x = ceil(N/t_q)).
+    """
+    kn = _make_prefill_kernel(swa_block_size, comp_block_size, k_splits,
+                              comp_tiles, t_q)
+    _T_Q = int(t_q)
+    swa_packed_stride = swa_block_size * SLOT_BYTES
+    comp_packed_stride = comp_block_size * SLOT_BYTES
+
+    @flyc.jit
+    def launch(q, swa_cache, comp_cache,
+               swa_indices, comp_indices, swa_indptr, comp_indptr,
+               sink, o,
+               partial_o, partial_m, partial_l,
+               sm_scale: fx.Float32 = fx.Float32(SOFTMAX_SCALE),
+               swa_block_stride_b: fx.Int32 = fx.Int32(swa_packed_stride),
+               comp_block_stride_b: fx.Int32 = fx.Int32(comp_packed_stride),
+               sink_stride_f32: fx.Int32 = fx.Int32(1),
+               q_m_stride_i32: fx.Int32 = fx.Int32(V_HEAD_DIM // 2),
+               o_m_stride_bf16: fx.Int32 = fx.Int32(V_HEAD_DIM),
+               swa_idx_stride_i32: fx.Int32 = fx.Int32(1),
+               comp_idx_stride_i32: fx.Int32 = fx.Int32(1),
+               q_token_stride_i32: fx.Int32 = fx.Int32(0),
+               o_token_stride_bf16: fx.Int32 = fx.Int32(0),
+               swa_indptr_stride_i32: fx.Int32 = fx.Int32(1),
+               comp_indptr_stride_i32: fx.Int32 = fx.Int32(1),
+               partial_o_b_stride_f32: fx.Int32 = fx.Int32(
+                   k_splits * M_DIM * V_HEAD_DIM),
+               partial_m_b_stride_f32: fx.Int32 = fx.Int32(
+                   k_splits * M_DIM),
+               t: fx.Int32 = fx.Int32(1),
+               n_head_chunks: fx.Int32 = fx.Int32(1),
+               stream: fx.Stream = fx.Stream(None)):
+        """Launch one prefill (`t × n_head_chunks × k_splits` blocks).
+
+        ``t`` (number of query tokens, N = Σ per-request q_len) and
+        ``n_head_chunks`` are grid-sizing arguments only (NOT consumed by
+        the kernel body — the kernel reads ``gpu.block_id("x")`` /
+        ``gpu.block_id("y")`` / ``gpu.block_id("z")`` directly). They are
+        passed as runtime ``fx.Int32`` so that varying token/head counts
+        reuse a single JIT'd binary instead of per-shape recompiles.
+
+        Grid: blockIdx.x = token_idx ∈ [0, t), blockIdx.y =
+        head_chunk_idx ∈ [0, n_head_chunks), blockIdx.z =
+        k_split_idx ∈ [0, k_splits). Each block handles one
+        (query token, M_DIM=16 head chunk, K-slice).
+
+        Q is BF16 in ``[t, h, V_HEAD_DIM]``; the kernel quantizes the NoPE
+        half to FP8 + e8m0 internally and reads the RoPE half directly as
+        BF16. The two paged fp8 caches + two per-token CSR index sets
+        (`*_indices` flat global slots + `*_indptr` row pointers) are passed
+        straight through. Stride args are in the unit each ptr is read in
+        (bytes for cache, f32 / i32 elsewhere).
+
+        ``partial_o / partial_m / partial_l`` are scratch f32 tensors used
+        only when ``k_splits > 1`` (kernel writes per-WG partials, wrapper
+        invokes Triton reduce). For ``k_splits == 1`` the wrapper passes
+        1-element dummy tensors (kernel never touches them).
+        """
+        kn(q, swa_cache, comp_cache,
+           swa_indices, comp_indices, swa_indptr, comp_indptr,
+           sink, o, sm_scale,
+           swa_block_stride_b, comp_block_stride_b,
+           sink_stride_f32, q_m_stride_i32,
+           o_m_stride_bf16,
+           swa_idx_stride_i32, comp_idx_stride_i32,
+           q_token_stride_i32,
+           o_token_stride_bf16,
+           swa_indptr_stride_i32, comp_indptr_stride_i32,
+           partial_o, partial_m, partial_l,
+           partial_o_b_stride_f32, partial_m_b_stride_f32).launch(
+            grid=(arith_d.index_cast(
+                      MT.index(),
+                      _raw((t + fx.Int32(_T_Q - 1)) // fx.Int32(_T_Q))
+                      if _T_Q > 1 else _raw(t)),
+                  arith_d.index_cast(MT.index(), _raw(n_head_chunks)),
+                  k_splits),
+            block=(NUM_THREADS, 1, 1), smem=0, stream=stream)
+
+    return launch
+
+
+# Per-(swa_block_size, comp_block_size, k_splits) launch helper cache. Each
+# entry is a fresh `@flyc.jit` launch wrapping a fresh `@flyc.kernel` binary;
+# built lazily on first use and reused thereafter (sized to the small set of
+# tuples vllm produces in a given deployment).
+_LAUNCH_CACHE: dict[tuple[int, int, int, int], object] = {}
+
+
+def _get_launch(swa_block_size: int, comp_block_size: int,
+                k_splits: int = 1, comp_tiles: int = _DEFAULT_NUM_COMP_TILES,
+                t_q: int = 1):
+    # `comp_tiles` participates in the key so a narrowed-unroll binary (small /
+    # take-all comp pool) is cached separately from the full 32-tile one. The
+    # body is JIT'd lazily on first invocation; the wrapper sets the matching
+    # module tile globals around that first call (see flydsl_sparse_mla_prefill_fp8).
+    key = (swa_block_size, comp_block_size, k_splits, comp_tiles, t_q)
+    fn = _LAUNCH_CACHE.get(key)
+    if fn is None:
+        fn = _make_launch(swa_block_size, comp_block_size, k_splits, comp_tiles,
+                          t_q)
+        _LAUNCH_CACHE[key] = fn
+    return fn
+
+
+# K_SPLITS dispatch for prefill.
+#
+# Prefill grids over query tokens (T), which is typically far larger than the
+# decode batch — the HW is usually already saturated by the token × head_chunk
+# grid, so split-K rarely helps and its reduce-kernel overhead dominates. We
+# therefore default to K_SPLITS == 1 (no partials, sink fold + divide in the
+# main kernel). The env override `VLLM_DSV4_SPARSE_MLA_PREFILL_K_SPLITS` is
+# kept for benchmarking; it must divide `NUM_COMP_TILES`.
+#
+# cudagraph-safe: only uses Python-level `t` which is wrapper-time static.
+# MUST NOT read tensor data (e.g. per-token CSR lengths).
+NUM_CUS = 256                                          # MI355X
+TARGET_WG_PER_CU = 2                                   # 2 waves/SIMD via waves_per_eu=2
+# Cap Split-K so each split still owns a meaningful slice of the COMP range.
+# k=16 (=> COMP_TILES_PER_SPLIT==2) over-splits: 16× SWA-tile duplication +
+# a 16-way reduce, for no measured gain over k=8 (the 2-WG/CU target is
+# already met at far smaller k for any non-trivial token grid), and it is the
+# only split factor not covered by the in-tree Split-K correctness sweep
+# ({1,2,4,8}). Keeping k ≤ 8 preserves every measured speedup
+# (N=64→k8, N=128→k4, N=256→k2) while staying inside the validated envelope.
+MAX_K_SPLITS = 8
+
+
+def _choose_k_splits(t: int, n_head_chunks: int = 1,
+                     has_prefix: bool = True,
+                     comp_pool_slots: int | None = None) -> int:
+    """Pick K_SPLITS for this prefill call. cudagraph-safe: uses only the
+    wrapper-time-static token count ``t``, the head-chunk count, the
+    structural ``has_prefix`` flag, and the comp KV-pool *capacity*
+    (``num_blocks × block_size``, a shape — never tensor data). Must divide
+    ``NUM_COMP_TILES``.
+
+    The grid launches ``t × n_head_chunks × k_splits`` work-groups. Each WG
+    occupies one wave on each of its 4 SIMDs, so device occupancy (waves/SIMD)
+    scales with WG/CU = total_wgs / NUM_CUS. We target ``TARGET_WG_PER_CU``
+    (= 2 waves/SIMD, the sweet spot the kernel's ``waves_per_eu=2`` hint is
+    sized for) and pick the smallest legal Split-K that reaches it. Measured
+    optima (gfx950, h=16, nnz=128+1024) land exactly on
+    ``t × n_head_chunks × k ≈ 2 × NUM_CUS``:
+      N=256→k2 (98→73µs), N=128→k4 (98→47µs), N=64→k8 (98→36µs).
+
+    Split-K partitions ONLY the COMP (prefix) tile range; the SWA region is
+    duplicated across every split. With no prefix source there is nothing to
+    split (each split would redundantly re-run the full SWA region for no
+    gain), so SWA-only layers never split."""
+    import os as _os
+    env = _os.environ.get("VLLM_DSV4_SPARSE_MLA_PREFILL_K_SPLITS")
+    if env is not None:
+        return _validate_k_splits(int(env))
+
+    # Occupancy-aware auto Split-K is OPT-IN (default off → always-safe k=1).
+    #
+    # It delivers large speedups at small token counts where the token × head
+    # grid under-fills the device (measured gfx950: N=64 2.70x, N=128 2.08x,
+    # N=256 1.34x). BUT the per-token prefill kernel's Split-K (K_SPLITS>1)
+    # compute path has a latent, layout-dependent global out-of-bounds access:
+    # with k>1 it intermittently faults (GPU "Memory access fault ... Reason:
+    # Unknown") when a prior large/heterogeneous launch churns the allocator so
+    # the OOB lands on an unmapped page. It was localized to the main kernel
+    # (NOT the Triton reduce — disabling the reduce still faults; NOT
+    # uninitialized scratch — zero-init does not help) and is independent of
+    # comp-pool size (a 1024-slot pool at k=8 still faults). Root-causing the
+    # exact instruction needs a GPU memory sanitizer pass on the JIT'd ISA.
+    # Until that kernel bug is fixed, do not enable Split-K by default.
+    if _os.environ.get("VLLM_DSV4_SPARSE_MLA_PREFILL_AUTO_SPLITK") != "1":
+        return 1
+
+    # No prefix source → COMP range is empty; splitting only duplicates SWA.
+    if not has_prefix:
+        return 1
+
+    # Tiny comp pool → don't split. Split-K only partitions the COMP range,
+    # so it only pays off when there is a substantial prefix pool to stream
+    # (it trades SWA duplication + a K-way reduce for COMP-range parallelism).
+    # When the *entire* comp pool is smaller than one un-split comp working
+    # set (NUM_COMP_TILES × N_TILE KV), each split would own a fraction of a
+    # single tile of real data — zero bandwidth benefit. This degenerate
+    # regime (e.g. a handful of KV blocks) is also the only one that exposes a
+    # latent layout-dependent OOB in the kernel's Split-K comp gather: the
+    # over-split address arithmetic lands just past the small pool, normally
+    # on mapped memory (silent) but on an unmapped page after a large prior
+    # allocation churns the allocator → intermittent GPU memory-access fault.
+    # Staying un-split here is both faster and robust. Realistic prefill pools
+    # (thousands of slots) are far above this floor and still split.
+    if (comp_pool_slots is not None
+            and comp_pool_slots < _common.NUM_COMP_TILES * _common.N_TILE):
+        return 1
+
+    # Total base work-groups already launched by the token × head grid.
+    base_wgs = t * max(1, n_head_chunks)
+    target_wgs = TARGET_WG_PER_CU * NUM_CUS
+    # Grid already fills the device to the target occupancy → no split.
+    if base_wgs >= target_wgs:
+        return 1
+    # Under-filled: split COMP so total WGs (base_wgs × k) ≈ target (2 WG/CU),
+    # capped so each split still owns ≥ 2 prefix tiles and k | NUM_COMP_TILES.
+    needed_k = max(1, (target_wgs + base_wgs - 1) // base_wgs)
+    legal = [k for k in (1, 2, 4, 8, 16)
+             if k <= MAX_K_SPLITS
+             and _common.NUM_COMP_TILES % k == 0
+             and _common.NUM_COMP_TILES // k >= 2]
+    ks = next((k for k in reversed(legal) if k <= needed_k), 1)
+    return ks
+
+
+def _validate_k_splits(ks: int) -> int:
+    if _common.NUM_COMP_TILES % ks != 0:
+        raise AssertionError(
+            f"K_SPLITS={ks} must divide NUM_COMP_TILES={_common.NUM_COMP_TILES}"
+        )
+    return ks
+
+
+# ===========================================================================
+# Wrapper: vllm dispatch entry point.
+# ===========================================================================
+
+
+# Cudagraph-safe Split-K partial output scratch. Layout (per K_SPLITS value):
+#   po: [T, n_head_chunks, K_SPLITS, M_DIM, V_HEAD_DIM] f32
+#   pm: [T, n_head_chunks, K_SPLITS, M_DIM]             f32
+#   pl: [T, n_head_chunks, K_SPLITS, M_DIM]             f32
+# Pre-sized to (_PARTIAL_MAX_B, _PARTIAL_MAX_HC, K_SPLITS, ...) so per-call
+# slicing is metadata-only (cudagraph-safe). Keyed by (device, K_SPLITS).
+# T here is the number of query tokens in the chunk.
+_PARTIAL_SCRATCH: dict = {}
+_PARTIAL_MAX_B = 2048
+_PARTIAL_MAX_HC = 8
+
+# Tiny dummy tensor used as the partial pointer when K_SPLITS == 1 (kernel
+# never touches it). Pre-allocated per device, reused via slice.
+_DUMMY_PARTIAL: dict = {}
+
+
+def _get_dummy_partial(device: torch.device):
+    key = (device.type, device.index)
+    d = _DUMMY_PARTIAL.get(key)
+    if d is None:
+        # 4 elements f32 (small, easy to spot in dumps if anything reads it).
+        d = torch.zeros(4, dtype=torch.float32, device=device)
+        _DUMMY_PARTIAL[key] = d
+    return d
+
+
+# All-zero prefix indptr for SWA-only layers (compress_ratio == 0). An
+# all-zero `[N+1]` CSR row pointer makes every token's prefix count
+# (indptr[t+1]-indptr[t]) == 0, so the kernel masks every prefix tile and
+# never reads the (reused-SWA) comp cache. Pre-allocated + sliced so the
+# per-call path is metadata-only (cudagraph-safe). Keyed by device.
+_ZERO_INDPTR: dict = {}
+_ZERO_INDPTR_MAX_N = 2048
+
+
+def _get_zero_indptr(t: int, device: torch.device):
+    key = (device.type, device.index)
+    z = _ZERO_INDPTR.get(key)
+    if z is None or z.numel() < t + 1:
+        n = max(t + 1, _ZERO_INDPTR_MAX_N)
+        z = torch.zeros(n, dtype=torch.int32, device=device)
+        _ZERO_INDPTR[key] = z
+    return z[: t + 1]
+
+
+def _get_partial_scratch(b: int, n_head_chunks: int, k_splits: int,
+                         device: torch.device):
+    """Return (po, pm, pl) views sized to this call. Cudagraph-safe via
+    metadata-only slicing of pre-allocated module-level pools."""
+    key = (device.type, device.index, k_splits)
+    s = _PARTIAL_SCRATCH.get(key)
+    if s is None:
+        po = torch.empty(_PARTIAL_MAX_B, _PARTIAL_MAX_HC, k_splits,
+                         M_DIM, V_HEAD_DIM,
+                         dtype=torch.float32, device=device)
+        pm = torch.empty(_PARTIAL_MAX_B, _PARTIAL_MAX_HC, k_splits, M_DIM,
+                         dtype=torch.float32, device=device)
+        pl = torch.empty(_PARTIAL_MAX_B, _PARTIAL_MAX_HC, k_splits, M_DIM,
+                         dtype=torch.float32, device=device)
+        s = (po, pm, pl)
+        _PARTIAL_SCRATCH[key] = s
+    if b > _PARTIAL_MAX_B:
+        raise AssertionError(
+            f"sparse_mla: batch {b} > Split-K scratch pool {_PARTIAL_MAX_B}; "
+            f"raise `_PARTIAL_MAX_B`.")
+    if n_head_chunks > _PARTIAL_MAX_HC:
+        raise AssertionError(
+            f"sparse_mla: n_head_chunks {n_head_chunks} > Split-K scratch pool "
+            f"{_PARTIAL_MAX_HC}; raise `_PARTIAL_MAX_HC`.")
+    po, pm, pl = s
+    return po[:b, :n_head_chunks], pm[:b, :n_head_chunks], pl[:b, :n_head_chunks]
+
+
+def flydsl_sparse_mla_prefill_fp8(
+    q: torch.Tensor,                          # [N, h, 512] BF16 (N query tokens)
+    swa_kv_cache: torch.Tensor,               # [num_blocks, swa_bs, 584] uint8 SWA pool
+    swa_indices: torch.Tensor,                # [nnz_swa] int32 global slot ids (-1 = invalid)
+    swa_indptr: torch.Tensor,                 # [N+1] int32 per-token CSR row pointers (SWA)
+    compressed_kv_cache: torch.Tensor | None, # [num_blocks, comp_bs, 584] uint8 prefix pool
+    comp_indices: torch.Tensor | None,        # [nnz_comp] int32 global slot ids (-1 = invalid)
+    comp_indptr: torch.Tensor | None,         # [N+1] int32 per-token CSR row pointers (prefix)
+    attn_sink: torch.Tensor,                  # [h] FP32
+    out: torch.Tensor,                        # [N, h, 512] BF16
+    *,
+    sm_scale: float,
+    cu_seqlens_q: torch.Tensor | None = None, # [B+1] int32 (request boundaries; not read by kernel)
+) -> None:
+    """Sparse-MLA prefill wrapper (two-source, in-kernel gather, FP8-direct).
+
+    DeepSeek-V4 prefill covers the CSA (compress_ratio == 4) and HCA
+    (compress_ratio == 128) compressed-attention variants as well as
+    pure-SWA layers (compress_ratio == 0). The kernel reads DIRECTLY from
+    the two paged fp8 caches and gathers KV in-kernel — host does NO bf16
+    KV gather and passes NO block_table; the per-token selection arrives as
+    two global-slot CSRs:
+      * SWA    : ``swa_indices`` (flat) + ``swa_indptr`` ([N+1])
+      * prefix : ``comp_indices`` (flat) + ``comp_indptr`` ([N+1])
+    For a SWA-only layer pass ``compressed_kv_cache=None`` (the prefix CSR
+    is then synthesized as all-empty so the kernel masks every prefix tile).
+
+    Q is BF16 in ``[N, h, V_HEAD_DIM]``. The kernel quantizes the NoPE half
+    (BF16 → FP8 e4m3 + e8m0 scale per group=64) internally and reads the
+    RoPE half directly as BF16. The output ``out`` is written in-place as
+    BF16. ``cu_seqlens_q`` is accepted for interface symmetry (request
+    boundaries) but is NOT consumed by the kernel — per-token CSRs already
+    encode each token's selection (causal is host-encoded into the SWA CSR).
+    """
+    # NO `.contiguous()` on input tensors — the kernel must respect their
+    # actual strides (passed below as runtime args).
+    t, h, d = q.shape
+
+    # Require h divisible by M_DIM=16 (no padding). Per-rank head counts
+    # under typical TP shardings already land on multiples of 16.
+    if h % M_DIM != 0:
+        raise AssertionError(
+            f"sparse_mla: heads/rank {h} not divisible by M_DIM {M_DIM} "
+            f"(padding not supported)"
+        )
+    n_head_chunks = h // M_DIM
+    if d != V_HEAD_DIM:
+        raise AssertionError(
+            f"sparse_mla: head_dim {d} != V_HEAD_DIM {V_HEAD_DIM}"
+        )
+    if swa_kv_cache.shape[2] != SLOT_BYTES:
+        raise AssertionError(
+            f"sparse_mla: swa cache slot_bytes "
+            f"{swa_kv_cache.shape[2]} != {SLOT_BYTES}"
+        )
+    # Per-pool block_size from each cache's shape[1] (power of 2). For V4 it
+    # equals `vllm cache_config.block_size // compress_ratio`. The kernel is
+    # JIT-specialized per the observed (swa, comp) pair.
+    swa_block_size = int(swa_kv_cache.shape[1])
+
+    device = q.device
+
+    # SWA-only layer (compress_ratio == 0): no prefix pool. The kernel still
+    # needs a comp cache pointer + a comp CSR; reuse the SWA cache for the
+    # pointer (its bytes are never read because the synthesized comp CSR is
+    # all-empty → every prefix tile masked) and an all-zero indptr.
+    has_prefix = (compressed_kv_cache is not None
+                  and comp_indices is not None
+                  and comp_indptr is not None)
+    if has_prefix:
+        if compressed_kv_cache.shape[2] != SLOT_BYTES:
+            raise AssertionError(
+                f"sparse_mla: compressed cache slot_bytes "
+                f"{compressed_kv_cache.shape[2]} != {SLOT_BYTES}"
+            )
+        comp_cache = compressed_kv_cache
+        comp_block_size = int(compressed_kv_cache.shape[1])
+        comp_indices_eff = comp_indices
+        comp_indptr_eff = comp_indptr
+    else:
+        comp_cache = swa_kv_cache
+        comp_block_size = swa_block_size
+        comp_indices_eff = swa_indices  # never read (all prefix tiles masked)
+        comp_indptr_eff = _get_zero_indptr(t, device)
+
+    # Prefill runs at the tuned N_TILE=64 (decode keeps the module default 32).
+    # Switch the whole N_TILE-derived tile/LDS constant set to 64 for the build
+    # below; restored to 32 in the `finally` after the launch. Both decode and
+    # prefill build serially, so this set->build->restore is safe.
+    _common._configure_tiling(_common.PREFILL_N_TILE)
+
+    # K_SPLITS dispatch — env override > heuristic (see _choose_k_splits).
+    # Pass the (cudagraph-safe, static) head-chunk count, structural prefix
+    # flag, and comp-pool capacity so the heuristic targets the right device
+    # occupancy (2 WG/CU), never splits a SWA-only layer (no prefix range to
+    # split), and never splits a degenerately tiny comp pool.
+    comp_pool_slots = int(comp_cache.shape[0]) * int(comp_cache.shape[1])
+    k_splits = _choose_k_splits(t, n_head_chunks, has_prefix, comp_pool_slots)
+
+    # Split-K (K_SPLITS>1) uses the 2-ahead double-buffer tile loop, which needs
+    # 2 LDS K-buffers; the single-WG (K_SPLITS==1) path keeps 1 (occupancy win).
+    # Re-derive the LDS layout with the right buffer count before the build.
+    if k_splits > 1:
+        _common._configure_tiling(_common.PREFILL_N_TILE, 2)
+
+    # Narrow the COMP tile unroll to the actual comp-pool capacity. The kernel
+    # JIT-unrolls NUM_COMP_TILES (=32, sized for index_topk=1024) prefix tiles,
+    # but a take-all / small-pool layer (e.g. HCA C128 at moderate N) only has
