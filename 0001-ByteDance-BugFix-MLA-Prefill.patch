+            tile_idx = NUM_SWA_TILES + comp_local_t
+            buf_next = (tile_idx + 1) % 2
+            if const_expr(tile_idx < NUM_TILES - 1):
+                _emit_comp_prefetch_guarded(
+                    tile_idx + 1, buf_next,
+                    fx.Int32((comp_local_t + 1) * N_TILE),
+                )
+            _emit_tile_compute_iter(
+                tile_idx,
+                fx.Int32((tile_idx - NUM_SWA_TILES) * N_TILE),
+            )
+    else:
+        for comp_local_t in range_constexpr(COMP_TILES_PER_SPLIT):
+            tile_idx = NUM_SWA_TILES + comp_local_t
+            buf_next = (tile_idx + 1) % 2
+            # Prefetch next within slice (skip last)
+            if const_expr(comp_local_t < COMP_TILES_PER_SPLIT - 1):
+                next_idx_off_runtime = (
+                    k_split_first_kv + fx.Int32((comp_local_t + 1) * N_TILE)
+                )
+                _emit_comp_prefetch_guarded(tile_idx + 1, buf_next,
+                                             next_idx_off_runtime)
