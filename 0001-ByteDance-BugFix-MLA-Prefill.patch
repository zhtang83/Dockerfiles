-# Scheduling hint sweep knobs (read at import; subprocess sweep sets env).
-# Mirror the framework in `block_sparse_attn_fp4.py` (FLYDSL_FP4_SCHED_*):
-# - VLLM_DSV4_SPARSE_MLA_IGLP        : -1 = no rocdl.iglp_opt; 0/1/2 = variant
-# - VLLM_DSV4_SPARSE_MLA_SETPRIO     : -1 = no rocdl.s_setprio; 0..3 = priority
-# - VLLM_DSV4_SPARSE_MLA_SCHED_QK_NOPE : cadence at END of QK NoPE chain
-#                                        (= 14 mfma_fp8 + 7 post-FMA scale)
-# - VLLM_DSV4_SPARSE_MLA_SCHED_QK_ROPE : cadence at END of QK RoPE chain
-#                                        (= 1 mfma_bf16, just before softmax)
-# - VLLM_DSV4_SPARSE_MLA_SCHED_PV_NOPE : cadence at END of PV NoPE chain
-#                                        (= 28 ds_read_tr8 + 28 mfma_bf16,
-#                                         per-warp 7 chunks)
-# - VLLM_DSV4_SPARSE_MLA_SCHED_PV_ROPE : cadence at END of PV RoPE chain
-#                                        (= 4 ds_read_b16 + 4 mfma_bf16,
-#                                         per-warp 1 chunk)
-# Cadence spec syntax: comma-separated `kind:N` tokens. kind ∈
-#   v=vmem_rd, V=vmem_wr, d=dsrd (LDS read), w=dswr (LDS write),
-#   m=mfma, a=valu, s=salu, t=transcendental
-# Each token emits one rocdl.sched_group_barrier(mask, N, 0).
