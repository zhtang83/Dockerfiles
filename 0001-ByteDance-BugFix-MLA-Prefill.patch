+                                                     ir_d.IntegerType.get_signless(1))
+                        scale_pair = _vec_from_elts(
+                            [vsc_chunk[k0], vsc_chunk[k1]], f32_ty)
+                        scaled_pair = arith_d.mulf(v_f32_pairs[kp], scale_pair)
+                        zero_pair = _vec_const(2, 0.0, f32_ty)
+                        masked_pair = arith_d.select(valid_pair, scaled_pair, zero_pair)
+                        bf16_pair = arith_d.truncf(bf16x2_ty, masked_pair)
+                        v_bf16_pairs.append(bf16_pair)
+                    v_bf16_elems = []
+                    for kp in range_constexpr(4):
+                        for k_in_pair in range_constexpr(2):
+                            v_bf16_elems.append(mvec_d.extract(
+                                v_bf16_pairs[kp],
+                                static_position=[k_in_pair],
+                                dynamic_position=[],
+                            ))
+                    v_v8bf16 = _vec_from_elts(v_bf16_elems, bf16_ty)
+                    o_partial = _mfma_bf16(
+                        T.f32x4, _raw(p_v8bf16_halves[h_]), _raw(v_v8bf16),
+                        _raw(o_partial), 0, 0, 0,
+                    )
+                # Yield 4 new acc f32 values (online merge with prior acc_nope[c_local])
+                new_acc_vals = []
+                for i in range_constexpr(4):
+                    scaled_old = arith_d.mulf(_raw(alpha[i]), _raw(acc_nope[c_local][i]))
+                    new_acc_vals.append(arith_d.addf(scaled_old, mvec_d.extract(o_partial, [], [i])))
+                scf_d.YieldOp(new_acc_vals)
+            with ir_d.InsertionPoint(if_chunk.else_block):
+                # Not my chunk — keep prior acc unchanged.
+                scf_d.YieldOp([_raw(acc_nope[c_local][i]) for i in range_constexpr(4)])
+            # Re-bind acc_nope[c_local] to the IfOp's yielded result so
+            # subsequent iterations see the updated value (when matching
+            # warp) or unchanged (when not).
+            for i in range_constexpr(4):
+                acc_nope[c_local][i] = if_chunk.results[i]
+
+        # ============= PV RoPE: 4 V chunks, partitioned 1 per warp =============
+        for c in range_constexpr(NUM_V_ROPE_CHUNKS):
+            c_warp_owner = c // NUM_V_ROPE_CHUNKS_PER_WARP   # Python const 0..3 (1 chunk/warp)
+            c_local = c - c_warp_owner * NUM_V_ROPE_CHUNKS_PER_WARP   # Python const 0
+            is_my_chunk = arith_d.cmpi(
+                arith_d.CmpIPredicate.eq,
+                _raw(warp_id_i32), _raw(fx.Int32(c_warp_owner)),
+            )
+            if_chunk_rope = scf_d.IfOp(is_my_chunk,
+                                        results_=[f32_ty] * 4,
+                                        has_else=True)
+            with ir_d.InsertionPoint(if_chunk_rope.then_block):
+                # N_PV_HALVES passes (32 KV each); half h covers KV h*32+g*8+k.
+                zero_bf16 = _truncf_to_bf16(_raw(fx.Float32(0.0)))
+                o_partial = _vec_const(4, 0.0, f32_ty)
+                for h_ in range_constexpr(N_PV_HALVES):
+                    v_bf16_elems = []
+                    for k in range_constexpr(8):
+                        kv_idx = g_idx * fx.Int32(8) + fx.Int32(h_ * 32 + k)
+                        # RoPE bf16 offset = KV*HEAD_DIM_ROPE + (m_idx + c*16)
+                        v_bf16_off = (
+                            kv_idx * fx.Int32(HEAD_DIM_ROPE)
+                            + m_idx + fx.Int32(c * 16)
+                        )
+                        is_valid_kv = arith_d.cmpi(arith_d.CmpIPredicate.slt,
+                                                    _raw(kv_idx), _raw(fx.Int32(N_TILE)))
+                        safe_off = arith_d.select(is_valid_kv, _raw(v_bf16_off), _raw(fx.Int32(0)))
+                        v_bf16_v1 = _vec_load(v1bf16_ty, cur_lds_krope_bf16, [_to_index(safe_off)])
+                        v_bf16 = mvec_d.extract(v_bf16_v1, [], [0])
+                        v_bf16_masked = arith_d.select(is_valid_kv, v_bf16, zero_bf16)
+                        v_bf16_elems.append(v_bf16_masked)
+                    v_v8bf16 = _vec_from_elts(v_bf16_elems, bf16_ty)
+                    o_partial = _mfma_bf16(
+                        T.f32x4, _raw(p_v8bf16_halves[h_]), _raw(v_v8bf16),
+                        _raw(o_partial), 0, 0, 0,
+                    )
+                new_acc_vals = []
+                for i in range_constexpr(4):
+                    scaled_old = arith_d.mulf(_raw(alpha[i]), _raw(acc_rope[c_local][i]))
+                    new_acc_vals.append(arith_d.addf(scaled_old, mvec_d.extract(o_partial, [], [i])))
+                scf_d.YieldOp(new_acc_vals)
+            with ir_d.InsertionPoint(if_chunk_rope.else_block):
+                scf_d.YieldOp([_raw(acc_rope[c_local][i]) for i in range_constexpr(4)])
+            for i in range_constexpr(4):
+                acc_rope[c_local][i] = if_chunk_rope.results[i]
+
+        # ---- Update m_i ----
+        for i in range_constexpr(4):
+            m_i[i] = m_new[i]
+
+        # Helper returns updated state lists; caller decides yield vs not.
+        return (m_i, l_i, acc_nope, acc_rope)
+
+    def _emit_tile_compute(tile_pyint, buf_cur_py,
+                            m_i_in, l_i_in, acc_nope_in, acc_rope_in,
+                            hs_py=0):
+        # Order-preserving composition of the two phases: emit QK, then
+        # softmax+PV — byte-identical IR to the pre-split monolith. The split
+        # exists so a future software pipeline can emit _emit_qk(tile j+1)
+        # interleaved with _emit_softmax_pv(tile j), letting the QK(j+1) MFMA
+        # fill the MFMA-idle softmax(j) window (prefill's data-wait pain point).
+        _qkd = _emit_qk(tile_pyint, buf_cur_py, hs_py)
+        return _emit_softmax_pv(tile_pyint, buf_cur_py, _qkd,
+                                m_i_in, l_i_in, acc_nope_in, acc_rope_in,
+                                hs_py)
+
+    # ============== Opt-1: bulk slot_id prefetch (once, before prologue) ==============
+    # Cooperatively load the WHOLE token's slot_id list (SWA then COMP, in
+    # pool-offset order) into LDS via coalesced contiguous reads. This pulls
+    # the slot_id HBM latency OUT of every per-tile K-DMA dependent chain.
+    def _bulk_load_slotid(idx_rsrc, batch_off, idx_stride_i32,
+                          n_valid, pad_slots, lds_base_i32):
+        for _b in range_constexpr(pad_slots // NUM_THREADS):
+            _j = fx.Int32(_b * NUM_THREADS) + gtid_i32          # 0..pad_slots-1
+            # Clamp the HBM read index to the valid slot range: padding
+            # lanes (_j >= n_valid) read index 0 instead, so they never
+            # read past this token's CSR slice (would fault on the last
+            # token where batch_off + _j exceeds the indices tensor). The
+            # value written into the padding tail is never read back.
+            _in = arith_d.cmpi(arith_d.CmpIPredicate.slt,
+                               _raw(_j), _raw(fx.Int32(n_valid)))
+            _j_ld = arith_d.select(_in, _raw(_j), _raw(fx.Int32(0)))
+            _addr = arith_d.addi(
+                _raw(batch_off),
+                arith_d.muli(_j_ld, _raw(idx_stride_i32)))
+            _val = buffer_ops.buffer_load(
+                idx_rsrc, _addr, vec_width=1, dtype=T.i32)
+            _vec_store(_vec_from_elts([_val], i32_ty), lds_buf_i32,
+                       [_to_index(_raw(fx.Int32(lds_base_i32) + _j))])
+    _bulk_load_slotid(swa_idx_rsrc, swa_batch_off, swa_idx_stride_i32,
+                      NUM_SWA_TILES * N_TILE, _SLOTID_SWA_PAD,
+                      LDS_OFF_SLOTID_SWA // 4)
+    if const_expr(NUM_COMP_TILES > 0):
+        _bulk_load_slotid(comp_idx_rsrc, comp_batch_off, comp_idx_stride_i32,
+                          NUM_COMP_TILES * N_TILE, _SLOTID_COMP_PAD,
+                          LDS_OFF_SLOTID_COMP // 4)
+    gpu.barrier()
+
+    # Single-buffer per-tile schedule on the single-WG (K_SPLITS==1) path;
+    # Split-K (K_SPLITS>1) uses the 2-buffer prefetch loop below.
+    _single_buf_on = (K_SPLITS == 1)
+
+    # ============== Prologue: load tile 0 into buf 0 ==============
+    # NOTE: gpu.barrier() in flydsl emits `s_waitcnt vmcnt(0) lgkmcnt(0)`
+    # BEFORE `s_barrier`, so an explicit s_waitcnt(0x3F70) prefix is
+    # REDUNDANT. Removed (ISA confirmed via grep).
+    # SINGLE_BUF: no prologue prefetch — the single-buffer loop loads each
+    # tile itself (there is no tile-ahead buffer to preload).
+    if const_expr(not _single_buf_on):
+        _emit_tile_k_load(0, 0)
+        gpu.barrier()
+
+    # s_setprio: production schedule keeps wave priority at 0 (no MFMA-chain
+    # priority bump; the IGLP instruction-group hint is also disabled).
+    rocdl.s_setprio(0)
+
+    # ============== Outer tile loop (2-deep pipelined + early-exit) ==============
+    # Refactored: prefetch decoupled from compute so Split-K (K_SPLITS > 1)
+    # can supply runtime offsets at the SWA→COMP boundary + within COMP slice.
+    #   SWA loop: full per-WG (all K_SPLITS WGs run all 8 SWA tiles).
+    #   COMP loop: per-WG slice of NUM_COMP_TILES // K_SPLITS tiles starting
+    #              at runtime offset = k_split_idx * COMP_TILES_PER_SPLIT.
+    #
+    # Each compute iter:
+    #   1. Compute predicate: tile_first_kv_value < cur_max (runtime).
+    #      cur_max = swa_max for SWA / comp_max for COMP.
+    #   2. scf.IfOp(tile_active) wraps compute; rebinds m_i / l_i / acc_*.
+    #   3. End-of-iter waitcnt + barrier (always) so next iter sees prefetch.
+    #
+    # Production cases with tl=0 (ATOM dump tk0_c128_*) skip all 64 COMP tiles.
+    NUM_CARRIED_1HS = 4 + 4 + NUM_V_NOPE_CHUNKS_PER_WARP * 4 + NUM_V_ROPE_CHUNKS_PER_WARP * 4
+    NUM_CARRIED = NUM_CARRIED_1HS * HG
+
+    def _emit_tile_compute_iter(tile_idx_py, tile_first_kv_value):
+        """Compute body for one tile (no prefetch — caller emits prefetch
+        separately).
+          tile_idx_py: JIT-time int — selects SWA-vs-COMP path + buf parity.
+          tile_first_kv_value: fx.Int32 SSA — the runtime first-KV pos of
+            THIS tile within its pool. For SWA: tile_idx*N_TILE wrapped in
+            fx.Int32. For COMP K=1: (tile_idx-NUM_SWA_TILES)*N_TILE wrapped.
+            For COMP Split-K: k_split_first_kv + comp_local_t*N_TILE (SSA).
+        big-M head-group: processes ALL HG head-slots against this tile's
+        (shared) K LDS buffer, threading HG independent states through one
+        scf.IfOp. Mutates outer m_i_hg / l_i_hg / acc_*_hg lists."""
+        buf_cur = 0 if _single_buf_on else (tile_idx_py % 2)
+
+        if const_expr(tile_idx_py < NUM_SWA_TILES):
+            cur_max_runtime = swa_max
+        else:
+            cur_max_runtime = comp_max
+        _ta_rhs = _raw(cur_max_runtime)
+        tile_active = arith_d.cmpi(
+            arith_d.CmpIPredicate.slt,
+            _raw(tile_first_kv_value),
+            _ta_rhs,
+        )
+
+        # ---- scf.IfOp wraps compute; yield HG*NUM_CARRIED_1HS SSA / branch ----
+        if_tile = scf_d.IfOp(tile_active,
+                              results_=[f32_ty] * NUM_CARRIED,
+                              has_else=True)
+        with ir_d.InsertionPoint(if_tile.then_block):
+            yield_args = []
+            for hs in range_constexpr(HG):
+                new_m, new_l, new_an, new_ar = _emit_tile_compute(
+                    tile_idx_py, buf_cur,
+                    m_i_hg[hs], l_i_hg[hs], acc_nope_hg[hs], acc_rope_hg[hs],
+                    hs_py=hs,
+                )
+                for i in range_constexpr(4):
+                    yield_args.append(_raw(new_m[i]))
+                for i in range_constexpr(4):
+                    yield_args.append(_raw(new_l[i]))
+                for c in range_constexpr(NUM_V_NOPE_CHUNKS_PER_WARP):
+                    for i in range_constexpr(4):
+                        yield_args.append(_raw(new_an[c][i]))
+                for c in range_constexpr(NUM_V_ROPE_CHUNKS_PER_WARP):
+                    for i in range_constexpr(4):
+                        yield_args.append(_raw(new_ar[c][i]))
+            scf_d.YieldOp(yield_args)
+        with ir_d.InsertionPoint(if_tile.else_block):
+            yield_args = []
+            for hs in range_constexpr(HG):
+                for i in range_constexpr(4):
+                    yield_args.append(_raw(m_i_hg[hs][i]))
+                for i in range_constexpr(4):
+                    yield_args.append(_raw(l_i_hg[hs][i]))
+                for c in range_constexpr(NUM_V_NOPE_CHUNKS_PER_WARP):
+                    for i in range_constexpr(4):
+                        yield_args.append(_raw(acc_nope_hg[hs][c][i]))
+                for c in range_constexpr(NUM_V_ROPE_CHUNKS_PER_WARP):
+                    for i in range_constexpr(4):
+                        yield_args.append(_raw(acc_rope_hg[hs][c][i]))
+            scf_d.YieldOp(yield_args)
+
+        # Re-bind Python state lists to if_tile.results.
+        _idx = 0
+        for hs in range_constexpr(HG):
+            for i in range_constexpr(4):
+                m_i_hg[hs][i] = if_tile.results[_idx]
+                _idx += 1
+            for i in range_constexpr(4):
+                l_i_hg[hs][i] = if_tile.results[_idx]
+                _idx += 1
+            for c in range_constexpr(NUM_V_NOPE_CHUNKS_PER_WARP):
+                for i in range_constexpr(4):
+                    acc_nope_hg[hs][c][i] = if_tile.results[_idx]
+                    _idx += 1
+            for c in range_constexpr(NUM_V_ROPE_CHUNKS_PER_WARP):
+                for i in range_constexpr(4):
+                    acc_rope_hg[hs][c][i] = if_tile.results[_idx]
+                    _idx += 1
+
+        # End-of-iter sync: gpu.barrier() emits
+        # `s_waitcnt vmcnt(0) lgkmcnt(0); s_barrier`, draining BOTH the
+        # prefetch DMA + LDS writes before syncing all warps.
+        gpu.barrier()
+
+    # SWA loop: only k_split_idx==0 contributes SWA. Other splits push
+    # tile_first_kv past cur_max so `_emit_tile_compute_iter` early-exits
+    # (m_i/l_i/acc stay at init). Otherwise the reduce's
+    # `sum(l_s * alpha_s)` would over-count SWA by K_SPLITS×.
+    if const_expr(K_SPLITS == 1):
+        swa_kv_runtime_extra = fx.Int32(0)
+    else:
+        _is_k0 = arith_d.cmpi(arith_d.CmpIPredicate.eq,
+                                _raw(k_split_idx), _raw(fx.Int32(0)))
+        swa_kv_runtime_extra = arith_d.select(
+            _is_k0,
+            _raw(fx.Int32(0)),
+            _raw(swa_max),
+        )
+    # Guarded-prefetch helper: when the prefetched tile is a COMP tile
+    # AND its first KV already exceeds this batch's `comp_max`, skip
+    # the load entirely. The double-buffer is safe under skip because the
+    # corresponding compute (`_emit_tile_compute_iter`) gates on the same
+    # `tile_first_kv < comp_max` predicate — stale LDS in buf_next is
+    # never read. This eliminates the wasted HBM bandwidth for the
+    # all-mask-out tiles that dominated WAITCNT/VMEM stalls in ATT
+    # profiling on small-comp_max BS=32 c128a (tl=12; only tile 0
+    # has valid data, tiles 1..63 are all-padding).
+    def _emit_comp_prefetch_guarded(tile_pyint, buf_pyint, first_kv_runtime):
+        _pf_rhs = _raw(comp_max)
+        active = arith_d.cmpi(
+            arith_d.CmpIPredicate.slt,
+            _raw(first_kv_runtime),
+            _pf_rhs,
+        )
+        if_pf = scf_d.IfOp(active)
+        with ir_d.InsertionPoint(if_pf.then_block):
+            _emit_tile_k_load(tile_pyint, buf_pyint,
+                               idx_off_runtime=first_kv_runtime)
+            scf_d.YieldOp([])
+
+    if const_expr(_single_buf_on):
+        # ===== SINGLE_BUF: one K-buffer, no prefetch-ahead (K_SPLITS==1) =====
+        # Per tile: load THIS tile into buf 0 -> barrier (publish DMA) ->
+        # compute (reads buf 0; ends with its own full-drain barrier that also
+        # separates this tile's ds_reads from the next tile's DMA overwrite).
+        # No ILP overlap, but ~21 KB less LDS -> 2x more waves to hide latency.
+        for tile_idx in range_constexpr(NUM_TILES):
+            if const_expr(tile_idx < NUM_SWA_TILES):
+                tfk = fx.Int32(tile_idx * N_TILE)
+                _emit_tile_k_load(tile_idx, 0)
+            else:
+                comp_local = tile_idx - NUM_SWA_TILES
+                tfk = fx.Int32(comp_local * N_TILE)
+                _emit_comp_prefetch_guarded(tile_idx, 0, tfk)
+            gpu.barrier()
+            _emit_tile_compute_iter(tile_idx, tfk)
+        _skip_legacy_loops = True
+    else:
+        _skip_legacy_loops = False
+
+    for tile_idx in (range_constexpr(NUM_SWA_TILES)
+                     if not _skip_legacy_loops else range_constexpr(0)):
