-# ---------------------------------------------------------------------------
-# V4 paged-cache per-slot byte layout (NoPE FP8 + RoPE BF16 + 8B e8m0 scale).
-# True per-block layout (NOT slot-contiguous):
-#   bytes [0                 : block_size * 576] = `block_size` packed
-#                                                   `(NoPE 448 + RoPE 128) = 576`
-#                                                   slot regions
-#   bytes [block_size * 576  : block_size * 584] = `block_size × 8` e8m0
-#                                                   scale bytes (1 row / slot)
-# So slot N's NoPE/RoPE start at `pos * 576`, and its 8 scale bytes at
-# `block_size * 576 + pos * 8`. This matches `_split_quant_k_cache_views`
-# in `vllm/model_executor/layers/deepseek_v4_attention.py`.
-# ---------------------------------------------------------------------------
-NOPE_DTYPE_BYTES = 1     # FP8 e4m3
-ROPE_DTYPE_BYTES = 2     # BF16
-NOPE_OFFSET = 0
-ROPE_OFFSET = HEAD_DIM_NOPE * NOPE_DTYPE_BYTES                  # 448
-NOPE_ROPE_SLOT_BYTES = ROPE_OFFSET + HEAD_DIM_ROPE * ROPE_DTYPE_BYTES  # 576
-SCALE_BYTES_PER_SLOT = 8                                        # 7 valid e8m0 + 1 pad
-SLOT_BYTES = NOPE_ROPE_SLOT_BYTES + SCALE_BYTES_PER_SLOT        # 584 — virtual cache.shape[2]
-
-# Block size is NOT a model-spec constant; it is set by vllm per layer:
-#   storage_block_size = cache_config.block_size // compress_ratio
-# So `quant_swa_cache.shape[1]` and `quant_extra_cache.shape[1]` carry the
-# actual per-pool block_size at runtime; the wrapper passes them to
-# `_make_decode_kernel` and a JIT specialization is built per (swa, comp)
-# pair. No block_size value is hardcoded anywhere in the kernel body.
-
-NEG_INF_INIT = -1.0e30       # init m_i (avoid -inf to prevent NaN in alpha=exp(-inf-x))
-LOG2E = 1.4426950408889634   # log2(e), so exp(x) = exp2(x * LOG2E)
