-def _emit_sched_tail(spec: str) -> int:
-    """Parse 'kind:N,kind:N,...' and emit one sched_group_barrier per token.
-    Returns number of barriers emitted (0 if spec is empty/blank). Empty
-    or unparseable tokens are silently ignored."""
-    if not spec:
-        return 0
-    n = 0
-    for tok in spec.split(","):
-        tok = tok.strip()
-        if not tok:
-            continue
-        kind, _, cnt_s = tok.partition(":")
-        kind = kind.strip()
-        try:
-            cnt = int(cnt_s.strip()) if cnt_s else 1
-        except ValueError:
-            continue
-        if kind not in _SWEEP_SCHED_MASK or cnt <= 0:
-            continue
-        rocdl.sched_group_barrier(_SWEEP_SCHED_MASK[kind], cnt, 0)
-        n += 1
-    return n
