+            )
+            _emit_tile_compute_iter(tile_idx, runtime_first_kv)
+
+    if const_expr(K_SPLITS == 1):
+        # ============== Sink fold (single-WG path) ==============
+        # Sink is a per-head learned scalar with score=sink, V=0 (no contribution).
+        # Numerically-stable form: max(m, sink) → m_final, rescale ALL accumulators
+        # (acc and l) by alpha = exp((m - m_final) * log2e), then add exp(sink - m_final)
+        # into l. Both branches (sink ≤ m and sink > m) are handled uniformly: rescaling
+        # acc by alpha keeps it in the same exponent base as the new sink contribution.
+        # big-M head-group: fold sink + divide + store INDEPENDENTLY for each
+        # head-slot, using that slot's online-softmax state. Output goes to the
