+        # (bigm_head_idx + hs). HG==1 -> single pass == original code.
+        warp_nope_chunk_base_i32 = warp_id_i32 * fx.Int32(NUM_V_NOPE_CHUNKS_PER_WARP)
+        warp_rope_chunk_base_i32 = warp_id_i32 * fx.Int32(NUM_V_ROPE_CHUNKS_PER_WARP)
+        for hs in range_constexpr(HG):
+            m_i = m_i_hg[hs]
+            l_i = l_i_hg[hs]
+            acc_nope = acc_nope_hg[hs]
+            acc_rope = acc_rope_hg[hs]
+            if HG > 1:
+                o_head_off = o_batch_off + fx.Int32(hs) * bigm_o_head_stride_bf16
+            else:
