+"""Shared building blocks for the DeepSeek-V4 sparse-MLA FlyDSL kernels.
+
+This module holds the code that is byte-for-byte identical between the
+decode (`flydsl_sparse_mla_decode.py`) and prefill
+(`flydsl_sparse_mla_prefill.py`) kernels: the Triton split-K reduce
+kernel, the MFMA / vector / butterfly-reduction helpers, every
+model-spec / tile / LDS-layout constant, the scheduling-hint sweep
+knobs, and the V4 paged-cache byte-layout constants.
+
+Both kernels are the SAME per-head MFMA/LDS/online-softmax machinery;
+they differ only in how the per-(token|batch) KV selection is delivered
+(prefill: per-token CSR; decode: fixed-width index buffer + topk_lens)
+and in the grid's x semantics (prefill iterates query tokens, decode
+iterates the decode batch). Everything that does NOT depend on that
+difference lives here and is imported by both via `import *`.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+import flydsl.expr as fx
+from flydsl._mlir.dialects import vector as mvec_d, llvm as llvm_d, arith as arith_d, memref as memref_d, scf as scf_d, math as math_d
+from flydsl._mlir import ir as ir_d
+from flydsl.expr import buffer_ops, const_expr, gpu, range_constexpr, rocdl
+from flydsl.expr.arith import _to_raw as _raw, subf
+from flydsl.expr.typing import T
+from flydsl.expr.gpu import lds_space
+from flydsl.expr.utils.arith import ArithValue
+from flydsl.utils.smem_allocator import SmemAllocator
+from flydsl.compiler.kernel_function import CompilationContext
+from flydsl.runtime.device import get_rocm_arch as get_hip_arch
+from flydsl._mlir.extras import types as MT
+from flydsl._mlir.dialects._rocdl_ops_gen import (
+    mfma_f32_16x16x32_bf16 as _mfma_bf16_op,
+    mfma_f32_16x16x32_fp8_fp8 as _mfma_fp8_op,
+    mfma_scale_f32_16x16x128_f8f6f4 as _mfma_scale_op,
+    mfma_scale_f32_32x32x64_f8f6f4 as _mfma_scale_m32_op,
+)
+
+
+# ---------------------------------------------------------------------------
+# Triton split-K reduce kernel (used when K_SPLITS > 1 to merge per-WG
+# partials into the final BF16 output, with in-kernel sink fold + divide).
+#
+# Two-pass online softmax merge: pass 1 finds m_global across splits;
+# pass 2 rescales each split, accumulates, folds sink, and writes BF16.
+# Single BLOCK_D = next_pow2(D); tl.static_range over K_SPLIT (unrolled).
+# Bit-equivalent up to FP rounding order.
+# ---------------------------------------------------------------------------
+@triton.jit
+def _reduce_kernel(
+    partial_m_ptr,                  # [T, K_SPLIT, H] f32
+    partial_l_ptr,                  # [T, K_SPLIT, H] f32
+    partial_o_ptr,                  # [T, K_SPLIT, H, D] f32
+    sink_ptr,                       # [H] f32
+    out_ptr,                        # [T, H, D] bf16
+    pm_stride_t: tl.constexpr, pm_stride_s: tl.constexpr,
+    po_stride_t: tl.constexpr, po_stride_s: tl.constexpr, po_stride_h: tl.constexpr,
+    out_stride_t: tl.constexpr, out_stride_h: tl.constexpr,
+    H: tl.constexpr, D: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_D: tl.constexpr,           # D slice size (D must be divisible)
+    KV_SPLIT: tl.constexpr,
+    N_HEAD_CHUNKS: tl.constexpr,     # head chunks folded into program_id(0)
+):
+    """One program: 1 q-token × BLOCK_H heads × BLOCK_D D-slice. With
+    BLOCK_D < D, each (t, head_chunk) splits into D/BLOCK_D programs that
+    process disjoint D ranges in parallel. m_global / l_global only depend
+    on (t, head), so they're recomputed per program (cheap).
+
+    ``program_id(0)`` indexes the flattened ``(batch, head_chunk)`` axis with
+    head_chunk as the inner (fast) dim, i.e. ``pid0 = batch * N_HEAD_CHUNKS +
+    head_chunk`` and ``H == M_DIM`` (heads *per chunk*). The partial m/l/o are
+    laid out per chunk so they index by local head ``h_offs`` directly, but
+    ``attn_sink`` is a global ``[total_heads]`` tensor — it MUST be offset by
+    ``head_chunk * H`` or every chunk reads chunk-0's sink (wrong for
+    ``total_heads > M_DIM``)."""
+    t = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    pid_d = tl.program_id(2)
+
+    head_chunk = t % N_HEAD_CHUNKS
+    h_offs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    h_mask = h_offs < H
+    d_offs = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)
+    d_mask = d_offs < D
+    neg_large = -3.4028234663852886e38
+
+    # Pass 1: find m_global across splits.
+    m_global = tl.full((BLOCK_H,), neg_large, dtype=tl.float32)
+    for s in tl.static_range(0, KV_SPLIT):
+        m_s = tl.load(
+            partial_m_ptr + t * pm_stride_t + s * pm_stride_s + h_offs,
+            mask=h_mask, other=neg_large,
+        )
+        m_global = tl.maximum(m_global, m_s)
+
+    # Pass 2: rescale each split, accumulate.
+    l_global = tl.zeros((BLOCK_H,), dtype=tl.float32)
+    acc = tl.zeros((BLOCK_H, BLOCK_D), dtype=tl.float32)
+    for s in tl.static_range(0, KV_SPLIT):
+        m_s = tl.load(
+            partial_m_ptr + t * pm_stride_t + s * pm_stride_s + h_offs,
+            mask=h_mask, other=neg_large,
+        )
+        l_s = tl.load(
+            partial_l_ptr + t * pm_stride_t + s * pm_stride_s + h_offs,
+            mask=h_mask, other=0.0,
+        )
+        o_s = tl.load(
+            partial_o_ptr + t * po_stride_t + s * po_stride_s
+            + h_offs[:, None] * po_stride_h + d_offs[None, :],
+            mask=h_mask[:, None] & d_mask[None, :], other=0.0,
+        )
+        alpha = tl.exp(m_s - m_global)
+        l_global = l_global + l_s * alpha
+        acc = acc + o_s * alpha[:, None]
+
+    # Sink fold. attn_sink is global [total_heads]; offset by this chunk.
+    sink = tl.load(
+        sink_ptr + head_chunk * H + h_offs, mask=h_mask, other=neg_large,
+    ).to(tl.float32)
+    m_final = tl.maximum(m_global, sink)
+    alpha = tl.exp(m_global - m_final)
+    l_final = l_global * alpha + tl.exp(sink - m_final)
+    denom = tl.maximum(l_final, 1.0e-30)
+
+    out_vals = tl.where(
+        l_final[:, None] > 0.0,
+        (acc * alpha[:, None]) / denom[:, None],
+        0.0,
+    )
+    tl.store(
+        out_ptr + t * out_stride_t + h_offs[:, None] * out_stride_h + d_offs[None, :],
+        out_vals.to(tl.bfloat16),
+        mask=h_mask[:, None] & d_mask[None, :],
+    )
+
+
+def flydsl_reduce_inplace(partial_o, partial_m, partial_l, sink, out,
+                          n_head_chunks: int = 1):
+    """In-place reduce. partial_o [T, K_SPLIT, H, D] f32, out [T, H, D] bf16.
+
+    ``T`` is the flattened ``(batch, head_chunk)`` axis (head_chunk inner) and
+    ``H == M_DIM`` is heads *per chunk*. ``sink`` is the global
+    ``[n_head_chunks * H]`` tensor; pass ``n_head_chunks`` so the kernel can
+    offset the sink read by ``head_chunk * H`` (otherwise every chunk reads
+    chunk-0's sink — silently wrong whenever total heads > M_DIM).
+
+    BLOCK_H=8: 2× H-split (grid_y=2 for H=16). Already saturated at H-only.
+    BLOCK_D=128 (D=512 → 4 D-chunks): adds grid_z=4, grid = (T,2,4)=256 WGs
+    (vs 64 before). Each WG reads 1/4 the o-data, ~25% the bandwidth → more
+    CU parallelism. m_global recomputed per d-chunk (cheap, no D dep).
+    Tradeoff: more grid + slight m/l redundant read. Empirically wins on K=16.
+    """
+    T_dim, K_SPLIT, H, D = partial_o.shape
+    assert out.shape == (T_dim, H, D) and out.dtype == torch.bfloat16
+    assert T_dim % n_head_chunks == 0, (
+        f"T_dim={T_dim} must be divisible by n_head_chunks={n_head_chunks}")
+    BLOCK_H = 8
+    BLOCK_D = 128
+    assert D % BLOCK_D == 0, f"D={D} must be divisible by BLOCK_D={BLOCK_D}"
+    grid = (T_dim, (H + BLOCK_H - 1) // BLOCK_H, D // BLOCK_D)
+    _reduce_kernel[grid](
+        partial_m, partial_l, partial_o, sink, out,
+        partial_m.stride(0), partial_m.stride(1),
+        partial_o.stride(0), partial_o.stride(1), partial_o.stride(2),
+        out.stride(0), out.stride(1),
+        H=H, D=D,
+        BLOCK_H=BLOCK_H, BLOCK_D=BLOCK_D, KV_SPLIT=K_SPLIT,
+        N_HEAD_CHUNKS=n_head_chunks,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Local mvec / mfma helpers (flydsl 0.1.2 doesn't expose `flydsl.expr.typing.Vector`
+# nor positional `rocdl.mfma_*` calls).
+# ---------------------------------------------------------------------------
+def _mfma_bf16(rt, a, b, c, cbsz, abid, blgp):
+    """rocdl.mfma_f32_16x16x32_bf16 (bf16 → f32 accumulator)."""
+    return _mfma_bf16_op(res=rt, a=a, b=b, c=c, cbsz=cbsz, abid=abid,
+                          blgp=blgp).result
+
+
+def _mfma_fp8_fp8(rt, a, b, c, cbsz, abid, blgp):
+    """rocdl.mfma_f32_16x16x32_fp8_fp8 (fp8e4m3 → f32 accumulator)."""
+    return _mfma_fp8_op(res=rt, a=a, b=b, c=c, cbsz=cbsz, abid=abid,
+                         blgp=blgp).result
+
+
+def _mfma_scale_m32(c_vec16, a, b, scaleA, scaleB):
+    """rocdl.mfma_scale_f32_32x32x64_f8f6f4 (M=N=32, K=64, e8m0 block scale).
+
+    Accumulator is 16 f32/lane (32*32/64) vs 4 for the 16x16x128 op.
+    `c_vec16` is a vector<16xf32>. K=64 means HEAD_DIM_NOPE=448(+pad to 512)
+    needs 8 K-passes (vs 4 for K=128). Used by the 2tok x 16head bigM probe."""
+    return _mfma_scale_m32_op(
+        res=ir_d.VectorType.get([16], MT.f32()),
+        a=a, b=b, c=_raw(c_vec16),
+        cbsz=0, blgp=0,
+        opselA=0, scaleA=scaleA,
+        opselB=0, scaleB=scaleB,
+    ).result
+
+
+
+def _vec_from_elts(elements, elt_ty):
+    """vector<n × elt_ty> from list of raw scalars."""
+    raw = [_raw(e) for e in elements]
+    return mvec_d.from_elements(ir_d.VectorType.get([len(raw)], elt_ty), raw)
+
+
+def _vec_const(n, value, elt_ty):
+    """vector<n × elt_ty> filled with `value` (int / bool / float)."""
+    if isinstance(value, bool):
+        attr = ir_d.IntegerAttr.get(elt_ty, int(value))
+    elif isinstance(value, int):
+        attr = ir_d.IntegerAttr.get(elt_ty, value)
+    elif isinstance(value, float):
+        attr = ir_d.FloatAttr.get(elt_ty, value)
+    else:
+        raise TypeError(f"_vec_const: unsupported value type {type(value)}")
+    const = arith_d.constant(elt_ty, attr)
+    return mvec_d.broadcast(ir_d.VectorType.get([n], elt_ty), const)
+
+
+def _vec_load(result_ty, memref, indices):
+    """vector.load <result_ty> from memref[indices...]."""
+    return mvec_d.LoadOp(result_ty, _raw(memref),
+                          [_raw(i) for i in indices]).result
+
+
+def _vec_store(vec, memref, indices, alignment=None):
+    """vector.store vec to memref[indices...] (optional alignment attr)."""
+    kw = {} if alignment is None else {"alignment": alignment}
+    mvec_d.store(vec, _raw(memref), [_raw(i) for i in indices], **kw)
+
+
+NUM_THREADS = 256
+NUM_WARPS = 4
+LANES_PER_WARP = 64
+assert NUM_THREADS == NUM_WARPS * LANES_PER_WARP
+# N_TILE = KV positions per tile. Each tile does N_TILE/16 mfma m=16/n=16
+# sub-passes. The per-tile end-of-iter `gpu.barrier()` count is ∝ NUM_TILES,
+# so a larger N_TILE halves the sync count for the same KV budget (the kernel
+# is sync-bound: LDS-wait+VMEM-wait+barrier ≈ 62% of stalls). Must be a multiple
+# of 16 (mfma n=16) and divide both budgets below.
+#
+# Per-kernel split: the module DEFAULT is 32 (the original/decode value — decode
+# shares these constants via `import *` and is byte-identical at 32). The prefill
+# kernel switches the whole N_TILE-derived set to 64 (the tuned sync-halving
+# value validated for prefill) around its build via `_configure_tiling(64)`, and
+# restores 32 after. See `_configure_tiling` below.
+N_TILE = 32
+assert N_TILE % 16 == 0, f"N_TILE={N_TILE} must be a multiple of 16"
+NUM_SUBPASS = N_TILE // 16                     # 16-wide mfma sub-passes per tile (2 at N_TILE=32)
+# Budgets (window / index_topk) are FIXED regardless of N_TILE; the tile counts
+# are derived so SWA_MAX / COMP_MAX stay constant.
+SWA_MAX = 128                                  # SWA window budget (KV per token)
+COMP_MAX = 1024                                # index_topk budget (KV per token)
+assert SWA_MAX % N_TILE == 0 and COMP_MAX % N_TILE == 0
+NUM_SWA_TILES = SWA_MAX // N_TILE              # 4 at N_TILE=32, 2 at N_TILE=64
+NUM_COMP_TILES = COMP_MAX // N_TILE            # 32 at N_TILE=32, 16 at N_TILE=64
+NUM_TILES = NUM_SWA_TILES + NUM_COMP_TILES     # 36 at N_TILE=32 (barrier count ∝ NUM_TILES)
+M_DIM = 16                                     # head chunk size (mfma m=16)
+
+# ---------------------------------------------------------------------------
+# DeepSeek-V4 model-spec constants (per attention head; not user-configurable).
+# ---------------------------------------------------------------------------
+HEAD_DIM_NOPE = 448      # NoPE width (= 7 SCALE_GROUPs of 64)
+HEAD_DIM_ROPE = 64
+V_HEAD_DIM = HEAD_DIM_NOPE + HEAD_DIM_ROPE        # 512 — full single-latent width
+SCALE_GROUP = 64         # 1 e8m0 scale byte per 64 NoPE channels
+NUM_SCALE_GROUPS = HEAD_DIM_NOPE // SCALE_GROUP   # 7
+NUM_NOPE_CHUNKS = HEAD_DIM_NOPE // 32             # 14 mfma_f32_fp8 K=32 chunks
+NUM_F32_PER_GROUP = SCALE_GROUP // 32             # 2 mfma chunks per SCALE_GROUP
+NUM_ROPE_CHUNKS = HEAD_DIM_ROPE // 32             # 2
+# Two-buffer PV: separate acc_nope (28 chunks of 16 d) + acc_rope (4 chunks of 16 d).
+NUM_V_NOPE_CHUNKS = HEAD_DIM_NOPE // 16           # 28 chunks for V NoPE region (fp8 dequant)
+NUM_V_ROPE_CHUNKS = HEAD_DIM_ROPE // 16           # 4 chunks for V RoPE region (bf16 direct)
+# Multi-warp V channel partition: each warp owns
+#   NUM_V_NOPE_CHUNKS_PER_WARP NoPE chunks (= 7 for 28 / 4 warps)
+#   NUM_V_ROPE_CHUNKS_PER_WARP RoPE chunks (= 1 for 4 / 4 warps)
+# Per-warp acc shrinks 4× → big VGPR-pressure reduction.
+NUM_V_NOPE_CHUNKS_PER_WARP = NUM_V_NOPE_CHUNKS // NUM_WARPS   # 7
+NUM_V_ROPE_CHUNKS_PER_WARP = NUM_V_ROPE_CHUNKS // NUM_WARPS   # 1
+assert NUM_V_NOPE_CHUNKS % NUM_WARPS == 0
+assert NUM_V_ROPE_CHUNKS % NUM_WARPS == 0
+PV_K_PADDED = N_TILE   # P LDS row width = KV columns per tile (32 at N_TILE=32)
+
+# ---------------------------------------------------------------------------
+# mfma_scale_f32_16x16x128_f8f6f4 path constants. Per ISA Ch7 (CDNA4 PDF):
+#   - p.51 fp8 data layout: each lane t (M=t%16, k_group=t//16) holds 2x 16-K
+#     chunks (low at K=k_group*16..+15, high at K=64+k_group*16..+15)
+#   - p.56 scale layout: per-lane e8m0 byte, lane t = (M=t%16, K_stripe=t//16)
+#     stripes can hold independent scales
+# V4 SCALE_GROUP=64 maps to 2 sub-groups per mfma K=128, scale-replicated:
+#   K_stripe 0,1 share V4_g_lo (K=0..63); K_stripe 2,3 share V4_g_hi (K=64..127)
+# 4 mfma covers HEAD_DIM_NOPE=448 + 64 zero pad = 512 K total.
+NUM_MFMA_K128 = 4                                # 4 mfma covers HEAD_DIM_NOPE=448 + 64 pad
+NUM_V4_GROUPS_PER_MFMA = 2                       # 1 mfma_K128 = 2 V4 SCALE_GROUP (64-wide)
+NUM_V4_GROUPS_TOTAL = NUM_MFMA_K128 * NUM_V4_GROUPS_PER_MFMA  # 8 (7 valid + 1 pad)
+NUM_CHUNKS_CM_PADDED = NUM_MFMA_K128 * 8         # 32 chunks_cm (each 16-K wide), 28 valid + 4 pad
+assert NUM_V4_GROUPS_TOTAL == NUM_SCALE_GROUPS + 1
+assert NUM_CHUNKS_CM_PADDED == NUM_V_NOPE_CHUNKS + 4
+
+# ---------------------------------------------------------------------------
+# Baked production scheduling configuration.
+#
+# This kernel was tuned via an env-gated knob sweep (see git history); the
+# winning configuration is now hardcoded and the experimental knobs / probe
+# code paths have been removed. The production schedule is:
+#   - waves_per_eu = 2  (occupancy hint on each gpu.func; VGPR=112/lane is
+#     well below the CDNA4 256 spill cliff, so 2 waves/EU doubles the
+#     latency-hiding parallelism per SIMD without spill risk)
+#   - s_setprio(0)      (no MFMA-chain priority bump)
+#   - no rocdl.iglp_opt instruction-group hint
+#   - bulk slot_id LDS prefetch ON (single coalesced CSR read per token,
+#     breaking the per-tile slot_id -> K-DMA pointer chase)
+#   - single K-buffer per-tile schedule for the single-WG (K_SPLITS==1)
+#     path; Split-K (K_SPLITS>1) keeps its own 2-buffer prefetch loop
+#   - N_TILE = 64  (sync-halving tile size; see N_TILE above)
+# ---------------------------------------------------------------------------
+_WAVES_PER_EU = 2
+
+# ---------------------------------------------------------------------------
+# V4 paged-cache per-slot byte layout (NoPE FP8 + RoPE BF16 + 8B e8m0 scale).
+# True per-block layout (NOT slot-contiguous):
+#   bytes [0                 : block_size * 576] = `block_size` packed
+#                                                   `(NoPE 448 + RoPE 128) = 576`
+#                                                   slot regions
+#   bytes [block_size * 576  : block_size * 584] = `block_size × 8` e8m0
+#                                                   scale bytes (1 row / slot)
+# So slot N's NoPE/RoPE start at `pos * 576`, and its 8 scale bytes at
+# `block_size * 576 + pos * 8`. This matches `_split_quant_k_cache_views`
+# in `vllm/model_executor/layers/deepseek_v4_attention.py`.
+# ---------------------------------------------------------------------------
+NOPE_DTYPE_BYTES = 1     # FP8 e4m3
+ROPE_DTYPE_BYTES = 2     # BF16
+NOPE_OFFSET = 0
+ROPE_OFFSET = HEAD_DIM_NOPE * NOPE_DTYPE_BYTES                  # 448
+NOPE_ROPE_SLOT_BYTES = ROPE_OFFSET + HEAD_DIM_ROPE * ROPE_DTYPE_BYTES  # 576
+SCALE_BYTES_PER_SLOT = 8                                        # 7 valid e8m0 + 1 pad
+SLOT_BYTES = NOPE_ROPE_SLOT_BYTES + SCALE_BYTES_PER_SLOT        # 584 — virtual cache.shape[2]
+
+# Block size is NOT a model-spec constant; it is set by vllm per layer:
+#   storage_block_size = cache_config.block_size // compress_ratio
+# So `quant_swa_cache.shape[1]` and `quant_extra_cache.shape[1]` carry the
+# actual per-pool block_size at runtime; the wrapper passes them to
+# `_make_decode_kernel` and a JIT specialization is built per (swa, comp)
+# pair. No block_size value is hardcoded anywhere in the kernel body.
+
+NEG_INF_INIT = -1.0e30       # init m_i (avoid -inf to prevent NaN in alpha=exp(-inf-x))
+LOG2E = 1.4426950408889634   # log2(e), so exp(x) = exp2(x * LOG2E)
+
+
+def _butterfly_max(v):
+    """Max reduction across 16 lanes (each 16-lane group within a wave)."""
+    for sh in range_constexpr(4):
+        v_bits = arith_d.bitcast(ir_d.IntegerType.get_signless(32), _raw(v))
+        peer_bits = ArithValue(v_bits).shuffle_xor(fx.Int32(1 << sh), fx.Int32(64))
+        peer_f32 = arith_d.bitcast(ir_d.F32Type.get(), _raw(peer_bits))
+        v = arith_d.maximumf(_raw(v), peer_f32)
+    return v
+
+
+def _butterfly_sum(s):
+    """Sum reduction across 16 lanes."""
+    for sh in range_constexpr(4):
+        s_bits = arith_d.bitcast(ir_d.IntegerType.get_signless(32), _raw(s))
+        peer_bits = ArithValue(s_bits).shuffle_xor(fx.Int32(1 << sh), fx.Int32(64))
+        peer_f32 = arith_d.bitcast(ir_d.F32Type.get(), _raw(peer_bits))
+        s = arith_d.addf(_raw(s), peer_f32)
+    return s
+
+# LDS allocation. K_nope NoPE region is chunk-major only (LDS_OFF_KNOPE_CM
+# below) — KV-major K_nope dropped, QK reads from CM too. The KN_BYTES /
+# KN_I32 PER LANE constants below are computed standalone (not from a
+# nominal LDS_BYTES_KNOPE) since the CM layout is the only place the
+# K_nope bytes physically live.
+KN_TOTAL_BYTES = N_TILE * HEAD_DIM_NOPE             # 32 * 448 = 14336 (logical)
+LDS_BYTES_KROPE = N_TILE * HEAD_DIM_ROPE * 2      # 32 * 64 * 2 = 4096
+# K_rope DMA chunking (mirrors K_nope DMA): 4 warps × 4 chunks/warp × 256
+# byte/chunk = 4096 byte = full K_rope. Per chunk = 2 KVs × 128 byte. Per
+# DMA call: 32 lanes/kv (lane_in_warp >> 5 selects which of 2 KVs).
+NUM_KR_CHUNKS = LDS_BYTES_KROPE // 256                # = 16 (N=32)
+NUM_KR_CHUNKS_PER_WARP = NUM_KR_CHUNKS // NUM_WARPS   # = 4
+KVS_PER_CHUNK_KR = 2                                  # 256 byte / 128 byte/kv
+# P (softmax-of-QK bf16) is per-warp (each warp computes own QK redundantly);
+# 1024 byte per warp × NUM_WARPS = 4 KB total. Each warp writes its own P
+# region during QK and reads it during PV. PV V channels are partitioned
+# across warps so cross-warp P sharing isn't needed.
+LDS_BYTES_P_PER_WARP = M_DIM * PV_K_PADDED * 2    # 16 * 32 * 2 = 1024
+LDS_BYTES_P = LDS_BYTES_P_PER_WARP * NUM_WARPS     # 4096
+LDS_BYTES_KS = N_TILE * 8                          # 16 KV * 8 byte/KV = 128 (V4 scale row pad to 8)
+# Per-tile is_valid mask: 16 KV × 4-byte i32 (1=valid, 0=invalid). Used to set
+# qk = -inf for invalid KV columns BEFORE softmax max/sum, otherwise the
+# masked-K-data path produces qk = 0 → exp(-m) ≠ 0 → spurious contribution
+# to l. Loader lanes (i % 4 == 0, lane in [0..63]) write LDS[i // 4]; the
+# softmax pass has each lane read LDS[i % 16] (its MFMA-output column).
+LDS_BYTES_VALID = N_TILE * 4                       # 16 × 4 B = 64 B
+
+# LDS K-buffer count for the production (single-WG, K_SPLITS==1) path: one
+# K-buffer per tile (load -> barrier -> compute -> barrier), freeing ~21 KB of
+# LDS vs the legacy double-buffer to lift occupancy 2->4 waves/SIMD. This is the
+# winning config from the scheduling sweep.
+NBUF = 1
+
+
+# QK NoPE backend: 4× mfma_scale_f32_16x16x128_f8f6f4 (K=128 path).
+# The earlier `VLLM_DSV4_SPARSE_MLA_USE_K128=0` opt-out path (14× mfma_f32_16x16x32_fp8
+# + 7× post-FMA) has been removed; the full kernel-with-K=32 source is preserved
+# at `/workspace/dsv4-dev/_archive_flydsl_sparse_mla_decode_with_K32_path.py`.
+
+# In-kernel Q quant LDS regions for the K=128 path:
+#   LDS_QNOPE        — chunk-major fp8 (consumed by mfma_scale K=128)
+#   LDS_QSCALE_BYTE  — per-(m, V4_g) e8m0 byte (consumed as mfma scaleA)
+LDS_BYTES_QNOPE = NUM_V_NOPE_CHUNKS * M_DIM * 16   # 28*16*16=7168 (pad chunks 28..31 no longer stored; mfma#3 hi-half fed zeros)
+LDS_BYTES_QSCALE_BYTE = M_DIM * NUM_V4_GROUPS_TOTAL     # 16 * 8 = 128 byte
+# Chunk-major K_nope for ds_read_tr8_b64 in PV AND mfma_scale_K128 in QK NoPE.
+# Layout:
+#   LDS[chunk * (N_TILE * 16) + kv * 16 + n_in_chunk]
+#                                              chunk ∈ [0, NUM_CHUNKS_CM_PADDED=32),
+#                                              kv ∈ [0, N_TILE),
+#                                              n_in_chunk ∈ [0, 16) = NoPE bytes
+# 32 chunks = 28 valid (HEAD_DIM_NOPE=448) + 4 zero-pad (K=448..511 for mfma
+# K=128 #3). Pad chunks are zero-init'd once per buffer at kernel top.
+# +512 byte trailing pad covers the OOB read by ds_read_tr8 lane groups when
+# they read past the end of the last chunk (only relevant for the last chunk
+# of the tile).
+LDS_BYTES_KNOPE_CM = NUM_V_NOPE_CHUNKS * N_TILE * 16 + 512   # 28*32*16+512=14848 (pad chunks 28..31 dropped; +512 still covers ds_read_tr8 OOB on last valid chunk)
+# ---------------------------------------------------------------------------
+# LDS double-buffer for 2-deep pipeline. K-related regions (KROPE, KS, VALID,
+# KNOPE_CM) are duplicated so tile (t+1)'s prefetch DMA + buffer_loads write
+# to buf 1 while tile t's compute reads buf 0 (or vice versa). Every tile
+# uses buf = tile_idx % 2 (Python const_expr). Eliminates the per-tile
+# "load → waitcnt → barrier → compute" serialization.
+# Per-buffer K bytes = KROPE 2048 + KS 128 + VALID 64 + KNOPE_CM 8704 = 10944
+# 2 buffers × 10944 + P 4096 + QNOPE 8192 + QSCALE_BYTE 128 = 34304 byte total
+# (well within CDNA4 LDS = 160 KB / CU).
+# ---------------------------------------------------------------------------
+LDS_BYTES_K_PER_BUF = LDS_BYTES_KROPE + LDS_BYTES_KS + LDS_BYTES_VALID + LDS_BYTES_KNOPE_CM
+# Within each buffer (relative offsets):
+LDS_REL_KROPE = 0
+LDS_REL_KS = LDS_REL_KROPE + LDS_BYTES_KROPE
+LDS_REL_VALID = LDS_REL_KS + LDS_BYTES_KS
+LDS_REL_KNOPE_CM = LDS_REL_VALID + LDS_BYTES_VALID
+# Absolute LDS offsets:
+LDS_OFF_K_BUF_BASE = 0                                          # buf 0 K starts here
+LDS_OFF_P = NBUF * LDS_BYTES_K_PER_BUF                        # after all K buffers
+LDS_OFF_QNOPE = LDS_OFF_P + LDS_BYTES_P                     # K=128 fp8 chunk-major
+LDS_OFF_QSCALE_BYTE = LDS_OFF_QNOPE + LDS_BYTES_QNOPE       # K=128 e8m0 scale bytes
+LDS_TOTAL = LDS_OFF_QSCALE_BYTE + LDS_BYTES_QSCALE_BYTE
+
+# ---- Opt-1: bulk slot_id prefetch region (appended at end; 0 bytes when off) ----
+# Holds the whole token's slot_id list in pool-offset order: SWA tiles first,
+# then COMP tiles. Each sub-region is padded up to a whole NUM_THREADS block so
+# the cooperative bulk store never spills past its region (no per-lane store
+# guard needed); the trailing padding slots are never read back.
+def _round_up(x, m):
+    return ((x + m - 1) // m) * m
+_SLOTID_SWA_PAD = _round_up(NUM_SWA_TILES * N_TILE, NUM_THREADS)    # 128 -> 256
+_SLOTID_COMP_PAD = _round_up(NUM_COMP_TILES * N_TILE, NUM_THREADS)  # 1024 -> 1024
+LDS_OFF_SLOTID_SWA = LDS_TOTAL
+LDS_OFF_SLOTID_COMP = LDS_OFF_SLOTID_SWA + _SLOTID_SWA_PAD * 4
+LDS_BYTES_SLOTID = (_SLOTID_SWA_PAD + _SLOTID_COMP_PAD) * 4
+LDS_TOTAL = LDS_TOTAL + LDS_BYTES_SLOTID
+
+# ---- big-M only: per-(token-row, union-col) colmask, double-buffered ----
+# One tile's N_TILE 16-bit colmask words (one i32 per union column), duplicated
+# across the 2 pipeline buffers so it travels with the per-tile K prefetch.
+# FIXED 2*N_TILE*4 = 256 byte (independent of NUM_TILES). Reserved
+# unconditionally (negligible vs ~34 KB total; no occupancy change) so the
+# module-level offset is a compile-time constant; non-bigm kernels never
+# touch it. Routing the colmask through LDS (instead of a per-tile VMEM
+# buffer_load in the hot QK path) avoids the compiler hoisting + spilling all
+# 2*NUM_TILES colmask loads under the kernel's high VGPR pressure.
+LDS_OFF_BIGM_CM = LDS_TOTAL
+LDS_TOTAL = LDS_TOTAL + NBUF * N_TILE * 4
+
+
+def _configure_tiling(n_tile, nbuf=1):
+    """Re-derive every N_TILE- and NBUF-dependent tile / LDS-layout constant as
+    a module global, so a kernel can be built at a different N_TILE / K-buffer
+    count than the module default (N_TILE=32, NBUF=1).
+
+    - N_TILE: prefill builds at 64, decode at 32.
+    - NBUF: the single-WG (K_SPLITS==1) path uses 1 K-buffer (the occupancy
+      win); the Split-K (K_SPLITS>1) path uses the 2-ahead double-buffer loop
+      and needs 2. Pass nbuf=2 when building a K_SPLITS>1 kernel.
+
+    Callers do `_configure_tiling(n, nbuf)` before a build and
+    `_configure_tiling(32, 1)` (the decode default) to restore. Keep in sync
+    with the inline definitions above. (Caches/JIT read these at trace time
+    only; builds are serial, so set->build->restore is safe.)"""
+    global NBUF
+    global N_TILE, NUM_SUBPASS, NUM_SWA_TILES, NUM_COMP_TILES, NUM_TILES
+    global PV_K_PADDED, KN_TOTAL_BYTES, LDS_BYTES_KROPE, NUM_KR_CHUNKS
+    global NUM_KR_CHUNKS_PER_WARP, LDS_BYTES_P_PER_WARP, LDS_BYTES_P
+    global LDS_BYTES_KS, LDS_BYTES_VALID, LDS_BYTES_KNOPE_CM, LDS_BYTES_K_PER_BUF
+    global LDS_REL_KROPE, LDS_REL_KS, LDS_REL_VALID, LDS_REL_KNOPE_CM
+    global LDS_OFF_K_BUF_BASE, LDS_OFF_P, LDS_OFF_QNOPE, LDS_OFF_QSCALE_BYTE
+    global LDS_TOTAL, _SLOTID_SWA_PAD, _SLOTID_COMP_PAD
+    global LDS_OFF_SLOTID_SWA, LDS_OFF_SLOTID_COMP, LDS_BYTES_SLOTID, LDS_OFF_BIGM_CM
+    assert n_tile % 16 == 0, f"N_TILE={n_tile} must be a multiple of 16"
+    assert SWA_MAX % n_tile == 0 and COMP_MAX % n_tile == 0
+    assert nbuf in (1, 2), f"NBUF={nbuf} must be 1 (single-WG) or 2 (Split-K)"
+    N_TILE = n_tile
+    NBUF = nbuf
+    NUM_SUBPASS = N_TILE // 16
+    NUM_SWA_TILES = SWA_MAX // N_TILE
+    NUM_COMP_TILES = COMP_MAX // N_TILE
+    NUM_TILES = NUM_SWA_TILES + NUM_COMP_TILES
+    PV_K_PADDED = N_TILE
+    KN_TOTAL_BYTES = N_TILE * HEAD_DIM_NOPE
+    LDS_BYTES_KROPE = N_TILE * HEAD_DIM_ROPE * 2
+    NUM_KR_CHUNKS = LDS_BYTES_KROPE // 256
+    NUM_KR_CHUNKS_PER_WARP = NUM_KR_CHUNKS // NUM_WARPS
+    LDS_BYTES_P_PER_WARP = M_DIM * PV_K_PADDED * 2
+    LDS_BYTES_P = LDS_BYTES_P_PER_WARP * NUM_WARPS
+    LDS_BYTES_KS = N_TILE * 8
+    LDS_BYTES_VALID = N_TILE * 4
+    LDS_BYTES_KNOPE_CM = NUM_V_NOPE_CHUNKS * N_TILE * 16 + 512
+    LDS_BYTES_K_PER_BUF = (LDS_BYTES_KROPE + LDS_BYTES_KS
+                           + LDS_BYTES_VALID + LDS_BYTES_KNOPE_CM)
+    LDS_REL_KROPE = 0
+    LDS_REL_KS = LDS_REL_KROPE + LDS_BYTES_KROPE
+    LDS_REL_VALID = LDS_REL_KS + LDS_BYTES_KS
+    LDS_REL_KNOPE_CM = LDS_REL_VALID + LDS_BYTES_VALID
+    LDS_OFF_K_BUF_BASE = 0
+    LDS_OFF_P = NBUF * LDS_BYTES_K_PER_BUF
+    LDS_OFF_QNOPE = LDS_OFF_P + LDS_BYTES_P
+    LDS_OFF_QSCALE_BYTE = LDS_OFF_QNOPE + LDS_BYTES_QNOPE
+    LDS_TOTAL = LDS_OFF_QSCALE_BYTE + LDS_BYTES_QSCALE_BYTE
+    _SLOTID_SWA_PAD = _round_up(NUM_SWA_TILES * N_TILE, NUM_THREADS)
+    _SLOTID_COMP_PAD = _round_up(NUM_COMP_TILES * N_TILE, NUM_THREADS)
+    LDS_OFF_SLOTID_SWA = LDS_TOTAL
+    LDS_OFF_SLOTID_COMP = LDS_OFF_SLOTID_SWA + _SLOTID_SWA_PAD * 4
+    LDS_BYTES_SLOTID = (_SLOTID_SWA_PAD + _SLOTID_COMP_PAD) * 4
+    LDS_TOTAL = LDS_TOTAL + LDS_BYTES_SLOTID
+    LDS_OFF_BIGM_CM = LDS_TOTAL
+    LDS_TOTAL = LDS_TOTAL + NBUF * N_TILE * 4
+
+
+# Prefill's tuned tile size (decode keeps the module default 32).
+PREFILL_N_TILE = 64
+
+
+def _LDS_OFF_BIGM_CM(buf):
+    return LDS_OFF_BIGM_CM + buf * N_TILE * 4
+
+
+# Per-buffer K-region offsets (Python int helpers).
+def _LDS_OFF_KROPE(buf):    return LDS_OFF_K_BUF_BASE + buf * LDS_BYTES_K_PER_BUF + LDS_REL_KROPE
+def _LDS_OFF_KS(buf):       return LDS_OFF_K_BUF_BASE + buf * LDS_BYTES_K_PER_BUF + LDS_REL_KS
+def _LDS_OFF_VALID(buf):    return LDS_OFF_K_BUF_BASE + buf * LDS_BYTES_K_PER_BUF + LDS_REL_VALID
+def _LDS_OFF_KNOPE_CM(buf): return LDS_OFF_K_BUF_BASE + buf * LDS_BYTES_K_PER_BUF + LDS_REL_KNOPE_CM
+
+
+def _truncf_to_bf16(f32_val):
+    return arith_d.truncf(MT.bf16(), f32_val)
+
+
+def _log2_exact(n: int) -> int:
+    """Integer log2 for a positive power-of-2 ``n``; raises if ``n`` is not."""
+    if n <= 0 or (n & (n - 1)) != 0:
+        raise ValueError(f"block_size must be a positive power of 2, got {n}")
+    return n.bit_length() - 1
+
+
+def emit_kn_qk_pv(
+    *,
+    # Buffer resources (created by the per-kernel caller from its own
+    # pointer params; roles are identical across decode/prefill).
+    q_rsrc,
+    cache_swa_rsrc,
+    cache_comp_rsrc,
+    # Raw cache tensor base ptrs (for i64 per-lane global_load_lds addressing —
+    # large-pool >4GB fix; buffer-resource voffset is only 32-bit).
+    cache_swa_ptr,
+    cache_comp_ptr,
+    swa_idx_rsrc,
+    comp_idx_rsrc,
+    sink_rsrc,
+    o_rsrc,
+    po_rsrc,
+    pm_rsrc,
+    pl_rsrc,
+    # Grid ids (blockIdx.x/y/z) resolved by the caller.
+    block_x_idx,
+    head_chunk_idx,
+    k_split_idx,
+    # Per-(token|batch) base offsets into q / o (caller resolves the
+    # differing outer-stride arg).
+    q_batch_off,
+    o_batch_off,
+    # Per-source flat-index base offset + valid count. Decode derives
+    # these from fixed-width strides + topk_lens; prefill from per-token
+    # CSR indptr. Both feed the SWA/COMP loops identically.
+    swa_batch_off,
+    swa_max,
+    comp_batch_off,
+    comp_max,
+    # Strides (units per the kernel's read dtype).
+    swa_block_stride_b,
+    comp_block_stride_b,
+    sink_stride_f32,
+    q_m_stride_i32,
+    o_m_stride_bf16,
+    swa_idx_stride_i32,
+    comp_idx_stride_i32,
+    partial_o_b_stride_f32,
+    partial_m_b_stride_f32,
+    sm_scale,
+    # JIT-time closure consts (block-size derived + Split-K factors).
+    SWA_BLOCK_LOG2,
+    SWA_BLOCK_MASK,
+    SWA_NOPE_ROPE_REGION,
+    COMP_BLOCK_LOG2,
+    COMP_BLOCK_MASK,
+    COMP_NOPE_ROPE_REGION,
+    K_SPLITS,
+    COMP_TILES_PER_SPLIT,
+    # When True, floor the softmax denominator at 1e-30 before the final
+    # divide (prefill). Decode passes False (legacy behavior).
+    clamp_denom,
+    # ---- big-M GEMM mode (default off; decode/prefill emit identical code) --
+    # When ``bigm`` is True the 16 MFMA M-rows are 16 query TOKENS of ONE head
+    # (grid.y = head) instead of 16 heads of one token. This needs:
+    #   * chunk_offset_m = 0 (M-index is token-in-group; head folded into the
+    #     caller's q/o batch offsets).
+    #   * sink broadcast: every M-row reads sink[bigm_head_idx].
+    #   * a per-(token-row, union-col) mask AND-ed into QK validity, read from
+    #     ``bigm_colmask_rsrc`` (16-bit per union column: bit r set => token r
+    #     in this group selected the slot). Laid out per group as NUM_TILES*32
+    #     entries (swa tiles then comp tiles), stride ``bigm_colmask_grp_i32``.
+    bigm=False,
+    bigm_head_idx=None,
+    bigm_colmask_rsrc=None,
+    bigm_colmask_grp_i32=None,
+    # ---- big-M head-group (route B) ----
+    # ``bigm_hg`` head rows share each loaded K tile. ``bigm_head_idx`` is then
+    # the head BASE of the group (head_group_idx * HG); head-slot hs maps to
+    # head (base + hs). The per-hs q/o offsets advance by these head strides.
+    bigm_hg=1,
+    bigm_q_head_stride_i32=None,
+    bigm_o_head_stride_bf16=None,
+    # ---- clean batched-query (route C; default off) -------------------------
+    # When ``batch_tokens`` (=B) > 1 with ``bigm=False`` the body batches B
+    # query TOKENS as HG independent online-softmax states sharing each loaded
+    # comp-K tile (MLA latent KV is head-agnostic; take-all comp => all B tokens
+    # read the SAME comp slots, so one K-load serves B*16 heads => /B comp load).
+    # Unlike big-M this keeps heads-in-M (chunk_offset_m = head_chunk*M_DIM),
+    # uses the per-M-row=per-head sink, and emits NO colmask (take-all). The
+    # per-hs advance stride params (bigm_q_head_stride_i32 /
+    # bigm_o_head_stride_bf16) are reused as the per-TOKEN q/o strides.
+    batch_tokens=1,
+    # ---- two-pool LSE-merge hook (default off) ------------------------------
+    # When ``emit_lse`` is True (K_SPLITS==1 only) the epilogue does NOT fold the
+    # sink and does NOT renormalize by the sink-augmented denominator. Instead it
+    # writes the pool-local softmax output O = (Σ exp(s-m) V) / l (sink-FREE) to
+    # ``o_rsrc`` AND the natural-log lse = m + ln(l) to ``lse_rsrc`` at
+    # ``lse_batch_off + m_row * lse_m_stride_f32`` (f32 elements; bigM head-group
+    # slot hs adds ``hs * bigm_lse_head_stride_f32``). An external merge
+    # (``two_pool_lse_merge``) then folds the per-head sink and combines the two
+    # pools. m/l are the full per-row online-softmax state (replicated across
+    # warps), so storing once per (hs, m_row) from every warp is a benign race.
+    emit_lse=False,
+    lse_rsrc=None,
+    lse_batch_off=None,
+    lse_m_stride_f32=None,
+    bigm_lse_head_stride_f32=None,
+):
+    """Shared per-(token|batch) QK / online-softmax / PV kernel body.
+
+    This is the SAME machinery for both the decode and prefill sparse-MLA
+    kernels (per-head MFMA QK in FP8+BF16, online-softmax merge, PV MFMA,
+    sink fold, single-WG or Split-K partial write). The two kernels differ
+    ONLY in how the per-source index base/count is delivered (passed in as
+    ``swa_batch_off`` / ``swa_max`` / ``comp_batch_off`` / ``comp_max``)
+    and in the grid's x semantics (query token vs decode batch). Both keep
+    their own ``@flyc.kernel`` signature + index plumbing and then call
+    this to emit the body.
+    """
+    # ---- big-M head-group (route B): HG heads share each loaded K tile ----
+    # Process HG query-head rows per streamed K tile so the KV HBM read (the
+    # cost) is loaded ONCE and reused across all HG heads x 16 tokens of the
+    # group. Needs HG resident Q slots in LDS (appended after the base layout)
+    # + HG online-softmax states. HG==1 reproduces the per-head big-M and
+    # bigm=False the production path with identical LDS layout / IR.
+    if bigm:
+        HG = bigm_hg
+    elif batch_tokens > 1:
+        HG = batch_tokens          # route C: B query tokens share each comp-K tile
+    else:
+        HG = 1
+    QSLOT_BYTES = LDS_BYTES_QNOPE + LDS_BYTES_QSCALE_BYTE  # [QNOPE|QSCALE]
+    EXTRA_Q_BASE = LDS_TOTAL            # extra Q slots appended past base LDS
+    LDS_ALLOC = LDS_TOTAL + (HG - 1) * QSLOT_BYTES
+
+    def _q_nope_i32_base(hs):
+        # i32 base offset of head-slot hs's Q-NoPE region.
+        off_b = (LDS_OFF_QNOPE if hs == 0
+                 else EXTRA_Q_BASE + (hs - 1) * QSLOT_BYTES)
+        return off_b // 4
+
+    def _q_scale_byte_base(hs):
+        # byte base offset of head-slot hs's Q-scale region.
+        return (LDS_OFF_QSCALE_BYTE if hs == 0
+                else EXTRA_Q_BASE + (hs - 1) * QSLOT_BYTES + LDS_BYTES_QNOPE)
+
+    # ---- LDS allocation ----
+    arch = get_hip_arch()
+    lds_allocator = SmemAllocator(None, arch=arch)
+    lds_allocator.ptr = LDS_ALLOC
+    ctx = CompilationContext.get_current()
+    with ir_d.InsertionPoint(ctx.gpu_module_body):
+        lds_allocator.finalize()
+
+    # ---- waves_per_eu attribute (occupancy hint) ----
+    # Set rocdl.waves_per_eu on every gpu.func in this kernel's module.
+    # At VGPR=112/lane (well below the 256 spill cliff) we can host
+    # 2 waves/EU instead of LLVM-default 1 → 2× latency-hiding waves
+    # per SIMD without spill risk. Mirrors block_sparse_attn_fp4.py:
+    # 2407-2412 (`op.attributes["rocdl.waves_per_eu"] = ...`).
+    for _op in ctx.gpu_module_body.operations:
+        if getattr(_op, "OPERATION_NAME", None) == "gpu.func":
+            _op.attributes["rocdl.waves_per_eu"] = (
+                ir_d.IntegerAttr.get(MT.i32(), _WAVES_PER_EU)
+            )
+    lds_buffer_i8 = lds_allocator.get_base()
+    i8_view_ty = MT.memref(LDS_ALLOC, MT.i8(), memory_space=lds_space())
+    zero_off = arith_d.constant(MT.index(), 0)
+    lds_buf = memref_d.view(i8_view_ty, lds_buffer_i8, zero_off, sizes=[])
+    i32_view_ty = MT.memref(LDS_ALLOC // 4, MT.i32(), memory_space=lds_space())
+    lds_buf_i32 = memref_d.view(i32_view_ty, lds_buffer_i8, zero_off, sizes=[])
+    # bf16 view rooted at P region (for P writes/reads)
+    # bf16 views rooted at each K_rope buffer (PV RoPE load via vector.load).
+    # Double-buffer means 2 distinct views.
+    krope_bf16_view_ty = MT.memref(LDS_BYTES_KROPE // 2, MT.bf16(), memory_space=lds_space())
+    # bf16 views rooted at each K_rope buffer (PV RoPE load via vector.load).
+    # Double-buffer means 2 distinct views, indexed by buf_cur_py.
+    lds_krope_bf16_bufs = [
+        memref_d.view(krope_bf16_view_ty, lds_buffer_i8,
+                      arith_d.constant(MT.index(), _LDS_OFF_KROPE(_b)), sizes=[])
+        for _b in range(NBUF)
+    ]
+
+    bf16_view_ty = MT.memref(LDS_BYTES_P // 2, MT.bf16(), memory_space=lds_space())
+    p_off_const = arith_d.constant(MT.index(), LDS_OFF_P)
+    lds_p_bf16 = memref_d.view(bf16_view_ty, lds_buffer_i8, p_off_const, sizes=[])
+
+    tid = gpu.thread_id("x")
+    # Multi-warp (NUM_WARPS=4 × 64 lanes = 256 threads):
+    #   gtid_i32: global block thread id, 0..255 (used for block-wide
+    #             cooperative HBM→LDS loads when needed).
+    #   tid_i32:  warp-local lane id, 0..63 (drives MFMA lane mapping —
+    #             m_idx/g_idx — and matches the pre-multi-warp behavior
+    #             of all per-warp compute).
+    #   warp_id_i32: warp index, 0..3 (used to gate per-warp work and
+    #                index per-warp LDS regions).
+    gtid_i32 = fx.Int32(_raw(tid))
+    tid_i32 = gtid_i32 % fx.Int32(LANES_PER_WARP)
+    warp_id_i32 = gtid_i32 // fx.Int32(LANES_PER_WARP)
+
+    def _to_index(v):
+        return arith_d.index_cast(MT.index(), v)
+
+    # ---- MLIR types (must be created inside kernel body — needs MLIR context) ----
+    i32_ty = ir_d.IntegerType.get_signless(32)
+    f32_ty = MT.f32()
+    bf16_ty = MT.bf16()
+    i64_ty = ir_d.IntegerType.get_signless(64)
+    v1i64_ty = ir_d.VectorType.get([1], i64_ty)
+    v1i32_ty = ir_d.VectorType.get([1], i32_ty)
+    v2i32_ty = ir_d.VectorType.get([2], i32_ty)
+    v4i32_ty = ir_d.VectorType.get([4], i32_ty)
