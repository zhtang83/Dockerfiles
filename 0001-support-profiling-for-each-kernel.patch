new file mode 100644
index 000000000..92d0bb737
--- /dev/null
+++ b/vllm/v1/attention/ops/dsv4_perf_probe.py
@@ -0,0 +1,283 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU-side performance probe for DSv4 hot-path features.
+
+Wraps key call sites (mhc / mla-prefill / mla-decode / mqa-logits / moe / topk)
+with `torch.cuda.Event` start/stop pairs to attribute on-device time to a named
+bucket. Per-process / per-rank accumulator dumps a CSV on shutdown.
+
+Usage::
+
+    from vllm.v1.attention.ops.dsv4_perf_probe import probe, perf_enabled
+
+    if perf_enabled():
+        with probe("mla.decode"):
+            run_decode(...)
+    else:
+        run_decode(...)
+
+Or, if the wrapped call is unconditional and no-op overhead is acceptable
+(roughly 2 cuda event creations + 2 records per call when disabled, but we
+short-circuit to a real no-op via a singleton ``_NULL`` ctx)::
+
+    with probe("mla.decode"):
+        run_decode(...)
+
+Enable via env var ``VLLM_DSV4_PERF_PROBE=1``. Output CSV path can be
+overridden via ``VLLM_DSV4_PERF_PROBE_DIR``; default is ``/tmp``. Files are
+named ``dsv4_perf_<pid>.csv``.
+
+Each row in the CSV has columns: ``bucket,count,sum_ms,min_ms,max_ms``.
+
+A SIGUSR1 handler is also installed so an external driver can request a
+mid-run dump (useful when the engine is left running between client phases):
+``kill -USR1 <worker_pid>``.
+"""
+
+from __future__ import annotations
+
+import atexit
+import csv
+import os
+import signal
+import threading
+from contextlib import contextmanager
+from functools import lru_cache
+from typing import Iterator
+
+import torch
+
+
+@lru_cache(maxsize=1)
+def perf_enabled() -> bool:
+    val = os.environ.get("VLLM_DSV4_PERF_PROBE", "0").strip().lower()
+    return val in ("1", "true", "yes", "on")
+
+
+@lru_cache(maxsize=1)
+def _output_dir() -> str:
+    return os.environ.get("VLLM_DSV4_PERF_PROBE_DIR", "/tmp")
+
+
+@lru_cache(maxsize=1)
+def _config_label() -> str:
+    """Free-form tag the driver sets to distinguish configs in the CSV name."""
+    return os.environ.get("VLLM_DSV4_PERF_PROBE_LABEL", "run")
+
+
+class _Recorder:
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        # bucket -> [count, sum_ms, min_ms, max_ms]
+        self._buckets: dict[str, list[float]] = {}
+        # Pending events to be reaped on next sync (avoid per-call sync).
+        # Each entry: (bucket, start_event, end_event)
+        self._pending: list[tuple[str, torch.cuda.Event, torch.cuda.Event]] = []
+
+    def submit(
+        self,
+        bucket: str,
+        start: torch.cuda.Event,
+        end: torch.cuda.Event,
+    ) -> None:
+        with self._lock:
+            self._pending.append((bucket, start, end))
+            if len(self._pending) > 4096:
+                self._reap_locked()
+
+    def _reap_locked(self) -> None:
+        if not self._pending:
+            return
+        # Force any pending kernels to retire so all events are valid.
+        torch.cuda.synchronize()
+        for bucket, start, end in self._pending:
+            ms = float(start.elapsed_time(end))
+            slot = self._buckets.get(bucket)
+            if slot is None:
+                self._buckets[bucket] = [1.0, ms, ms, ms]
+            else:
+                slot[0] += 1.0
+                slot[1] += ms
+                slot[2] = min(slot[2], ms)
+                slot[3] = max(slot[3], ms)
+        self._pending.clear()
+
+    def reap(self) -> None:
+        with self._lock:
+            self._reap_locked()
+
+    def dump(self, path: str) -> None:
+        with self._lock:
+            self._reap_locked()
+            with open(path, "w", newline="") as f:
+                w = csv.writer(f)
+                w.writerow(["bucket", "count", "sum_ms", "min_ms", "max_ms"])
+                for bucket in sorted(self._buckets):
+                    cnt, total, lo, hi = self._buckets[bucket]
+                    w.writerow(
+                        [bucket, int(cnt), f"{total:.4f}", f"{lo:.4f}", f"{hi:.4f}"]
+                    )
+
+    def reset(self) -> None:
+        with self._lock:
+            self._buckets.clear()
+            self._pending.clear()
+
+
+_RECORDER = _Recorder()
+_DUMP_COUNTER = [0]
+
+
+def _csv_path(suffix: str = "") -> str:
+    base = f"dsv4_perf_{_config_label()}_pid{os.getpid()}"
+    if suffix:
+        base = f"{base}_{suffix}"
+    return os.path.join(_output_dir(), base + ".csv")
+
+
+def dump_now(suffix: str = "") -> str:
+    """Force a dump to the configured CSV path. Returns the path."""
+    if not suffix:
+        _DUMP_COUNTER[0] += 1
+        suffix = f"dump{_DUMP_COUNTER[0]:03d}"
+    path = _csv_path(suffix)
+    _RECORDER.dump(path)
+    return path
+
+
+def reset() -> None:
+    _RECORDER.reset()
+
+
+@contextmanager
+def _probe_real(bucket: str) -> Iterator[None]:
+    if not torch.cuda.is_available():
+        yield
+        return
+    start = torch.cuda.Event(enable_timing=True)
+    end = torch.cuda.Event(enable_timing=True)
+    start.record()
+    try:
+        yield
+    finally:
+        end.record()
+        _RECORDER.submit(bucket, start, end)
+
+
+@contextmanager
+def _probe_noop(bucket: str) -> Iterator[None]:  # noqa: ARG001
+    yield
+
+
+def probe(bucket: str):
+    """Return a context manager that records GPU time to ``bucket``.
+
+    Cheap no-op when ``VLLM_DSV4_PERF_PROBE`` is not set.
+    """
+    if perf_enabled():
+        return _probe_real(bucket)
+    return _probe_noop(bucket)
+
+
+def _get_phase() -> str:
+    """Best-effort prefill/decode discriminator from the active forward
+    context. Returns ``"p"`` for prefill, ``"d"`` for decode, or ``""``
+    when the context is unavailable or the answer is ambiguous (mixed
+    prefill+decode batches default to whichever side has more tokens)."""
+    try:
+        from vllm.forward_context import get_forward_context
+        ctx = get_forward_context()
+    except Exception:
+        return ""
+    am = getattr(ctx, "attn_metadata", None) if ctx is not None else None
+    if am is None:
+        return ""
+    if isinstance(am, dict):
+        for v in am.values():
+            am = v
+            break
+    nd = getattr(am, "num_decode_tokens", 0) or 0
+    np_ = getattr(am, "num_prefill_tokens", 0) or 0
+    if not nd and not np_:
+        np_ = getattr(am, "num_prefills", 0) or 0
+        nd = getattr(am, "num_decodes", 0) or 0
+    if nd > 0 and np_ == 0:
+        return "d"
+    if np_ > 0 and nd == 0:
+        return "p"
+    if nd == 0 and np_ == 0:
+        return ""
+    return "d" if nd > np_ else "p"
+
+
+def probe_pd(bucket: str):
+    """Like ``probe`` but auto-suffixes ``.p`` (prefill) or ``.d`` (decode).
+
+    Falls back to the un-suffixed bucket when the phase cannot be
+    determined (e.g. dummy run or pre-context init).
+    """
+    if not perf_enabled():
+        return _probe_noop(bucket)
+    ph = _get_phase()
+    if ph:
+        return _probe_real(f"{bucket}.{ph}")
+    return _probe_real(bucket)
+
+
+def _shutdown_handler(*_args, **_kwargs) -> None:
+    try:
+        path = dump_now(suffix="final")
+        try:
+            import sys
+            sys.stderr.write(f"[dsv4_perf_probe] dumped to {path}\n")
+            sys.stderr.flush()
+        except Exception:
+            pass
+    except Exception:
+        pass
+
+
+def _sigusr1_handler(*_args, **_kwargs) -> None:
+    """SIGUSR1: dump current accumulator to a numbered CSV (no reset).
+
+    Driver should rename the produced file to embed the phase (length, etc.)
+    immediately after the signal returns.
+    """
+    try:
+        path = dump_now()
+        try:
+            import sys
+            sys.stderr.write(f"[dsv4_perf_probe] SIGUSR1 dumped to {path}\n")
+            sys.stderr.flush()
+        except Exception:
+            pass
+    except Exception:
+        pass
+
+
+def _sigusr2_handler(*_args, **_kwargs) -> None:
+    """SIGUSR2: reset accumulator (drop pending events too)."""
+    try:
+        reset()
+        try:
+            import sys
+            sys.stderr.write("[dsv4_perf_probe] SIGUSR2 reset\n")
+            sys.stderr.flush()
+        except Exception:
+            pass
+    except Exception:
+        pass
+
+
+def _install_handlers_once() -> None:
+    if not perf_enabled():
+        return
+    atexit.register(_shutdown_handler)
+    try:
+        signal.signal(signal.SIGUSR1, _sigusr1_handler)
+        signal.signal(signal.SIGUSR2, _sigusr2_handler)
+    except (ValueError, OSError):
+        pass
+
+
+_install_handlers_once()
