+
+def _strides(t: torch.Tensor) -> tuple[int, int, int]:
+    """Return the (outer, inner, last) element-strides of a 3D tensor."""
+    s = t.stride()
+    assert len(s) == 3, f"expected 3D tensor, got shape {t.shape}"
+    return s[0], s[1], s[2]
+
+
+def atom_sparse_attn_paged_decode_fp8_triton(
+    q: torch.Tensor,                    # [N, H, D_FULL] BF16
+    kv_fp8: torch.Tensor,               # [outer, inner, D_NOPE] FP8
+    kv_rope: torch.Tensor,              # [outer, inner, D_ROPE] BF16
+    kv_scales: torch.Tensor,            # [outer, inner, NUM_TILES] uint8
+    kv_indices: torch.Tensor,
+    kv_indptr: torch.Tensor,
+    attn_sink: torch.Tensor,
+    softmax_scale: float,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Single-source FP8-direct sparse attention. Loads FP8 nope + e8m0
+    scale + BF16 rope from one cache view, dequantizes inside the K
+    prologue, and applies attn-sink softmax finalization. Q is BF16.
+
+    Slot ids in `kv_indices` decode as
+    ``slot = outer_idx * inner_size + inner_idx``.
+    """
+    if not q.is_cuda:
+        raise RuntimeError("atom_sparse_attn_paged_decode_fp8 requires CUDA/HIP")
+    if q.dtype not in (torch.bfloat16, torch.float16):
+        raise RuntimeError(f"expects fp16/bf16 q, got {q.dtype}")
+    if kv_rope.dtype != q.dtype:
+        raise RuntimeError(f"rope dtype mismatch: rope={kv_rope.dtype}, q={q.dtype}")
+
+    T, H, D_FULL = q.shape
+    inner_size = kv_fp8.shape[1]
+    D_NOPE = kv_fp8.shape[-1]
+    D_ROPE = kv_rope.shape[-1]
+    NUM_TILES = kv_scales.shape[-1]
+    TILE_SIZE = D_NOPE // NUM_TILES
+    assert D_NOPE + D_ROPE == D_FULL, (
+        f"D_NOPE+D_ROPE={D_NOPE + D_ROPE} != D_FULL={D_FULL}"
+    )
+    assert NUM_TILES * TILE_SIZE == D_NOPE, "D_NOPE must be NUM_TILES * TILE_SIZE"
+
+    if out is None:
+        out = torch.empty_like(q)
+    kv_indices = kv_indices.to(torch.int32).contiguous()
+    kv_indptr = kv_indptr.to(torch.int32).contiguous()
+
+    block_h = 16
+    block_k = 16
+    block_d_nope = triton.next_power_of_2(D_NOPE)
+    block_d_rope = triton.next_power_of_2(D_ROPE)
+    num_tiles_padded = triton.next_power_of_2(NUM_TILES)
+
+    fp8_so, fp8_si, fp8_sd = _strides(kv_fp8)
+    rope_so, rope_si, rope_sd = _strides(kv_rope)
+    scl_so, scl_si, scl_st = _strides(kv_scales)
+
+    _atom_sparse_attn_paged_decode_fp8_kernel[(T, triton.cdiv(H, block_h))](
+        q,
+        kv_fp8, kv_rope, kv_scales,
+        kv_indices, kv_indptr,
+        attn_sink, out,
+        q.stride(0), q.stride(1), q.stride(2),
+        fp8_so, fp8_si, fp8_sd,
+        rope_so, rope_si, rope_sd,
+        scl_so, scl_si, scl_st,
+        out.stride(0), out.stride(1), out.stride(2),
+        H, D_NOPE, D_ROPE,
+        block_d_nope, block_d_rope,
+        NUM_TILES, num_tiles_padded, TILE_SIZE,
+        inner_size,
+        float(softmax_scale),
+        BLOCK_H=block_h, BLOCK_K=block_k,
+        num_warps=8,
+    )
+    return out
+
+
+def atom_sparse_attn_paged_prefill_fp8_triton(
+    q: torch.Tensor,
+    p_fp8: torch.Tensor, p_rope: torch.Tensor, p_scales: torch.Tensor,
+    p_indices: torch.Tensor, p_indptr: torch.Tensor,
+    e_fp8: torch.Tensor, e_rope: torch.Tensor, e_scales: torch.Tensor,
+    e_indices: torch.Tensor, e_indptr: torch.Tensor,
+    attn_sink: torch.Tensor,
+    softmax_scale: float,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Two-source FP8-direct sparse attention. Prefix and extend each have
+    their own (FP8 nope, BF16 rope, e8m0 scales) triple plus their own
+    `INNER_SIZE` constexpr (so the two pools may live in different cache
+    layouts simultaneously, e.g. SWA with block_size=64 and compressed
+    with block_size=4).
+    """
+    if not q.is_cuda:
+        raise RuntimeError("atom_sparse_attn_paged_prefill_fp8 requires CUDA/HIP")
+
