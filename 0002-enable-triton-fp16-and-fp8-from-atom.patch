+    kv_start = tl.load(kv_indptr_ptr + t)
+    kv_end = tl.load(kv_indptr_ptr + t + 1)
+    kv_len = kv_end - kv_start
+
+    neg_large = -3.4028234663852886e38
+    m_i = tl.full((BLOCK_H,), neg_large, dtype=tl.float32)
+    l_i = tl.zeros((BLOCK_H,), dtype=tl.float32)
+    # Two accumulators so we don't need to materialize a full [BLOCK_K, D_FULL]
+    # K block. Both update by the same alpha each step.
+    acc_nope = tl.zeros((BLOCK_H, BLOCK_D_NOPE), dtype=tl.float32)
+    acc_rope = tl.zeros((BLOCK_H, BLOCK_D_ROPE), dtype=tl.float32)
