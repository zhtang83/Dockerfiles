+            kv_indices_ptr + kv_start + k_pos,
+            mask=in_range,
+            other=-1,
+        )
+        valid = in_range & (slot >= 0)
+        # Clamp invalid slots to 0 BEFORE the divmod / address math: masked
+        # Triton loads still compute the address, so a -1 sentinel would
+        # produce a negative byte offset and trip a HIP illegal-address
+        # fault on AMD even though the load is masked.
+        slot_safe = tl.where(valid, slot, 0)
+        outer_idx = slot_safe // INNER_SIZE
+        inner_idx = slot_safe - outer_idx * INNER_SIZE
+
+        # FP8 nope [BLOCK_K, BLOCK_D_NOPE]; padded d >= D_NOPE → 0.0.
+        kv_fp8 = tl.load(
+            kv_fp8_ptr
+            + outer_idx[:, None] * fp8_stride_outer
+            + inner_idx[:, None] * fp8_stride_inner
+            + d_nope_offs[None, :] * fp8_stride_d,
+            mask=valid[:, None] & d_nope_mask[None, :],
+            other=0.0,
+        )
+
+        # Per-element e8m0 scale: load scale byte for the tile that owns
+        # each d position. L1 dedupes the 64 lanes touching the same byte
+        # so the nominal 64× redundant load is essentially free, and we
+        # avoid an FP8 `tl.reshape` that AMD Triton lowers slowly.
+        scale_byte = tl.load(
+            kv_scales_ptr
+            + outer_idx[:, None] * scl_stride_outer
+            + inner_idx[:, None] * scl_stride_inner
+            + scale_d_offs[None, :] * scl_stride_t,
+            mask=valid[:, None] & d_nope_mask[None, :],
+            other=127,
+        ).to(tl.int32)
