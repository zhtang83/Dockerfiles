+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""ATOM-style sparse attention Triton kernels for DeepSeek V4 MLA.
+
+Ported from `atom/model_ops/v4_kernels/{paged_decode,paged_prefill}.py`
+in the ATOM project, plus FP8-direct variants written specifically for
+vLLM's `fp8_ds_mla` cache layout.
+
+BF16 variants (mirror ATOM's native API):
+
+* `atom_sparse_attn_paged_decode_triton`: single-source online-softmax
+  attention. Reads from ONE flat BF16 KV pool indexed by per-query ragged
+  slot lists (with -1 sentinels). Used for vLLM's prefill chunk path
+  (where SWA + extra are already gathered into one buffer).
+
+* `atom_sparse_attn_paged_prefill_triton`: two-source online-softmax
+  attention. Reads from TWO flat BF16 KV pools with separate per-query
+  ragged slot lists. The two regions share the same online-softmax
+  accumulator; order is irrelevant.
+
+FP8-direct variants (vLLM-only — the FP8 + e8m0 scale layout is
+ROCm/MI300X specific; ATOM upstream stays BF16):
+
+* `atom_sparse_attn_paged_decode_fp8_triton`: single-source FP8.
+  Loads FP8 nope tiles + per-tile e8m0 scales + BF16 rope from a
+  3D-organized cache view, dequantizes inside the K-load prologue,
+  and proceeds with the same online softmax + sink finalization.
+
+* `atom_sparse_attn_paged_prefill_fp8_triton`: two-source FP8 with
+  the same dequant-in-prologue trick on both sources.
+
+The 3D cache view fits both vLLM layouts (`outer, inner, d`):
+
+  * Decode `kv_cache`: outer=num_blocks, inner=block_size; per-block
+    storage is `[bs * 576 nope_rope][bs * 8 scales]` so fp8 slot stride
+    is 576, scales slot stride is 8, block strides are `bs * 584`.
+  * Prefill workspace: outer=ps (chunk slots), inner=M (slot pool);
+    per-slot storage is `[448 fp8 | 128 bf16 rope | 8 scales] = 584`
+    contiguous bytes. Slot stride 584 for fp8/scales, 292 (bf16
+    elements) for rope.
+
+The kernel takes the strides as constexpr params and handles both via
+``slot_id = outer_idx * INNER_SIZE + slot_in_inner``. Caller (the
+`DeepseekV4MLAAttention._atom_sparse_attn_*_fp8` adapters) computes
+the strides directly from the existing `_split_quant_k_cache_views`
+output — no host-side compaction or copy.
+
+All kernels apply per-head softmax-sink finalization (DeepSeek V4
+attn_sink contributes to the denominator only, V_sink == 0).
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _atom_sparse_attn_paged_decode_kernel(
+    q_ptr,                # [N, H, D]
+    unified_kv_ptr,       # [total_pages, D]
+    kv_indices_ptr,       # [total_indices] int32 (-1 sentinel skipped)
+    kv_indptr_ptr,        # [N+1] int32 (true prefix sum)
+    attn_sink_ptr,        # [H]
+    out_ptr,              # [N, H, D]
+    q_stride_t: tl.constexpr,
+    q_stride_h: tl.constexpr,
+    q_stride_d: tl.constexpr,
+    kv_stride_n: tl.constexpr,
+    kv_stride_d: tl.constexpr,
+    out_stride_t: tl.constexpr,
+    out_stride_h: tl.constexpr,
+    out_stride_d: tl.constexpr,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    softmax_scale: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    t = tl.program_id(0)
+    pid_h = tl.program_id(1)
+
+    h_offs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    d_offs = tl.arange(0, BLOCK_D)
+    h_mask = h_offs < H
+    d_mask = d_offs < D
+
+    q = tl.load(
+        q_ptr
+        + t * q_stride_t
+        + h_offs[:, None] * q_stride_h
+        + d_offs[None, :] * q_stride_d,
+        mask=h_mask[:, None] & d_mask[None, :],
+        other=0.0,
+    )
+    kv_start = tl.load(kv_indptr_ptr + t)
+    kv_end = tl.load(kv_indptr_ptr + t + 1)
+    kv_len = kv_end - kv_start
+
+    neg_large = -3.4028234663852886e38
+    m_i = tl.full((BLOCK_H,), neg_large, dtype=tl.float32)
+    l_i = tl.zeros((BLOCK_H,), dtype=tl.float32)
+    acc = tl.zeros((BLOCK_H, BLOCK_D), dtype=tl.float32)
+
+    k_offs = tl.arange(0, BLOCK_K)
+    for k_start in tl.range(0, kv_len, BLOCK_K):
+        k_pos = k_start + k_offs
+        in_range = k_pos < kv_len
+        slot = tl.load(
+            kv_indices_ptr + kv_start + k_pos,
+            mask=in_range,
+            other=-1,
+        )
+        valid = in_range & (slot >= 0)
+
+        kv = tl.load(
+            unified_kv_ptr
+            + slot[:, None] * kv_stride_n
+            + d_offs[None, :] * kv_stride_d,
+            mask=valid[:, None] & d_mask[None, :],
+            other=0.0,
+        )
+
+        scores = tl.dot(q, tl.trans(kv)) * softmax_scale
+        scores = tl.where(h_mask[:, None] & valid[None, :], scores, neg_large)
+
+        m_block = tl.max(scores, axis=1)
+        m_new = tl.maximum(m_i, m_block)
+        alpha = tl.exp(m_i - m_new)
+        p = tl.exp(scores - m_new[:, None])
+        p = tl.where(h_mask[:, None] & valid[None, :], p, 0.0)
+        l_new = l_i * alpha + tl.sum(p, axis=1)
+
+        acc = acc * alpha[:, None] + tl.dot(p.to(kv.dtype), kv)
+        m_i = m_new
+        l_i = l_new
+
+    sink = tl.load(attn_sink_ptr + h_offs, mask=h_mask, other=neg_large).to(tl.float32)
+    m_final = tl.maximum(m_i, sink)
+    alpha = tl.exp(m_i - m_final)
+    l_final = l_i * alpha + tl.exp(sink - m_final)
+
+    denom = tl.maximum(l_final, 1.0e-30)
+    out = tl.where(l_final[:, None] > 0.0, (acc * alpha[:, None]) / denom[:, None], 0.0)
+    tl.store(
+        out_ptr
+        + t * out_stride_t
+        + h_offs[:, None] * out_stride_h
+        + d_offs[None, :] * out_stride_d,
+        out,
+        mask=h_mask[:, None] & d_mask[None, :],
+    )
+
+
+@triton.jit
+def _atom_sparse_attn_paged_prefill_kernel(
+    q_ptr,                  # [N, H, D]
+    unified_kv_ptr,         # [total_pages, D]   region-1 source
+    kv_indices_prefix_ptr,  # [total_prefix_indices] int32
+    kv_indptr_prefix_ptr,   # [N+1] int32
+    kv_ptr,                 # [total_tokens, D]   region-2 source
+    kv_indices_extend_ptr,  # [total_extend_indices] int32
+    kv_indptr_extend_ptr,   # [N+1] int32
+    attn_sink_ptr,          # [H]
+    out_ptr,                # [N, H, D]
+    q_stride_t: tl.constexpr,
+    q_stride_h: tl.constexpr,
+    q_stride_d: tl.constexpr,
+    pkv_stride_n: tl.constexpr,
+    pkv_stride_d: tl.constexpr,
+    ekv_stride_n: tl.constexpr,
+    ekv_stride_d: tl.constexpr,
+    out_stride_t: tl.constexpr,
+    out_stride_h: tl.constexpr,
+    out_stride_d: tl.constexpr,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    softmax_scale: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    t = tl.program_id(0)
+    pid_h = tl.program_id(1)
+
+    h_offs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    d_offs = tl.arange(0, BLOCK_D)
+    h_mask = h_offs < H
+    d_mask = d_offs < D
+
+    q = tl.load(
+        q_ptr
+        + t * q_stride_t
+        + h_offs[:, None] * q_stride_h
+        + d_offs[None, :] * q_stride_d,
+        mask=h_mask[:, None] & d_mask[None, :],
+        other=0.0,
+    )
+
+    neg_large = -3.4028234663852886e38
+    m_i = tl.full((BLOCK_H,), neg_large, dtype=tl.float32)
+    l_i = tl.zeros((BLOCK_H,), dtype=tl.float32)
+    acc = tl.zeros((BLOCK_H, BLOCK_D), dtype=tl.float32)
+
+    k_offs = tl.arange(0, BLOCK_K)
+
+    p_start = tl.load(kv_indptr_prefix_ptr + t)
+    p_end = tl.load(kv_indptr_prefix_ptr + t + 1)
+    p_len = p_end - p_start
+
+    for k_start in tl.range(0, p_len, BLOCK_K):
+        k_pos = k_start + k_offs
+        in_range = k_pos < p_len
+        slot = tl.load(
+            kv_indices_prefix_ptr + p_start + k_pos,
+            mask=in_range,
+            other=-1,
+        )
+        valid = in_range & (slot >= 0)
+
+        kv = tl.load(
+            unified_kv_ptr
+            + slot[:, None] * pkv_stride_n
+            + d_offs[None, :] * pkv_stride_d,
+            mask=valid[:, None] & d_mask[None, :],
+            other=0.0,
+        )
+
+        scores = tl.dot(q, tl.trans(kv)) * softmax_scale
+        scores = tl.where(h_mask[:, None] & valid[None, :], scores, neg_large)
+
+        m_block = tl.max(scores, axis=1)
+        m_new = tl.maximum(m_i, m_block)
+        alpha = tl.exp(m_i - m_new)
+        p = tl.exp(scores - m_new[:, None])
+        p = tl.where(h_mask[:, None] & valid[None, :], p, 0.0)
+        l_new = l_i * alpha + tl.sum(p, axis=1)
+
+        acc = acc * alpha[:, None] + tl.dot(p.to(kv.dtype), kv)
+        m_i = m_new
+        l_i = l_new
+
+    e_start = tl.load(kv_indptr_extend_ptr + t)
+    e_end = tl.load(kv_indptr_extend_ptr + t + 1)
+    e_len = e_end - e_start
+
+    for k_start in tl.range(0, e_len, BLOCK_K):
+        k_pos = k_start + k_offs
+        in_range = k_pos < e_len
+        slot = tl.load(
+            kv_indices_extend_ptr + e_start + k_pos,
+            mask=in_range,
+            other=-1,
+        )
+        valid = in_range & (slot >= 0)
+
+        kv = tl.load(
+            kv_ptr + slot[:, None] * ekv_stride_n + d_offs[None, :] * ekv_stride_d,
+            mask=valid[:, None] & d_mask[None, :],
+            other=0.0,
+        )
+
+        scores = tl.dot(q, tl.trans(kv)) * softmax_scale
+        scores = tl.where(h_mask[:, None] & valid[None, :], scores, neg_large)
+
+        m_block = tl.max(scores, axis=1)
+        m_new = tl.maximum(m_i, m_block)
+        alpha = tl.exp(m_i - m_new)
+        p = tl.exp(scores - m_new[:, None])
+        p = tl.where(h_mask[:, None] & valid[None, :], p, 0.0)
+        l_new = l_i * alpha + tl.sum(p, axis=1)
+
+        acc = acc * alpha[:, None] + tl.dot(p.to(kv.dtype), kv)
+        m_i = m_new
+        l_i = l_new
+
+    sink = tl.load(attn_sink_ptr + h_offs, mask=h_mask, other=neg_large).to(tl.float32)
+    m_final = tl.maximum(m_i, sink)
+    alpha = tl.exp(m_i - m_final)
+    l_final = l_i * alpha + tl.exp(sink - m_final)
+
+    denom = tl.maximum(l_final, 1.0e-30)
+    out = tl.where(l_final[:, None] > 0.0, (acc * alpha[:, None]) / denom[:, None], 0.0)
+    tl.store(
+        out_ptr
+        + t * out_stride_t
+        + h_offs[:, None] * out_stride_h
+        + d_offs[None, :] * out_stride_d,
+        out,
+        mask=h_mask[:, None] & d_mask[None, :],
+    )
+
+
+def atom_sparse_attn_paged_decode_triton(
+    q: torch.Tensor,
+    unified_kv: torch.Tensor,
+    kv_indices: torch.Tensor,
+    kv_indptr: torch.Tensor,
+    attn_sink: torch.Tensor,
+    softmax_scale: float,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Single-source ragged sparse attention with attn-sink finalization.
+
+    Args:
+      q          : [N, H, D] BF16/FP16 — per-token query.
+      unified_kv : [total_pages, D] same dtype as q — flat BF16 KV pool.
+      kv_indices : [total_indices] int32 — flat slot lists; -1 entries are
+                   skipped (sentinel for unused tail).
+      kv_indptr  : [N+1] int32 — true prefix sum of per-query lengths.
+      attn_sink  : [H] FP32 — per-head softmax-denom bias.
+      softmax_scale: scalar float.
+      out        : optional [N, H, D] tensor (same dtype as q) to write into.
+                   When None, a fresh `torch.empty_like(q)` is allocated.
+    """
+    if not q.is_cuda:
+        raise RuntimeError("atom_sparse_attn_paged_decode requires CUDA/HIP tensors")
+    if q.dtype not in (torch.bfloat16, torch.float16):
+        raise RuntimeError(f"expects fp16/bf16 q, got {q.dtype}")
+    if unified_kv.dtype != q.dtype:
+        raise RuntimeError(
+            f"unified_kv dtype mismatch: kv={unified_kv.dtype}, q={q.dtype}"
+        )
+
+    T, H, D = q.shape
+    if out is None:
+        out = torch.empty_like(q)
+    kv_indices = kv_indices.to(torch.int32).contiguous()
+    kv_indptr = kv_indptr.to(torch.int32).contiguous()
+
+    block_h = 16
+    block_d = triton.next_power_of_2(D)
+    block_k = 16 if D >= 256 else 32
+
+    _atom_sparse_attn_paged_decode_kernel[(T, triton.cdiv(H, block_h))](
+        q,
+        unified_kv,
+        kv_indices,
+        kv_indptr,
+        attn_sink,
+        out,
+        q.stride(0),
+        q.stride(1),
+        q.stride(2),
+        unified_kv.stride(0),
+        unified_kv.stride(1),
+        out.stride(0),
+        out.stride(1),
+        out.stride(2),
+        H,
+        D,
+        float(softmax_scale),
+        BLOCK_H=block_h,
+        BLOCK_D=block_d,
+        BLOCK_K=block_k,
+        num_warps=8,
+    )
+    return out
+
+
+def atom_sparse_attn_paged_prefill_triton(
+    q: torch.Tensor,
+    unified_kv: torch.Tensor,
+    kv_indices_prefix: torch.Tensor,
+    kv_indptr_prefix: torch.Tensor,
+    kv: torch.Tensor,
+    kv_indices_extend: torch.Tensor,
+    kv_indptr_extend: torch.Tensor,
+    attn_sink: torch.Tensor,
+    softmax_scale: float,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Two-source ragged sparse attention.
+
+    Same online-softmax + attn-sink as the decode kernel; reads from two
+    independent BF16 KV pools (prefix and extend) in a single launch.
+    """
+    if not q.is_cuda:
+        raise RuntimeError("atom_sparse_attn_paged_prefill requires CUDA/HIP tensors")
+    if q.dtype not in (torch.bfloat16, torch.float16):
+        raise RuntimeError(f"expects fp16/bf16 q, got {q.dtype}")
+    if unified_kv.dtype != q.dtype or kv.dtype != q.dtype:
+        raise RuntimeError(
+            f"dtype mismatch: q={q.dtype}, unified_kv={unified_kv.dtype}, kv={kv.dtype}"
+        )
+    if unified_kv.size(-1) != kv.size(-1):
+        raise RuntimeError(
+            f"head_dim mismatch: unified_kv={unified_kv.size(-1)}, kv={kv.size(-1)}"
+        )
+
+    T, H, D = q.shape
+    if out is None:
+        out = torch.empty_like(q)
+    kv_indices_prefix = kv_indices_prefix.to(torch.int32).contiguous()
+    kv_indptr_prefix = kv_indptr_prefix.to(torch.int32).contiguous()
+    kv_indices_extend = kv_indices_extend.to(torch.int32).contiguous()
+    kv_indptr_extend = kv_indptr_extend.to(torch.int32).contiguous()
+
+    block_h = 16
+    block_d = triton.next_power_of_2(D)
+    block_k = 16 if D >= 256 else 32
+
+    _atom_sparse_attn_paged_prefill_kernel[(T, triton.cdiv(H, block_h))](
+        q,
+        unified_kv,
+        kv_indices_prefix,
+        kv_indptr_prefix,
+        kv,
+        kv_indices_extend,
+        kv_indptr_extend,
+        attn_sink,
+        out,
+        q.stride(0),
+        q.stride(1),
+        q.stride(2),
+        unified_kv.stride(0),
+        unified_kv.stride(1),
+        kv.stride(0),
+        kv.stride(1),
+        out.stride(0),
+        out.stride(1),
+        out.stride(2),
+        H,
+        D,
+        float(softmax_scale),
+        BLOCK_H=block_h,
+        BLOCK_D=block_d,
+        BLOCK_K=block_k,
+        num_warps=8,
+    )
+    return out
+
+
+# ============================================================================
+# FP8-direct kernels (vLLM-only, ROCm/MI300X)
+# ============================================================================
+#
+# Cache layout (per slot):
+#   bytes [0,    D_NOPE)           → FP8 nope     (D_NOPE elements, e.g. 448)
+#   bytes [D_NOPE, D_NOPE+2*D_ROPE) → BF16 rope   (D_ROPE elements, e.g. 64)
+#   bytes [..., +NUM_TILES_PADDED)  → e8m0 scales (NUM_TILES bytes, 1 per
+#                                                   D_NOPE/64 tile)
+#
+# Per-tile dequant: nope_bf16[t,...] = nope_fp8[t,...].to(bf16)
+#                                      * exp2(scale_byte[t] - 127).to(bf16)
+# We use the e8m0 → fp32 bitcast trick (`(byte << 23).bitcast<float>()`)
+# instead of `tl.exp2` to mirror vLLM's `_upcast_e8m0_to_fp32` semantics
+# exactly and to be one shift+reinterpret per element (no transcendental).
+#
+# Cache view passed to the kernel is 3D `(OUTER, INNER, D)` so the same
+# kernel handles both layouts:
+#   * Decode kv_cache: OUTER=num_blocks, INNER=block_size, with per-block
+#     [bs*576 nope_rope][bs*8 scales] storage → fp8 slot stride=576,
+#     scales slot stride=8, block strides=bs*584.
+#   * Prefill workspace `kv_raw`: OUTER=ps, INNER=M, slot-contiguous 584
+#     bytes per slot → fp8/scales slot stride=584, rope slot stride=292.
+# `slot_id = outer_idx * INNER_SIZE + inner_idx`; the kernel does the
+# divmod with INNER_SIZE as constexpr so power-of-two sizes get a free
+# shift+mask.
+
+
+@triton.jit
+def _atom_sparse_attn_paged_decode_fp8_kernel(
+    q_ptr,                      # [N, H, D_FULL] BF16
+    kv_fp8_ptr,                 # [OUTER, INNER, D_NOPE] FP8
+    kv_rope_ptr,                # [OUTER, INNER, D_ROPE] BF16
+    kv_scales_ptr,              # [OUTER, INNER, NUM_TILES] uint8 (e8m0 byte)
+    kv_indices_ptr,             # [total_indices] int32 (slot id, -1 sentinel)
+    kv_indptr_ptr,              # [N+1] int32
+    attn_sink_ptr,              # [H]
+    out_ptr,                    # [N, H, D_FULL] BF16
+    q_stride_t: tl.constexpr,
+    q_stride_h: tl.constexpr,
+    q_stride_d: tl.constexpr,
+    fp8_stride_outer: tl.constexpr,
+    fp8_stride_inner: tl.constexpr,
+    fp8_stride_d: tl.constexpr,
+    rope_stride_outer: tl.constexpr,
+    rope_stride_inner: tl.constexpr,
+    rope_stride_d: tl.constexpr,
+    scl_stride_outer: tl.constexpr,
+    scl_stride_inner: tl.constexpr,
+    scl_stride_t: tl.constexpr,
+    out_stride_t: tl.constexpr,
+    out_stride_h: tl.constexpr,
+    out_stride_d: tl.constexpr,
+    H: tl.constexpr,
+    D_NOPE: tl.constexpr,
+    D_ROPE: tl.constexpr,
+    BLOCK_D_NOPE: tl.constexpr,         # next_pow2(D_NOPE)
+    BLOCK_D_ROPE: tl.constexpr,         # next_pow2(D_ROPE)
+    NUM_TILES: tl.constexpr,
+    NUM_TILES_PADDED: tl.constexpr,     # next_pow2(NUM_TILES)
+    TILE_SIZE: tl.constexpr,
+    INNER_SIZE: tl.constexpr,
+    softmax_scale: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    t = tl.program_id(0)
+    pid_h = tl.program_id(1)
+
+    h_offs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    h_mask = h_offs < H
+    d_nope_offs = tl.arange(0, BLOCK_D_NOPE)
+    d_nope_mask = d_nope_offs < D_NOPE
+    d_rope_offs = tl.arange(0, BLOCK_D_ROPE)
+    d_rope_mask = d_rope_offs < D_ROPE
+
+    # Q is BF16 over the FULL head_dim (D_NOPE + D_ROPE); split into two
+    # tiles aligned to the K side's nope/rope split.
+    q_nope = tl.load(
+        q_ptr + t * q_stride_t
+        + h_offs[:, None] * q_stride_h
+        + d_nope_offs[None, :] * q_stride_d,
+        mask=h_mask[:, None] & d_nope_mask[None, :],
+        other=0.0,
+    )
+    q_rope = tl.load(
+        q_ptr + t * q_stride_t
+        + h_offs[:, None] * q_stride_h
+        + (D_NOPE + d_rope_offs[None, :]) * q_stride_d,
+        mask=h_mask[:, None] & d_rope_mask[None, :],
+        other=0.0,
+    )
