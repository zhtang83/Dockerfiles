+        kv_rope = tl.load(
+            e_rope_ptr
+            + outer_idx[:, None] * e_rope_so
+            + inner_idx[:, None] * e_rope_si
+            + d_rope_offs[None, :] * e_rope_sd,
+            mask=valid[:, None] & d_rope_mask[None, :],
+            other=0.0,
