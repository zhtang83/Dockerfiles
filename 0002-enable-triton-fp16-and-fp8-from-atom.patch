+        # → 2^(byte - 127) ≡ bitcast<float>(byte << 23).
+        scale_fp32 = (scale_byte << 23).to(tl.float32, bitcast=True)
+
+        # Dequant in one shot — straight broadcast multiply, no reshape.
+        kv_nope = kv_fp8.to(tl.bfloat16) * scale_fp32.to(tl.bfloat16)
+
+        # BF16 rope tail (no per-tile scale).
+        kv_rope = tl.load(
+            kv_rope_ptr
+            + outer_idx[:, None] * rope_stride_outer
+            + inner_idx[:, None] * rope_stride_inner
+            + d_rope_offs[None, :] * rope_stride_d,
+            mask=valid[:, None] & d_rope_mask[None, :],
+            other=0.0,
+        )
+
+        # Split-D dot: q_nope · K_nope.T + q_rope · K_rope.T.
+        scores = tl.dot(q_nope, tl.trans(kv_nope))
+        scores += tl.dot(q_rope, tl.trans(kv_rope))
+        scores = scores * softmax_scale
+        scores = tl.where(h_mask[:, None] & valid[None, :], scores, neg_large)
+
+        m_block = tl.max(scores, axis=1)
+        m_new = tl.maximum(m_i, m_block)
+        alpha = tl.exp(m_i - m_new)
+        p = tl.exp(scores - m_new[:, None])
+        p = tl.where(h_mask[:, None] & valid[None, :], p, 0.0)
+        l_new = l_i * alpha + tl.sum(p, axis=1)
+
+        # Two-buffer V accumulation (MLA: V == K, latent dim split into
+        # nope+rope so we keep the sub-buffers separate to avoid copying).
+        p_bf16 = p.to(tl.bfloat16)
+        acc_nope = acc_nope * alpha[:, None] + tl.dot(p_bf16, kv_nope)
+        acc_rope = acc_rope * alpha[:, None] + tl.dot(p_bf16, kv_rope)
+        m_i = m_new
+        l_i = l_new
+
+    sink = tl.load(attn_sink_ptr + h_offs, mask=h_mask, other=neg_large).to(tl.float32)
+    m_final = tl.maximum(m_i, sink)
+    alpha = tl.exp(m_i - m_final)
+    l_final = l_i * alpha + tl.exp(sink - m_final)
+    denom = tl.maximum(l_final, 1.0e-30)
+
+    out_nope = tl.where(
+        l_final[:, None] > 0.0,
+        (acc_nope * alpha[:, None]) / denom[:, None],
+        0.0,
+    )
+    out_rope = tl.where(
+        l_final[:, None] > 0.0,
+        (acc_rope * alpha[:, None]) / denom[:, None],
+        0.0,
+    )
+    tl.store(
+        out_ptr + t * out_stride_t
+        + h_offs[:, None] * out_stride_h
+        + d_nope_offs[None, :] * out_stride_d,
+        out_nope,
+        mask=h_mask[:, None] & d_nope_mask[None, :],
+    )
+    tl.store(
+        out_ptr + t * out_stride_t
+        + h_offs[:, None] * out_stride_h
+        + (D_NOPE + d_rope_offs[None, :]) * out_stride_d,
+        out_rope,
+        mask=h_mask[:, None] & d_rope_mask[None, :],
+    )
+
+
+@triton.jit
+def _atom_sparse_attn_paged_prefill_fp8_kernel(
