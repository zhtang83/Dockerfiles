@@ -1853,6 +1928,315 @@ class DeepseekV4MLAAttention(nn.Module, AttentionLayerBase):
         if aiter_out is not out:
             out.copy_(aiter_out.to(out.dtype))
 
+    def _atom_sparse_attn_decode(
+        self,
+        q: torch.Tensor,                         # [b, h, d] BF16
+        blocked_swa: torch.Tensor,               # [num_swa_blocks, swa_block_size, 1, d] BF16
+        swa_indices: torch.Tensor,               # [b, 1, swa_topk] int32 (-1 padded)
+        blocked_extra: torch.Tensor | None,      # [num_c_blocks, c_block_size, 1, d] BF16 or None
+        topk_indices: torch.Tensor | None,       # [b, 1, c_topk] int32 (-1 padded) or None
+        attn_sink: torch.Tensor,                 # [h] FP32
+        out: torch.Tensor,                       # [b, h, d_v] write target (BF16)
+    ) -> None:
+        """ATOM-style decode path: ragged-paged sparse attention written
+        directly in Triton (`atom_sparse_attn_paged_*_triton`).
+
+        Differences vs the AITER `unified_attention_sparse_mla` path:
+          - Single launch covers SWA + compressed via ATOM's two-source
+            kernel (no externally-merged LSE).
+          - attn_sink is finalized inside the kernel as a third virtual
+            logsumexp term — bit-equivalent to `two_pool_lse_merge`.
+          - Inputs must be already-dequantized BF16 pools; we reuse vLLM's
+            `_dequantize_blocked_k_cache` upstream so the comparison vs
+            `_ref_sparse_attn_decode` / gluon is apples-to-apples.
+        """
+        from vllm.v1.attention.ops.atom_sparse_attn_paged import (
+            atom_sparse_attn_paged_decode_triton,
+            atom_sparse_attn_paged_prefill_triton,
+        )
+
+        b, h, d = q.shape
+
+        # Flatten SWA pool to [num_swa_pages, d].
+        swa_flat = blocked_swa.reshape(-1, d)
+        # `swa_indices` arrives as [b, 1, swa_topk] (-1 padded). The kernel
+        # consumes ragged slot lists with a constant per-row stride; -1
+        # entries are skipped in-kernel. Build a true prefix sum that
+        # walks `swa_topk` slots per row.
+        swa_idx_flat = swa_indices.reshape(b, -1).contiguous()
+        swa_topk = swa_idx_flat.shape[1]
+        kv_indptr_swa = torch.arange(
+            0, b + 1, device=q.device, dtype=torch.int32
+        ) * swa_topk
+
+        if blocked_extra is None:
+            # SWA-only layer: single-source kernel.
+            atom_sparse_attn_paged_decode_triton(
+                q=q,
+                unified_kv=swa_flat,
+                kv_indices=swa_idx_flat.view(-1),
+                kv_indptr=kv_indptr_swa,
+                attn_sink=attn_sink,
+                softmax_scale=self.scale,
+                out=out,
+            )
+            # Match _aiter_sparse_attn_decode: rows whose entire topk is -1
+            # produce 0/0 -> NaN; clamp to 0 to mirror the ref's
+            # lonely_q_mask.
+            torch.nan_to_num_(out, nan=0.0, posinf=0.0, neginf=0.0)
+            return
+
+        # SWA + compressed: two-source kernel covers both pools in a single
+        # launch. ATOM's prefill kernel design was specifically built for
+        # this case (independent prefix + extend pools sharing one online
+        # softmax accumulator).
+        extra_flat = blocked_extra.reshape(-1, d)
+        extra_idx_flat = topk_indices.reshape(b, -1).contiguous()
+        c_topk = extra_idx_flat.shape[1]
+        kv_indptr_c = torch.arange(
+            0, b + 1, device=q.device, dtype=torch.int32
+        ) * c_topk
+
+        atom_sparse_attn_paged_prefill_triton(
+            q=q,
+            unified_kv=swa_flat,
+            kv_indices_prefix=swa_idx_flat.view(-1),
+            kv_indptr_prefix=kv_indptr_swa,
+            kv=extra_flat,
+            kv_indices_extend=extra_idx_flat.view(-1),
+            kv_indptr_extend=kv_indptr_c,
+            attn_sink=attn_sink,
+            softmax_scale=self.scale,
+            out=out,
+        )
+        torch.nan_to_num_(out, nan=0.0, posinf=0.0, neginf=0.0)
+
+    def _atom_sparse_attn_decode_fp8(
+        self,
+        q: torch.Tensor,                         # [b, h, d_full] BF16
+        quant_swa_cache: torch.Tensor,           # raw V4 storage [num_blocks, swa_block_size, head_bytes]
+        swa_indices: torch.Tensor,               # [b, 1, swa_topk] int32 (-1 padded)
+        quant_extra_cache: torch.Tensor | None,  # raw quant cache for compressed pool, or None
+        topk_indices: torch.Tensor | None,       # [b, 1, c_topk] int32 (-1 padded) or None
+        attn_sink: torch.Tensor,                 # [h] FP32
+        out: torch.Tensor,                       # [b, h, d_v] write target (BF16)
+    ) -> None:
+        """ATOM-style decode with FP8-direct cache reads. Eliminates the
+        host-side `_dequantize_blocked_k_cache` pass that the BF16 ATOM
+        adapter pays — the ported kernel ingests the same FP8/BF16/e8m0
+        triple that AITER's `unified_attention_sparse_mla` consumes, so
+        this is the apples-to-apples ATOM-vs-AITER decode comparison.
+        """
+        from vllm.v1.attention.ops.atom_sparse_attn_paged import (
+            atom_sparse_attn_paged_decode_fp8_triton,
+            atom_sparse_attn_paged_prefill_fp8_triton,
+        )
+
+        b, h, _ = q.shape
+
+        # Reuse the existing zero-copy split: returns 3D-with-extra-dim
+        # views; squeeze the size-1 head dim to land on `(outer, inner, d)`
+        # which the FP8 kernel expects.
+        kv_fp8_swa, k_bf16_swa, kv_scales_swa = self._split_quant_k_cache_views(
+            quant_swa_cache
+        )
+        kv_fp8_swa = kv_fp8_swa.squeeze(2)      # [num_blocks, swa_bs, d_nope]
+        k_bf16_swa = k_bf16_swa.squeeze(2)      # [num_blocks, swa_bs, d_rope]
+        # kv_scales is already 3D [num_blocks, swa_bs, num_tiles]
+
+        swa_idx_flat = swa_indices.reshape(b, -1).contiguous()
+        swa_topk = swa_idx_flat.shape[1]
+        kv_indptr_swa = torch.arange(
+            0, b + 1, device=q.device, dtype=torch.int32
+        ) * swa_topk
+
+        if quant_extra_cache is None:
+            # SWA-only layer: single-source FP8 kernel.
+            atom_sparse_attn_paged_decode_fp8_triton(
+                q=q,
+                kv_fp8=kv_fp8_swa,
+                kv_rope=k_bf16_swa,
+                kv_scales=kv_scales_swa,
+                kv_indices=swa_idx_flat.view(-1),
+                kv_indptr=kv_indptr_swa,
+                attn_sink=attn_sink,
+                softmax_scale=self.scale,
+                out=out,
+            )
+            torch.nan_to_num_(out, nan=0.0, posinf=0.0, neginf=0.0)
+            return
+
+        # SWA + compressed: two-source FP8 kernel covers both pools in one
+        # launch (no externally-merged LSE — sink fused inside).
+        kv_fp8_c, k_bf16_c, kv_scales_c = self._split_quant_k_cache_views(
+            quant_extra_cache
+        )
+        kv_fp8_c = kv_fp8_c.squeeze(2)
+        k_bf16_c = k_bf16_c.squeeze(2)
+
+        extra_idx_flat = topk_indices.reshape(b, -1).contiguous()
+        c_topk = extra_idx_flat.shape[1]
+        kv_indptr_c = torch.arange(
+            0, b + 1, device=q.device, dtype=torch.int32
+        ) * c_topk
+
+        atom_sparse_attn_paged_prefill_fp8_triton(
+            q=q,
+            p_fp8=kv_fp8_swa,
+            p_rope=k_bf16_swa,
+            p_scales=kv_scales_swa,
+            p_indices=swa_idx_flat.view(-1),
+            p_indptr=kv_indptr_swa,
+            e_fp8=kv_fp8_c,
+            e_rope=k_bf16_c,
+            e_scales=kv_scales_c,
+            e_indices=extra_idx_flat.view(-1),
+            e_indptr=kv_indptr_c,
+            attn_sink=attn_sink,
+            softmax_scale=self.scale,
+            out=out,
+        )
+        torch.nan_to_num_(out, nan=0.0, posinf=0.0, neginf=0.0)
+
+    def _atom_sparse_attn_prefill_chunk_fp8(
+        self,
+        q: torch.Tensor,                # [chunk_q_tokens, h, d_full] BF16
+        kv_raw: torch.Tensor,           # [PREFILL_CHUNK_SIZE, M, slot_bytes] uint8 raw workspace
+        chunk_size: int,
+        combined_indices: torch.Tensor, # [chunk_q_tokens, combined_topk] int32 (-1 padded)
+        out: torch.Tensor,              # [chunk_q_tokens, h, d_full] write target
+    ) -> None:
+        """ATOM-style prefill with FP8-direct workspace reads. Same FP8 raw
+        gather (`gather_raw_k_cache`) as AITER's prefill, then the ATOM
+        single-source FP8 kernel consumes the workspace directly.
+        """
+        from vllm.v1.attention.ops.atom_sparse_attn_paged import (
+            atom_sparse_attn_paged_decode_fp8_triton,
+        )
+
+        d_nope = self.nope_head_dim
+        d_rope = self.rope_head_dim
+        bf16_bytes = 2 * d_rope
+        slot_bytes = d_nope + bf16_bytes + 8
+
+        ps, M, sb = kv_raw.shape
+        assert sb == slot_bytes, f"raw workspace slot bytes={sb}, expected {slot_bytes}"
+
+        # Build the same FP8/rope/scales triple over the FP8 workspace as
+        # the AITER prefill path uses (slot stride = 584 bytes). Caller's
+        # combined_indices values are flat slot ids in [0, ps*M).
+        #
+        # IMPORTANT: regroup [ps, M, ...] into [ps*M/bs, bs, ...] with
+        # ``bs = 64`` so the kernel's ``INNER_SIZE`` constexpr is a power
+        # of two -- otherwise the per-iteration ``slot // INNER_SIZE`` /
+        # ``slot %  INNER_SIZE`` address decode pegs each lane on a slow
+        # software integer divide (M ~= N + window + max_num_batched is
+        # rarely power-of-two and dwarfs prefill latency on ROCm Triton).
+        # ``M`` is already 64-aligned upstream (AITER prefill asserts it).
+        bs = 64
+        assert (ps * M) % bs == 0, (
+            f"flat workspace slot count {ps * M} must be divisible by {bs}"
+        )
+        num_blocks = (ps * M) // bs
+
+        # Mirror AITER's prefill view -- reblock the contiguous [ps, M,
+        # slot_bytes] workspace into [num_blocks, bs, slot_bytes] via
+        # zero-copy ``.view`` (avoids any reshape-driven copies on the
+        # rope/scales sub-tensors).
+        kv_flat = kv_raw.view(ps * M, slot_bytes)
+        kv_paged_bytes = kv_flat.view(num_blocks, bs, slot_bytes)
+
+        kv_fp8 = (
+            kv_paged_bytes[..., :d_nope].view(current_platform.fp8_dtype())
+        )
+        kv_rope = (
+            kv_paged_bytes[..., d_nope:d_nope + bf16_bytes]
+            .reshape(num_blocks, bs, bf16_bytes)
+            .view(torch.bfloat16)
+        )
+        kv_scales = kv_paged_bytes[..., d_nope + bf16_bytes:][:, :, : d_nope // 64]
+
+        T = q.shape[0]
+        idx_flat = combined_indices.to(torch.int32).contiguous()
+        # The dense indptr stride is the per-token slot count produced by
+        # `combine_topk_swa_indices` (= topk + window padded to alignment),
+        # NOT the workspace inner dim `M`. `combined_indices` is shaped
+        # ``[T, combined_topk]`` with -1 sentinels in the per-token tail;
+        # using `M` here would read kv_indices past its end and trip a
+        # hipErrorIllegalAddress.
+        idx_stride = idx_flat.shape[1]
+        kv_indptr = torch.arange(
+            0, T + 1, device=q.device, dtype=torch.int32
+        ) * idx_stride
+
+        atom_sparse_attn_paged_decode_fp8_triton(
+            q=q,
+            kv_fp8=kv_fp8,
+            kv_rope=kv_rope,
+            kv_scales=kv_scales,
+            kv_indices=idx_flat.view(-1),
+            kv_indptr=kv_indptr,
+            attn_sink=self.attn_sink[: q.shape[1]],
+            softmax_scale=self.scale,
+            out=out,
+        )
+        torch.nan_to_num_(out, nan=0.0, posinf=0.0, neginf=0.0)
+        # `chunk_size` is intentionally unused (kv_raw view encompasses the
+        # whole workspace; combined_indices' slot ids stay within the
+        # active region).
+        del chunk_size
+
+    def _atom_sparse_attn_prefill_chunk(
+        self,
+        q: torch.Tensor,                # [chunk_q_tokens, h, d] BF16
+        kv: torch.Tensor,               # [chunk_size, M, d] BF16 (already gathered)
+        combined_indices: torch.Tensor, # [chunk_q_tokens, M] int32 (-1 padded)
+        combined_lens: torch.Tensor,    # [chunk_q_tokens] int32 (true valid prefix)
+        out: torch.Tensor,              # [chunk_q_tokens, h, d] write target
+    ) -> None:
+        """ATOM-style prefill path: single-source ragged sparse attention.
+
+        vLLM has already gathered SWA + compressed into one flat BF16 buffer
+        (`kv`), so we use ATOM's single-source (decode) kernel here. The
+        kernel walks `combined_lens[t]` real slots per query token; the
+        rest of the dense `M` strip up to `BLOCK_K` granularity is masked.
+        """
+        from vllm.v1.attention.ops.atom_sparse_attn_paged import (
+            atom_sparse_attn_paged_decode_triton,
+        )
+
+        T = q.shape[0]
+        # `kv` is [chunk_size, M, d]; flatten to [chunk_size * M, d].
+        kv_flat = kv.reshape(-1, kv.shape[-1])
+
+        # `combined_indices` values are absolute slot ids in the
+        # `[chunk_size * M]` flat pool (built upstream by
+        # `combine_topk_swa_indices`). Use a constant-stride indptr
+        # (`arange(T+1) * M`) so the kernel walks the dense [T, M] tile
+        # row by row, skipping -1 sentinels in the per-token tail. This
+        # keeps shapes static (CUDAGraph-friendly).
+        idx_flat = combined_indices.to(torch.int32).contiguous()
+        M = idx_flat.shape[1]
+        kv_indptr = torch.arange(
+            0, T + 1, device=q.device, dtype=torch.int32
+        ) * M
+
+        atom_sparse_attn_paged_decode_triton(
+            q=q,
+            unified_kv=kv_flat,
+            kv_indices=idx_flat.view(-1),
+            kv_indptr=kv_indptr,
+            attn_sink=self.attn_sink[: q.shape[1]],
+            softmax_scale=self.scale,
+            out=out,
+        )
+        torch.nan_to_num_(out, nan=0.0, posinf=0.0, neginf=0.0)
+        # `combined_lens` is intentionally unused: -1 sentinels in the
