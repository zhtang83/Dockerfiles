+    p_idx_ptr, p_indptr_ptr,
+    # ---- region 2 (extend): same triple ----
+    e_fp8_ptr, e_rope_ptr, e_scl_ptr,
+    e_idx_ptr, e_indptr_ptr,
+    attn_sink_ptr,
+    out_ptr,
+    q_stride_t: tl.constexpr,
+    q_stride_h: tl.constexpr,
+    q_stride_d: tl.constexpr,
+    p_fp8_so: tl.constexpr,  p_fp8_si: tl.constexpr,  p_fp8_sd: tl.constexpr,
+    p_rope_so: tl.constexpr, p_rope_si: tl.constexpr, p_rope_sd: tl.constexpr,
+    p_scl_so: tl.constexpr,  p_scl_si: tl.constexpr,  p_scl_st: tl.constexpr,
+    e_fp8_so: tl.constexpr,  e_fp8_si: tl.constexpr,  e_fp8_sd: tl.constexpr,
+    e_rope_so: tl.constexpr, e_rope_si: tl.constexpr, e_rope_sd: tl.constexpr,
+    e_scl_so: tl.constexpr,  e_scl_si: tl.constexpr,  e_scl_st: tl.constexpr,
+    out_stride_t: tl.constexpr,
+    out_stride_h: tl.constexpr,
+    out_stride_d: tl.constexpr,
