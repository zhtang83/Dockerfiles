+    # `d // TILE_SIZE`. d_offs over the padded range up to BLOCK_D_NOPE may
+    # exceed NUM_TILES; the corresponding fp8 lanes are masked anyway.
+    scale_d_offs = d_nope_offs // TILE_SIZE
