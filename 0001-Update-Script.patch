 export AMDGCN_USE_BUFFER_OPS=0
 export VLLM_DSV4_NUMERIC_CAP=65536
 export VLLM_DSV4_AITER_SWIGLU_LIMIT=10.0
@@ -78,8 +79,18 @@ export VLLM_DSV4_USE_AITER_TRITON_MLA_PREFILL=0
 export VLLM_DSV4_USE_AITER_TRITON_MLA_DECODE=0
 export VLLM_DSV4_USE_ATOM_TRITON_PREFILL_FP8=0
