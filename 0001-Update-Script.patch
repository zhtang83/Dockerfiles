 export HIP_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
@@ -114,6 +125,7 @@ vllm serve ${MODEL} \
     --tokenizer-mode "deepseek_v4" \
     --seed 0 \
     -cc.pass_config.fuse_norm_quant=True \
+    --speculative-config "{\"method\":\"deepseek_mtp\",\"num_speculative_tokens\":1}" \
