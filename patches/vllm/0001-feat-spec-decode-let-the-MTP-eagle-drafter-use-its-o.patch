From 305b78a5bd346c0695b71dfcd5fb22ba08d7a303 Mon Sep 17 00:00:00 2001
From: Lyu Xudong <xudong.lyu@amd.com>
Date: Sun, 28 Jun 2026 09:26:53 +0000
Subject: [PATCH 1/2] feat(spec-decode): let the MTP/eagle drafter use its own
 FULL decode cudagraph

The drafter was hard-limited to PIECEWISE cudagraphs: initialize_cudagraph_keys
only ever created PIECEWISE keys and the capture loop skipped the drafter on
FULL-decode capture passes. But a draft step is a uniform single-token
(query_len=1) decode -- exactly what a FULL decode cudagraph captures -- and the
drafter already owns a separate CudagraphDispatcher, so it can have its own FULL
graph independent of the target model.

- initialize_cudagraph_keys: when the parent decode_mode is FULL, give the
  drafter FULL keys too (uniform_decode_query_len=1), keeping PIECEWISE for
  mixed batches.
- _determine_batch_execution_and_padding: dispatch with uniform_decode=True so
  the uniform FULL keys can be selected.
- gpu_model_runner: allow the drafter to be captured on FULL-decode passes.

Dispatch returns FULL only for exact captured sizes, so there is no padded-
metadata mismatch; non-matching batches fall back to PIECEWISE/eager.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 vllm/v1/spec_decode/llm_base_proposer.py | 14 ++++++++++++--
 vllm/v1/worker/gpu_model_runner.py       |  3 ++-
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/vllm/v1/spec_decode/llm_base_proposer.py b/vllm/v1/spec_decode/llm_base_proposer.py
index 9979a0517..8322afb7f 100644
--- a/vllm/v1/spec_decode/llm_base_proposer.py
+++ b/vllm/v1/spec_decode/llm_base_proposer.py
@@ -388,11 +388,20 @@ class SpecDecodeBaseProposer:
             and cudagraph_mode.mixed_mode()
             in [CUDAGraphMode.PIECEWISE, CUDAGraphMode.FULL]
         ):
-            eagle_cudagraph_mode = CUDAGraphMode.PIECEWISE
+            # Draft runs its own (separate-from-main) cudagraph. If the parent
+            # decode mode is FULL, give the drafter FULL decode graphs too
+            # (draft is uniform single-token decode, query_len=1), keeping
+            # PIECEWISE for mixed batches. Otherwise PIECEWISE only.
+            if cudagraph_mode.decode_mode() == CUDAGraphMode.FULL:
+                eagle_cudagraph_mode = cudagraph_mode
+            else:
+                eagle_cudagraph_mode = CUDAGraphMode.PIECEWISE
         else:
             eagle_cudagraph_mode = CUDAGraphMode.NONE
 
-        self.cudagraph_dispatcher.initialize_cudagraph_keys(eagle_cudagraph_mode)
+        self.cudagraph_dispatcher.initialize_cudagraph_keys(
+            eagle_cudagraph_mode, uniform_decode_query_len=1
+        )
 
     def _greedy_sample(self, hidden_states: torch.Tensor) -> torch.Tensor:
         """Greedy-sample draft tokens from hidden states."""
@@ -1607,6 +1616,7 @@ class SpecDecodeBaseProposer:
     ) -> tuple[CUDAGraphMode, int, torch.Tensor | None]:
         cudagraph_mode, batch_desc = self.cudagraph_dispatcher.dispatch(
             num_tokens,
+            uniform_decode=True,
             valid_modes=({CUDAGraphMode.NONE} if not use_cudagraphs else None),
         )
         num_tokens_padded = batch_desc.num_tokens
diff --git a/vllm/v1/worker/gpu_model_runner.py b/vllm/v1/worker/gpu_model_runner.py
index d51bf2284..a6de36259 100644
--- a/vllm/v1/worker/gpu_model_runner.py
+++ b/vllm/v1/worker/gpu_model_runner.py
@@ -5854,7 +5854,8 @@ class GPUModelRunner(
                 use_cudagraphs = (
                     (
                         is_graph_capturing
-                        and cudagraph_runtime_mode == CUDAGraphMode.PIECEWISE
+                        and cudagraph_runtime_mode
+                        in (CUDAGraphMode.PIECEWISE, CUDAGraphMode.FULL)
                     )
                     or (
                         not is_graph_capturing
