From 63798360aafd1aba169258c0a46c22049a63c4b3 Mon Sep 17 00:00:00 2001
From: Lyu Xudong <xudong.lyu@amd.com>
Date: Sun, 28 Jun 2026 09:26:53 +0000
Subject: [PATCH 2/2] feat(spec-decode): index_share_for_mtp_iteration -- reuse
 step-0 DSA top-k across MTP draft steps

For DSA MTP (e.g. GLM-5.2 glm_moe_dsa) with num_speculative_tokens > 1, draft
step 0 computes its own indexer top-k and steps 1+ reuse it. The proposer calls
the draft model set_skip_topk(False) before step 0 and set_skip_topk(True)
afterwards, gated by the model config flag index_share_for_mtp_iteration.
Mirrors PR #44420.

The model side must honor set_skip_topk at runtime (read inside the eager
indexer op, scoped to MTP layers), e.g. the ATOM glm_moe_dsa plugin.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 vllm/v1/spec_decode/llm_base_proposer.py | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/vllm/v1/spec_decode/llm_base_proposer.py b/vllm/v1/spec_decode/llm_base_proposer.py
index 8322afb7f..5d74ab1fe 100644
--- a/vllm/v1/spec_decode/llm_base_proposer.py
+++ b/vllm/v1/spec_decode/llm_base_proposer.py
@@ -493,6 +493,23 @@ class SpecDecodeBaseProposer:
             num_tokens, num_input_tokens, mm_embed_inputs
         )
 
+        # index_share_for_mtp_iteration (GLM-5.2 DSA MTP): step 0 computes its
+        # own DSA topk; steps 1+ reuse it. The model side must honor set_skip_topk
+        # at runtime (read inside the eager indexer op, not a baked branch). PR #44420.
+        _share_mtp = getattr(self, "_share_mtp_indices", None)
+        if _share_mtp is None:
+            _mc = self.vllm_config.model_config
+            _flag = getattr(getattr(_mc, "hf_text_config", None),
+                            "index_share_for_mtp_iteration", None)
+            if _flag is None:
+                _flag = getattr(getattr(_mc, "hf_config", None),
+                                "index_share_for_mtp_iteration", False)
+            _share_mtp = bool(_flag) and \
+                hasattr(getattr(self.model, "model", None), "set_skip_topk")
+            self._share_mtp_indices = _share_mtp
+        if _share_mtp:
+            self.model.model.set_skip_topk(False)
+
         with set_forward_context(
             per_layer_attn_metadata,
             self.vllm_config,
@@ -510,6 +527,9 @@ class SpecDecodeBaseProposer:
             else:
                 last_hidden_states, hidden_states = ret_hidden_states
 
+        if _share_mtp:
+            self.model.model.set_skip_topk(True)
+
         sample_hidden_states = last_hidden_states[token_indices_to_sample]
 
         # Early exit if there is only one draft token to be generated.
