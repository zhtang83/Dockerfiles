From 054262ae8ae705d464d158434e69669860715398 Mon Sep 17 00:00:00 2001
From: Lyu Xudong <xudong.lyu@amd.com>
Date: Sun, 28 Jun 2026 09:14:38 +0000
Subject: [PATCH 1/2] fix(glm_moe_dsa): declare dense MLA metadata cudagraph
 support as UNIFORM_BATCH

AiterMlaMetadataBuilderForVllm declared _cudagraph_support as
UNIFORM_SINGLE_TOKEN_DECODE while also setting query_len_support =
QueryLenSupport.UNIFORM. With MTP speculative decoding the verify step has
query_len = 1 + num_speculative_tokens > 1, so vLLM downgrades the whole
decode cudagraph to PIECEWISE because the backend only advertises single-token
support, and the spec-verify step never uses the FULL decode graph.

Declare UNIFORM_BATCH to match the already-set UNIFORM query_len_support (and
upstream FlashMLA / FlashInfer-MLA), so uniform multi-query decode batches can
be captured as FULL cudagraphs.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 atom/plugin/vllm/attention/metadata.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/atom/plugin/vllm/attention/metadata.py b/atom/plugin/vllm/attention/metadata.py
index d411514..b8ee540 100644
--- a/atom/plugin/vllm/attention/metadata.py
+++ b/atom/plugin/vllm/attention/metadata.py
@@ -780,7 +780,7 @@ class AiterMhaMetadataBuilderForVllm(AttentionMetadataBuilder):
 class AiterMlaMetadataBuilderForVllm(MLACommonMetadataBuilder):
     """vLLM-only dense MLA metadata builder."""
 
-    _cudagraph_support = AttentionCGSupport.UNIFORM_SINGLE_TOKEN_DECODE
+    _cudagraph_support = AttentionCGSupport.UNIFORM_BATCH
     reorder_batch_threshold = 1
     query_len_support = QueryLenSupport.UNIFORM
 
