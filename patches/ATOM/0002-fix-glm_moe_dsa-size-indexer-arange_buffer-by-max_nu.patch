From 0180c6366d48852bf37e944c8a399901093e2c7d Mon Sep 17 00:00:00 2001
From: Lyu Xudong <xudong.lyu@amd.com>
Date: Sun, 28 Jun 2026 09:14:38 +0000
Subject: [PATCH 2/2] fix(glm_moe_dsa): size indexer arange_buffer by
 max_num_batched_tokens for num_speculative_tokens > 1

The draft-layer metadata builder intentionally sets num_speculative_tokens = 0
(the draft itself does not speculate), and arange_buffer was sized
max_num_seqs * (1 + num_speculative_tokens). During build_for_drafting with
num_speculative_tokens > 1 the multi-token decode expansion needs
actual_expanded = sum(decode_lens) entries, which exceeds that size and crashes
("The size of tensor a (16) must match the size of tensor b (32)").

Size arange_buffer by max_num_batched_tokens, the true upper bound of
actual_expanded (<= num_decode_tokens), consistent with the other expansion
buffers.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 atom/plugin/vllm/attention/metadata.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/atom/plugin/vllm/attention/metadata.py b/atom/plugin/vllm/attention/metadata.py
index b8ee540..402b78d 100644
--- a/atom/plugin/vllm/attention/metadata.py
+++ b/atom/plugin/vllm/attention/metadata.py
@@ -1661,8 +1661,13 @@ class AiterMlaSparseIndexerMetadataBuilder(AttentionMetadataBuilder):
             dtype=torch.int32,
             device=self.device,
         )
+        # NOTE: sized by max_num_batched_tokens (the true upper bound of
+        # actual_expanded = sum(decode_lens) <= num_decode_tokens), not
+        # max_num_seqs*(1+num_speculative_tokens). The draft-layer builder zeroes
+        # num_speculative_tokens, which made this buffer too small for the
+        # multi-token decode expansion during build_for_drafting (num_spec>1).
         self.arange_buffer = torch.arange(
-            config.scheduler_config.max_num_seqs * (1 + self.num_speculative_tokens),
+            max_num_batched_tokens,
             dtype=torch.int32,
             device=self.device,
         )
